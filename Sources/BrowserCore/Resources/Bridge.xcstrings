    "The engine does not expose the pinned profile service ABI." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "המנוע אינו חושף את ממשק שירותי הפרופיל שננעל לפרויקט." } } } },
    "The engine profile could not be verified." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לאמת את פרופיל מנוע הדפדפן." } } } },
    "Downloads could not be restored for this profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לשחזר את ההורדות בפרופיל הזה." } } } },
    "Invalid download history response." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "התקבלה תשובה לא תקינה מהיסטוריית ההורדות." } } } },
    "Invalid download action." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "פעולת ההורדה אינה תקינה." } } } },
    "This download cannot be resumed." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "אי אפשר להמשיך את ההורדה הזאת." } } } },
    "The download action could not be completed." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן להשלים את פעולת ההורדה." } } } },
    "The engine did not confirm the download action." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "מנוע הדפדפן לא אישר את פעולת ההורדה." } } } },
    "Bookmarks could not be loaded for this profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לטעון את הסימניות בפרופיל הזה." } } } },
