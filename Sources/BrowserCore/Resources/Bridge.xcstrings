        "he" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "הסגירה תבטל הורדה פעילה אחת." } },
          "two" : { "stringUnit" : { "state" : "translated", "value" : "הסגירה תבטל שתי הורדות פעילות." } },
