    },
    "The extension stopped working. Open it again to retry." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "התוסף הפסיק לפעול. פתחו אותו שוב כדי לנסות מחדש." } } } },
    "The extension request has no active profile context and was canceled." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לבקשת התוסף אין הקשר פרופיל פעיל והיא בוטלה." } } } },
    "A live tab cannot silently change its profile or native window." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לשונית פעילה אינה יכולה להחליף פרופיל או חלון באופן שקט." } } } },
    "Chromium could not create the native window." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "Chromium לא הצליח ליצור את החלון." } } } },
    "Chromium could not create the tab." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "Chromium לא הצליח ליצור את הלשונית." } } } },
    "Chromium could not load the requested persistent profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "Chromium לא הצליח לטעון את הפרופיל הקבוע המבוקש." } } } },
    "Invalid or reused native window identity." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "מזהה החלון אינו תקין או שכבר נעשה בו שימוש." } } } },
    "Invalid profile identity or engine not ready." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "מזהה הפרופיל אינו תקין או שמנוע הדפדפן עדיין אינו מוכן." } } } },
    "Private identities cannot enter regular tab ownership." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "זהויות פרטיות אינן יכולות להשתייך ללשוניות רגילות." } } } },
    "The framework does not expose the pinned ArdiaCore API." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "המסגרת אינה חושפת את ממשק ArdiaCore שננעל לפרויקט." } } } },
    "The tab has no loaded profile; refusing a default-profile fallback." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ללשונית אין פרופיל טעון; לא יתבצע מעבר לפרופיל ברירת מחדל." } } } },
    "The tab has no open native window." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "אין חלון פתוח עבור הלשונית." } } } },
    "Unknown download profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "פרופיל ההורדה אינו מוכר." } } } },
    "Moving live tabs between windows is not supported." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "העברת לשוניות פעילות בין חלונות אינה נתמכת." } } } },
    "The requested page could not be adopted into its window." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לצרף את הדף המבוקש לחלון שלו." } } } },
    "This browser window type or profile is unavailable." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "סוג החלון או הפרופיל הזה אינם זמינים." } } } },
    "Extension actions require the selected tab in its owning profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "פעולות תוסף דורשות שהלשונית שנבחרה תהיה בפרופיל השייך לה." } } } },
    "Extension side panels are not available yet." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לוחות הצד של התוספים עדיין אינם זמינים." } } } },
    "The extension has no valid popup for this tab and profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לתוסף אין חלונית תקינה עבור הלשונית והפרופיל האלה." } } } },
    "The extension popup could not be opened in its owning profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לפתוח את חלונית התוסף בפרופיל השייך לו." } } } },
    "This extension action is unavailable in the selected profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "פעולת התוסף הזאת אינה זמינה בפרופיל שנבחר." } } } },
    "Chromium could not create the private tab." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "Chromium לא הצליח ליצור לשונית פרטית." } } } },
    "Chromium could not create the private window." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "Chromium לא הצליח ליצור חלון פרטי." } } } },
    "Invalid private probe context or source profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "הקשר בדיקה פרטי או פרופיל המקור אינם תקינים." } } } },
    "Invalid private tab owner or unsupported navigation." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "בעל הלשונית הפרטית אינו תקין או שהניווט אינו נתמך." } } } },
    "Invalid, unknown, closed, or unsupported private navigation." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "הניווט הפרטי אינו תקין, אינו מוכר, נסגר או אינו נתמך." } } } },
    "Off-the-record profile creation was cancelled." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "יצירת פרופיל ללא רישום בוטלה." } } } },
    "Private context retired during navigation start." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ההקשר הפרטי נסגר בזמן תחילת הניווט." } } } },
    "Private context retired during tab activation." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ההקשר הפרטי נסגר בזמן הפעלת הלשונית." } } } },
    "Private context retired during window preparation." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ההקשר הפרטי נסגר בזמן הכנת החלון." } } } },
    "Private probe context identity is already pending." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "זהות ההקשר לבדיקה פרטית כבר ממתינה לעיבוד." } } } },
    "Private tab owner changed during creation." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "בעל הלשונית הפרטית השתנה בזמן יצירתה." } } } },
    "Private tab owner changed during navigation start." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "בעל הלשונית הפרטית השתנה בתחילת הניווט." } } } },
    "The private source lease is unavailable." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ההרשאה הזמנית למקור הפרטי אינה זמינה." } } } },
    "Cookies can only be cleared for a web page." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "אפשר למחוק עוגיות רק עבור דף אינטרנט." } } } },
    "Cookies could not be read for this page." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לקרוא את העוגיות של הדף הזה." } } } },
