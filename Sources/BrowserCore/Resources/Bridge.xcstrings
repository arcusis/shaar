    "The bookmark action was not confirmed." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "פעולת הסימנייה לא אושרה." } } } },
    "Invalid history limit." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "מגבלת ההיסטוריה אינה תקינה." } } } },
