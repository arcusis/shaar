{
  "sourceLanguage" : "en",
  "strings" : {
    "Downloads are still running" : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "ההורדות עדיין פעילות" } } } },
    "Keep Browser Open" : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "השארת הדפדפן פתוח" } } } },
    "Close and Cancel Downloads" : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "סגירה וביטול ההורדות" } } } },
    "%d active downloads" : {
      "localizations" : {
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "Closing the browser will cancel one active download." } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "Closing the browser will cancel %d active downloads." } }
