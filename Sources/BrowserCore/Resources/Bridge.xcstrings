    "Site settings could not be read for this profile." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "לא ניתן לקרוא את הגדרות האתר בפרופיל הזה." } } } },
    "Site settings need a web address." : { "localizations" : { "he" : { "stringUnit" : { "state" : "translated", "value" : "נדרשת כתובת אתר כדי לקרוא את הגדרות האתר." } } } },
