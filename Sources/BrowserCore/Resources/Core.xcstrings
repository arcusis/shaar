{
  "sourceLanguage": "en",
  "strings": {
    "%d active downloads": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Closing the browser will cancel 1 active download."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Closing the browser will cancel %d active downloads."
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "הסגירה תבטל הורדה פעילה אחת."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "הסגירה תבטל שתי הורדות פעילות."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "הסגירה תבטל %d הורדות פעילות."
                }
              }
            }
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולות"
          }
        }
      }
    },
