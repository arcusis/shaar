      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשוניות"
          }
        }
      }
    },
    "The engine returned invalid bookmark data.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הדפדפן החזיר נתוני סימנייה לא תקינים."
          }
        }
      }
    },
    "The engine returned invalid history data.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הדפדפן החזיר נתוני היסטוריה לא תקינים."
          }
        }
      }
    },
    "The saved session contains invalid spaces, profiles, or tabs.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההפעלה השמורה מכילה מרחבים, פרופילים או לשוניות לא תקינים."
          }
        }
      }
    },
    "The saved workspace version is unsupported.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסת סביבת העבודה השמורה אינה נתמכת."
          }
        }
      }
    },
    "The window no longer belongs to this workspace.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון כבר אינו שייך לסביבת העבודה הזאת."
          }
        }
      }
    },
    "The workspace has conflicting window, Space, profile, or tab ownership.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בסביבת העבודה יש שיוכים סותרים של חלונות, מרחבים, פרופילים או לשוניות."
          }
        }
      }
    },
    "The workspace lock file is invalid.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ הנעילה של סביבת העבודה אינו תקין."
          }
        }
      }
    },
    "This session was saved by an unsupported browser version.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההפעלה הזאת נשמרה בגרסת דפדפן שאינה נתמכת."
          }
        }
      }
    },
    "Untitled bookmark": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימנייה ללא שם"
