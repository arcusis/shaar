    "Live navigation diagnostics. INP requires a measured interaction; buffered entries can be limited. These are not field percentile scores.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live navigation diagnostics. INP requires a measured interaction; buffered entries can be limited. These are not field percentile scores."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני אבחון של הניווט הנוכחי. מדידת INP דורשת אינטראקציה שנמדדה; מספר הרשומות המאוחסנות עשוי להיות מוגבל. אלה אינם אחוזונים מנתוני משתמשים."
          }
        }
      }
    },
