    "CPU is main-thread task time between samples. FPS is unavailable in hidden documents. Cross-origin transfer sizes may be restricted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU is main-thread task time between samples. FPS is unavailable in hidden documents. Cross-origin transfer sizes may be restricted."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU מציג את זמן המשימות בתהליכון הראשי בין דגימות. FPS אינו זמין במסמכים מוסתרים. נתוני נפח ההעברה של משאבים ממקור אחר עשויים להיות מוגבלים."
          }
        }
      }
    },
