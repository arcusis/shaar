    "Creates a ZIP in this profile’s Downloads. Includes the current viewport, up to 300 console messages, recent page requests and active simulations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a ZIP in this profile’s Downloads. Includes the current viewport, up to 300 console messages, recent page requests and active simulations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצר קובץ ZIP בתיקיית ההורדות של הפרופיל. כולל את אזור התצוגה הנוכחי, עד 300 הודעות מסוף, בקשות אחרונות והדמיות פעילות."
          }
        }
      }
    },
