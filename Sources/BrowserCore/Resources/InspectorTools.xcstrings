    "Resource timing plus fetch/XHR observed while page tools are open. Headers and timings can be restricted; — means unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resource timing plus fetch/XHR observed while page tools are open. Headers and timings can be restricted; — means unavailable."
