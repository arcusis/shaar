    "Could not clear this profile's data. Try again.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "לא ניתן לנקות את נתוני הפרופיל הזה. נסו שוב."}}}},
    "Could not load profile privacy settings. Try again.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "לא ניתן לטעון את הגדרות הפרטיות של הפרופיל. נסו שוב."}}}},
    "Could not reset site permissions. Try again.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "לא ניתן לאפס את הרשאות האתר. נסו שוב."}}}},
    "Could not update the third-party cookie setting. Try again.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "לא ניתן לשנות את הגדרת קובצי ה-Cookie של צד שלישי. נסו שוב."}}}},
    "Site permissions reset to defaults.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "הרשאות האתר אופסו לברירות המחדל."}}}},
    "Site permissions for %@ reset to defaults.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "הרשאות האתר עבור %@ אופסו לברירות המחדל."}}}},
    "Cookies and Site Data": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "קובצי Cookie ונתוני אתרים"}}}},
