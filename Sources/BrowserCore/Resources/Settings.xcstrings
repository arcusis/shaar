    "Could not clear history. Try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not clear history. Try again."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן למחוק את ההיסטוריה. כדאי לנסות שוב."}}}},
    "Could not delete the profile. Try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not delete the profile. Try again."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן למחוק את הפרופיל. נסו שוב."}}}},
    "Could not create this profile. Try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not create this profile. Try again."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן ליצור את הפרופיל. כדאי לנסות שוב."}}}},
    "Could not set this app as the default browser.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not set this app as the default browser."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן להגדיר את האפליקציה כדפדפן ברירת המחדל."}}}},
    "Share Page…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share Page…"}},"he":{"stringUnit":{"state":"translated","value":"שיתוף העמוד…"}}}},
    "Open source": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open source"}},"he":{"stringUnit":{"state":"translated","value":"פתיחת קוד המקור"}}}},
    "Open File…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open File…"}},"he":{"stringUnit":{"state":"translated","value":"פתיחת קובץ…"}}}},
    "Copy for agent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy for agent"}},"he":{"stringUnit":{"state":"translated","value":"העתקה לסוכן"}}}},
    "Developer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Developer"}},"he":{"stringUnit":{"state":"translated","value":"פיתוח"}}}},
    "Sleeping tabs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sleeping tabs"}},"he":{"stringUnit":{"state":"translated","value":"לשוניות רדומות"}}}},
    "Sleep inactive tabs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sleep inactive tabs"}},"he":{"stringUnit":{"state":"translated","value":"הרדמת לשוניות לא פעילות"}}}},
    "Inactive tabs are discarded after": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Inactive tabs are discarded after"}},"he":{"stringUnit":{"state":"translated","value":"לשוניות לא פעילות מושלכות אחרי"}}}},
    "5 minutes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"5 minutes"}},"he":{"stringUnit":{"state":"translated","value":"5 דקות"}}}},
    "15 minutes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"15 minutes"}},"he":{"stringUnit":{"state":"translated","value":"15 דקות"}}}},
    "30 minutes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"30 minutes"}},"he":{"stringUnit":{"state":"translated","value":"30 דקות"}}}},
    "1 hour": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1 hour"}},"he":{"stringUnit":{"state":"translated","value":"שעה"}}}},
    "2 hours": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"2 hours"}},"he":{"stringUnit":{"state":"translated","value":"שעתיים"}}}},
    "6 hours": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"6 hours"}},"he":{"stringUnit":{"state":"translated","value":"6 שעות"}}}},
    "Sites that never sleep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sites that never sleep"}},"he":{"stringUnit":{"state":"translated","value":"אתרים שלעולם לא נרדמים"}}}},
    "One site per line. Pinned and visible tabs, tabs playing sound or using camera, microphone, or screen capture, and tabs with unsaved form input stay awake.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"One site per line. Pinned and visible tabs, tabs playing sound or using camera, microphone, or screen capture, and tabs with unsaved form input stay awake."}},"he":{"stringUnit":{"state":"translated","value":"אתר אחד בכל שורה. לשוניות נעוצות וגלויות, לשוניות שמשמיעות צליל או משתמשות במצלמה, במיקרופון או בשיתוף מסך, ולשוניות עם קלט טופס שלא נשמר נשארות ערות."}}}},
    "Shaar DevTools": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shaar DevTools"}},"he":{"stringUnit":{"state":"translated","value":"כלי הפיתוח של שער"}}}},
    "Open Chromium DevTools": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Chromium DevTools"}},"he":{"stringUnit":{"state":"translated","value":"פתיחת כלי הפיתוח של Chromium"}}}},
    "Automatically turn on Dev Mode for local development pages": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatically turn on Dev Mode for local development pages"}},"he":{"stringUnit":{"state":"translated","value":"הפעלה אוטומטית של מצב פיתוח בדפי פיתוח מקומיים"}}}},
    "Welcome to %@": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"ברוכים הבאים אל %@"}}}},
    "Bring your bookmarks": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הביאו את הסימניות שלכם"}}}},
    "Make %@ your default": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגדירו את %@ כדפדפן ברירת המחדל"}}}},
    "Make your first Space yours": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"התאימו את המרחב הראשון שלכם"}}}},
    "Your passwords stay protected": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הסיסמאות שלכם נשארות מוגנות"}}}},
    "Ready to browse": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"אפשר להתחיל לגלוש"}}}},
    "A gateway to your web.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"שער לאינטרנט שלכם."}}}},
    "A calm place for your tabs, bookmarks, and Spaces.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"מקום נעים ללשוניות, לסימניות ולמרחבים שלכם."}}}},
    "Open your Library to import bookmarks and history from another browser. You can do this later, too.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתחו את הספרייה כדי לייבא סימניות והיסטוריה מדפדפן אחר. אפשר לעשות זאת גם אחר כך."}}}},
    "Open Library Import…": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"פתיחת הייבוא בספרייה…"}}}},
    "Choose %@ for links opened from other apps. You can change this in macOS Settings anytime.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"בחרו ב-%@ לפתיחת קישורים מיישומים אחרים. אפשר לשנות זאת בכל עת בהגדרות macOS."}}}},
    "Move %@ to Applications before setting it as your default browser.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"העבירו את %@ לתיקיית היישומים לפני שתגדירו אותו כדפדפן ברירת המחדל."}}}},
    "%@ is your default browser": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"%@ הוא דפדפן ברירת המחדל שלכם"}}}},
    "Could not set the default browser.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן להגדיר את דפדפן ברירת המחדל."}}}},
    "Could not set Shaar as the default browser.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"לא ניתן להגדיר את Shaar כדפדפן ברירת המחדל."}}}},
    "Set as Default Browser": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הגדרה כדפדפן ברירת המחדל"}}}},
    "Spaces keep different parts of your web in reach. Start with a name you recognize.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"מרחבים שומרים על חלקים שונים של הגלישה בהישג יד. התחילו עם שם שתזהו."}}}},
    "%@ uses macOS Keychain to protect saved website passwords. macOS may ask for Keychain access when a saved password is needed. You can manage passwords in Settings later.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"%@ משתמש בצרור המפתחות של macOS כדי להגן על סיסמאות אתרים שמורות. macOS עשוי לבקש גישה לצרור המפתחות כשנדרשת סיסמה שמורה. אפשר לנהל סיסמאות בהגדרות מאוחר יותר."}}}},
    "Your browser is ready. You can revisit import, default browser, and Spaces anytime.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הדפדפן שלכם מוכן. אפשר לחזור לייבוא, לדפדפן ברירת המחדל ולמרחבים בכל עת."}}}},
    "Finish installing %@": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"סיימו להתקין את %@"}}}},
    "Drag %@ to Applications, then open it there. Your setup will resume on the next launch.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"גררו את %@ לתיקיית היישומים ואז פתחו אותו משם. ההגדרה תימשך בהפעלה הבאה."}}}},
    "Show Applications Folder": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"הצגת תיקיית היישומים"}}}},
    "Skip Setup": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"דילוג על ההגדרה"}}}},
    "Start Browsing": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"מתחילים לגלוש"}}}},
    "Private Windows": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"חלונות פרטיים"}}}},
    "Cookies and site storage": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"קובצי Cookie ואחסון אתרים"}}}},
    "Trackers": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"עוקבים"}}}},
    "HTTPS-only browsing": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"גלישה ב-HTTPS בלבד"}}}},
    "Always use secure connections": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"תמיד להשתמש בחיבורים מאובטחים"}}}},
    "Public pages use HTTPS. A site that does not support HTTPS shows a warning instead of loading.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"דפים ציבוריים נטענים ב-HTTPS. אתר שאינו תומך ב-HTTPS מציג אזהרה במקום להיטען."}}}},
    "Public pages use HTTPS. A site that does not support HTTPS shows a warning instead of loading. This profile applies the change the next time it opens.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"דפים ציבוריים נטענים ב-HTTPS. אתר שאינו תומך ב-HTTPS מציג אזהרה במקום להיטען. הפרופיל הזה יחיל את השינוי בפתיחה הבאה."}}}},
    "Referrers": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"פרטי הדף המפנה"}}}},
    "WebRTC local IP exposure": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"חשיפת כתובת IP מקומית ב-WebRTC"}}}},
    "Engine controlled": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"בשליטת המנוע"}}}},
    "The private start page shows which protections are active. Use site controls to allow cookies for a specific site.": {"localizations":{"he":{"stringUnit":{"state":"translated","value":"דף הפתיחה הפרטי מציג אילו הגנות פעילות. השתמשו בבקרות האתר כדי לאפשר קובצי Cookie לאתר מסוים."}}}},
    "The engine returned invalid site permission data.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "מנוע הדפדפן החזיר נתוני הרשאות אתר לא תקינים."}}}},
    "If no Spaces remain, an empty Space is created for a remaining profile.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "אם לא נשארו מרחבים, ייווצר מרחב ריק לפרופיל שנותר."}}}},
    "Favorites and profile preferences will be removed. Chromium will schedule deletion of cookies, site data, history, cache and extensions. This cannot be undone.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "המועדפים והעדפות הפרופיל יוסרו. Chromium יתזמן מחיקה של קובצי Cookie, נתוני אתרים, היסטוריה, מטמון ותוספים. לא ניתן לבטל פעולה זו."}}}},
    "Move Spaces": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "העברת מרחבים"}}}},
    "Remove Spaces and close their tabs": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "הסרת מרחבים וסגירת הלשוניות שלהם"}}}},
    "All Spaces using this profile and their tabs will be removed.": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "כל המרחבים המשתמשים בפרופיל הזה והלשוניות שלהם יוסרו."}}}},
