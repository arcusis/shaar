    "Resetting site permissions…": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "איפוס הרשאות האתר…"}}}},
    "Updating third-party cookie setting…": {"localizations": {"he": {"stringUnit": {"state": "translated", "value": "עדכון הגדרת קובצי Cookie של צד שלישי…"}}}},
