    "A little more private.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A little more private."}},"he":{"stringUnit":{"state":"translated","value":"קצת יותר פרטיות."}}}},
    "Your browsing history stays out of this Mac’s saved history. Private windows for the same profile share temporary site data until the last one closes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your browsing history stays out of this Mac’s saved history. Private windows for the same profile share temporary site data until the last one closes."}},"he":{"stringUnit":{"state":"translated","value":"היסטוריית הגלישה שלך לא נשמרת בהיסטוריה של ה‑Mac הזה. חלונות פרטיים של אותו פרופיל משתפים נתוני אתר זמניים עד לסגירת החלון הפרטי האחרון."}}}},
    "Search with %1$@ or enter address": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search with %1$@ or enter address"}},"he":{"stringUnit":{"state":"translated","value":"חיפוש באמצעות %1$@ או הזנת כתובת"}}}},
    "selected search engine": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"selected search engine"}},"he":{"stringUnit":{"state":"translated","value":"מנוע החיפוש שנבחר"}}}},
    "Private search with %1$@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private search with %1$@"}},"he":{"stringUnit":{"state":"translated","value":"חיפוש פרטי באמצעות %1$@"}}}},
    "Search privately": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search privately"}},"he":{"stringUnit":{"state":"translated","value":"חיפוש פרטי"}}}},
    "Current protections": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current protections"}},"he":{"stringUnit":{"state":"translated","value":"הגנות פעילות"}}}},
    "Cookies and storage blocked for addresses opened here": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cookies and storage blocked for addresses opened here"}},"he":{"stringUnit":{"state":"translated","value":"קובצי Cookie ואחסון חסומים לכתובות שנפתחו כאן"}}}},
    "HTTPS first for addresses opened here": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"HTTPS first for addresses opened here"}},"he":{"stringUnit":{"state":"translated","value":"ניסיון HTTPS תחילה לכתובות שנפתחו כאן"}}}},
    "Permission requests denied; autofill and password saving off": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permission requests denied; autofill and password saving off"}},"he":{"stringUnit":{"state":"translated","value":"בקשות להרשאות נדחות; מילוי אוטומטי ושמירת סיסמאות מושבתים"}}}},
    "Know the limits": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Know the limits"}},"he":{"stringUnit":{"state":"translated","value":"חשוב להכיר את המגבלות"}}}},
    "Private browsing does not hide your IP address or activity from websites, your employer, or your internet provider. Downloads remain on disk.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private browsing does not hide your IP address or activity from websites, your employer, or your internet provider. Downloads remain on disk."}},"he":{"stringUnit":{"state":"translated","value":"הגלישה הפרטית לא מסתירה את כתובת ה‑IP או הפעילות שלך מאתרים, מהמעסיק או מספק האינטרנט שלך. הורדות נשמרות בדיסק."}}}},
    "This engine cannot enforce a global cookie/storage block across redirects, page links, or every frame. Tracker and third-party request blocking, forced HTTPS across page links and redirects, referrer trimming, WebRTC IP limits, and disabling already permitted private extensions are unavailable.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This engine cannot enforce a global cookie/storage block across redirects, page links, or every frame. Tracker and third-party request blocking, forced HTTPS across page links and redirects, referrer trimming, WebRTC IP limits, and disabling already permitted private extensions are unavailable."}},"he":{"stringUnit":{"state":"translated","value":"מנוע זה לא יכול לאכוף חסימה כללית של קובצי Cookie ואחסון בכל ההפניות, הקישורים בדפים או המסגרות. חסימת עוקבים ובקשות של צד שלישי, כפיית HTTPS בקישורים ובהפניות, צמצום פרטי הדף המפנה, הגבלת חשיפת כתובת ה‑IP ב‑WebRTC והשבתת תוספים פרטיים שכבר אושרו אינם זמינים."}}}},
    "This connection would use HTTP": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This connection would use HTTP"}},"he":{"stringUnit":{"state":"translated","value":"החיבור הזה ישתמש ב‑HTTP"}}}},
    "Try HTTPS": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try HTTPS"}},"he":{"stringUnit":{"state":"translated","value":"ניסיון להתחבר באמצעות HTTPS"}}}},
    "Continue with HTTP": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue with HTTP"}},"he":{"stringUnit":{"state":"translated","value":"המשך באמצעות HTTP"}}}},
    "HTTP does not encrypt your connection to %1$@. This warning covers addresses opened here. The engine cannot enforce HTTPS across page links and redirects.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"HTTP does not encrypt your connection to %1$@. This warning covers addresses opened here. The engine cannot enforce HTTPS across page links and redirects."}},"he":{"stringUnit":{"state":"translated","value":"HTTP לא מצפין את החיבור אל %1$@. האזהרה מתייחסת לכתובות שנפתחו כאן. המנוע לא יכול לאכוף HTTPS בקישורים ובהפניות בדפים."}}}},
    "this site": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"this site"}},"he":{"stringUnit":{"state":"translated","value":"האתר הזה"}}}},
