{
  "manifest_version": 3,
  "name": "Private extension execution probe",
  "version": "1.0",
  "description": "Owned loopback fixture; MPL-2.0. No accounts or external traffic.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
