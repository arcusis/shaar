+void ContentPasswordManagerDriver::InstallNativePasswordLogSuppression(
+    base::RepeatingClosure disconnected,
+    base::OnceCallback<void(bool)> callback) {
+  if (!render_frame_host_->IsRenderFrameLive()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (!password_autofill_agent_.is_bound() ||
+      !password_autofill_agent_.is_connected()) {
+    password_autofill_agent_.reset();
+    render_frame_host_->GetRemoteAssociatedInterfaces()->GetInterface(
+        &password_autofill_agent_);
+  }
+  if (!password_autofill_agent_.is_bound()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  password_autofill_agent_.set_disconnect_handler(base::BindOnce(
+      [](base::RepeatingClosure notify) {
+        if (!notify.is_null()) notify.Run();
+      }, std::move(disconnected)));
+  password_autofill_agent_->InstallNativePasswordLogSuppression(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback), false));
+}
+
+bool ContentPasswordManagerDriver::NativePasswordLogEndpointConnected() const {
+  return password_autofill_agent_.is_bound() &&
+         password_autofill_agent_.is_connected();
+}
