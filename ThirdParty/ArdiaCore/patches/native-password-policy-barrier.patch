+NativePasswordStartupMode& ProcessNativePasswordStartupMode() {
+  static base::NoDestructor<NativePasswordStartupMode> mode;
+  return *mode;
+}
+}  // namespace
+
+bool NativePasswordStartupMode::Configure(uint32_t version) {
+  if (version != 1) return false;
+  State expected = State::kUnconfigured;
+  return state_.compare_exchange_strong(expected, State::kNativeRequested);
+}
+
+void NativePasswordStartupMode::Freeze() {
+  State current = state_.load();
+  while (current == State::kUnconfigured || current == State::kNativeRequested) {
+    const State frozen = current == State::kNativeRequested
+                             ? State::kNativeFrozen : State::kLegacyFrozen;
+    if (state_.compare_exchange_weak(current, frozen)) return;
+  }
+}
+
+bool NativePasswordStartupMode::IsNativeOnly() const {
+  return state_.load() == State::kNativeFrozen;
+}
+
+bool ConfigureNativePasswordStartupMode(uint32_t version) {
+  return ProcessNativePasswordStartupMode().Configure(version);
+}
+void FreezeNativePasswordStartupMode() {
+  ProcessNativePasswordStartupMode().Freeze();
+}
+bool NativePasswordStartupModeIsNativeOnly() {
+  return ProcessNativePasswordStartupMode().IsNativeOnly();
+}
