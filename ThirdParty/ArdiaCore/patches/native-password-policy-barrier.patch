+TEST(NativePasswordStartupModeTest, MissingOrLateConfigurationRemainsLegacy) {
+  NativePasswordStartupMode mode;
+  EXPECT_FALSE(mode.IsNativeOnly());
+  mode.Freeze();
+  EXPECT_FALSE(mode.Configure(1));
+  EXPECT_FALSE(mode.IsNativeOnly());
+}
+
+TEST(NativePasswordStartupModeTest, UnsupportedVersionDoesNotSelectMode) {
+  NativePasswordStartupMode mode;
+  EXPECT_FALSE(mode.Configure(0));
+  EXPECT_FALSE(mode.Configure(2));
+  mode.Freeze();
+  EXPECT_FALSE(mode.IsNativeOnly());
+  EXPECT_FALSE(mode.Configure(1));
+}
+
+TEST(NativePasswordStartupModeTest, ValidSelectionIsOneShotAndFrozen) {
+  NativePasswordStartupMode mode;
+  ASSERT_TRUE(mode.Configure(1));
+  EXPECT_FALSE(mode.Configure(1));
+  EXPECT_FALSE(mode.IsNativeOnly());
+  mode.Freeze();
+  EXPECT_TRUE(mode.IsNativeOnly());
+  EXPECT_FALSE(mode.Configure(1));
+  mode.Freeze();
+  EXPECT_TRUE(mode.IsNativeOnly());
+}
+
+TEST(NativePasswordStartupModeTest, ConcurrentSelectionsHaveOneWinner) {
+  NativePasswordStartupMode mode;
+  bool first = false;
+  bool second = false;
+  std::thread a([&]() { first = mode.Configure(1); });
+  std::thread b([&]() { second = mode.Configure(1); });
+  a.join();
+  b.join();
+  EXPECT_NE(first, second);
+  mode.Freeze();
+  EXPECT_TRUE(mode.IsNativeOnly());
+}
