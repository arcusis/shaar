+
+// Run each test in a separate process: startup mode freezes process-wide.
+class NativePasswordBrokerSaveBrowserTest : public NativePasswordBrokerBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    NativePasswordBrokerBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(password_manager::ConfigureNativePasswordStartupMode(1));
+    password_manager::FreezeNativePasswordStartupMode();
+  }
+
+  ChromePasswordManagerClient* Client() {
+    return ChromePasswordManagerClient::FromWebContents(contents_);
+  }
+
+  void LoadAndArm() {
+    Load(https_.GetURL("/title1.html"));
+    ASSERT_TRUE(Client());
+    ASSERT_TRUE(base::test::RunUntil([&] { return Client()->NativeCaptureSessionAllowed(); }));
+    lease_ = std::make_shared<NativePasswordBroker::AccountLease>(7);
+    ASSERT_TRUE(broker_->ArmSaveCapture(host_->GetWeakPtr(), 7, lease_));
+  }
+
+  void Submit() {
+    ASSERT_TRUE(content::ExecJs(contents_, R"JS(
+      const form = document.querySelector('form');
+      form.action = '/title2.html';
+      form.method = 'POST';
+      const user = document.getElementById('u');
+      const pass = document.getElementById('p');
+      user.name = 'username';
+      pass.name = 'password';
+      user.value = 'synthetic-user';
+      pass.value = 'synthetic-password';
+      user.dispatchEvent(new Event('input', {bubbles: true}));
+      pass.dispatchEvent(new Event('input', {bubbles: true}));
+      form.requestSubmit();
+    )JS"));
+    ASSERT_TRUE(content::WaitForLoadStop(contents_));
+  }
+
+  std::optional<NativePasswordBroker::SaveOfferInfo> WaitForOffer() {
+    std::optional<NativePasswordBroker::SaveOfferInfo> offer;
+    if (!base::test::RunUntil([&] {
+          offer = broker_->PendingSaveOffer();
+          return offer.has_value();
+        })) return std::nullopt;
+    return offer;
+  }
+
+ protected:
+  std::shared_ptr<NativePasswordBroker::AccountLease> lease_;
+};
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerSaveBrowserTest,
+                       OriginalOriginAndReentrantLeaseRevocation) {
+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  const auto original = url::Origin::Create(https_.GetURL("/title1.html"));
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  auto offer = WaitForOffer();
+  ASSERT_TRUE(offer);
+  EXPECT_EQ(offer->original_origin, original);
+  int calls = 0;
+  auto owner = host_->GetWeakPtr();
+  broker_->ConfirmSaveOffer(owner, offer->nonce, original,
+      base::BindOnce([&](std::u16string username, password_manager::PasswordString password) {
+        ++calls;
+        EXPECT_EQ(username, u"synthetic-user");
+        EXPECT_EQ(password, u"synthetic-password");
+        lease_->Revoke();
+        DestroyHost();
+      }));
+  EXPECT_EQ(calls, 1);
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+  broker_->ConfirmSaveOffer(owner, offer->nonce, original,
+      base::BindOnce([&](std::u16string, password_manager::PasswordString) { ++calls; }));
+  EXPECT_EQ(calls, 1);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerSaveBrowserTest,
+                       WrongOriginAndRetiredProfileRevokeOffers) {
+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  auto first = WaitForOffer();
+  ASSERT_TRUE(first);
+  int calls = 0;
+  broker_->ConfirmSaveOffer(host_->GetWeakPtr(), first->nonce,
+      url::Origin::Create(GURL("https://other.example/")),
+      base::BindOnce([&](std::u16string, password_manager::PasswordString) { ++calls; }));
+  EXPECT_EQ(calls, 0);
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  auto successor = WaitForOffer();
+  ASSERT_TRUE(successor);
+  browser()->GetProfile()->MaybeSendDestroyedNotification();
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+  broker_->ConfirmSaveOffer(host_->GetWeakPtr(), successor->nonce, successor->original_origin,
+      base::BindOnce([&](std::u16string, password_manager::PasswordString) { ++calls; }));
+  EXPECT_EQ(calls, 0);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerSaveBrowserTest,
+                       OriginalEndpointFailureAndStaleAckCannotReviveLease) {
+  using Api = password_manager::ContentPasswordManagerDriverFactoryTestApi;
+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  auto* frame = contents_->GetPrimaryMainFrame();
+  auto* factory = password_manager::ContentPasswordManagerDriverFactory::FromWebContents(contents_);
+  ASSERT_TRUE(factory);
+  auto request = Api::PendingLogRequest(factory, frame);
+  ASSERT_TRUE(request);
+  Api::DisconnectLogRequest(factory, frame, *request);
+  Api::AckLogRequest(factory, frame, *request);
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+  auto next = std::make_shared<NativePasswordBroker::AccountLease>(8);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Client()->RetryNativePasswordLogSuppression();
+    return Client()->NativeCaptureSessionAllowed();
+  }));
+  EXPECT_TRUE(broker_->ArmSaveCapture(host_->GetWeakPtr(), 8, next));
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+}
