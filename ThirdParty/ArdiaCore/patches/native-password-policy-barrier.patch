+TEST_F(ContentPasswordManagerDriverFactoryTest,
+       NativeLogTimeoutAndRebindRejectOldAcknowledgements) {
+  using Api = ContentPasswordManagerDriverFactoryTestApi;
+  content::RenderFrameHostTester::For(main_rfh())->InitializeRenderFrameIfNeeded();
+  std::vector<base::UnguessableToken> failures;
+  factory()->BeginNativePasswordLogSuppression(
+      base::RepeatingClosure(),
+      base::BindRepeating([&](base::UnguessableToken generation) {
+        failures.push_back(generation);
+      }));
+  auto old = Api::PendingLogRequest(factory(), main_rfh());
+  ASSERT_TRUE(old);
+  const auto previous_generation = factory()->NativePasswordLogGeneration();
+  Api::TimeoutLogRequest(factory(), main_rfh(), *old);
+  ASSERT_EQ(failures.size(), 1u);
+  EXPECT_EQ(failures.front(), previous_generation);
+  Api::AckLogRequest(factory(), main_rfh(), *old);
+  EXPECT_FALSE(Api::IsLogAcknowledged(factory(), main_rfh()));
+  factory()->RetryNativePasswordLogSuppression();
+  auto current = Api::PendingLogRequest(factory(), main_rfh());
+  ASSERT_TRUE(current);
+  EXPECT_NE(*old, *current);
+  EXPECT_NE(previous_generation, factory()->NativePasswordLogGeneration());
+  Api::DisconnectLogRequest(factory(), main_rfh(), *old);
+  Api::AckLogRequest(factory(), main_rfh(), *old);
+  EXPECT_EQ(failures.size(), 1u);
+  EXPECT_FALSE(Api::IsLogAcknowledged(factory(), main_rfh()));
+}
