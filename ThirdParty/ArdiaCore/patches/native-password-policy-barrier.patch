diff --git a/ardia/core/ac_native_password_submission_state.h b/ardia/core/ac_native_password_submission_state.h
new file mode 100644
index 0000000..73e8c1a
--- /dev/null
+++ b/ardia/core/ac_native_password_submission_state.h
@@ -0,0 +1,142 @@
+#ifndef ARDIA_CORE_AC_NATIVE_PASSWORD_SUBMISSION_STATE_H_
+#define ARDIA_CORE_AC_NATIVE_PASSWORD_SUBMISSION_STATE_H_
+
+#include <cstdint>
+#include <optional>
+#include <utility>
+
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "url/origin.h"
+
+namespace ardiacore {
+
+// This object stores authority metadata only; the broker owns transient secrets.
+class NativePasswordSubmissionState {
+ public:
+  struct Context {
+    base::UnguessableToken session;
+    uint64_t selection_generation;
+    uint64_t account_generation;
+    bool operator==(const Context&) const = default;
+  };
+
+  struct Snapshot {
+    Context context;
+    base::UnguessableToken manager_nonce;
+    base::UnguessableToken document_binding;
+    url::Origin original_origin;
+    base::TimeTicks expires;
+  };
+
+  explicit NativePasswordSubmissionState(Context context)
+      : context_(std::move(context)) {}
+
+  bool Prepare(Snapshot snapshot, base::TimeTicks now) {
+    if ((stage_ != Stage::kEmpty && stage_ != Stage::kPrepared) ||
+        snapshot.context != context_ || context_.session.is_empty() ||
+        snapshot.manager_nonce.is_empty() || snapshot.document_binding.is_empty() ||
+        snapshot.original_origin.opaque() || snapshot.original_origin.scheme() != "https" ||
+        snapshot.expires <= now ||
+        (stage_ == Stage::kPrepared &&
+         (!snapshot_ || now >= snapshot_->expires ||
+          snapshot.document_binding != snapshot_->document_binding ||
+          snapshot.original_origin != snapshot_->original_origin ||
+          snapshot.expires != snapshot_->expires))) {
+      Invalidate();
+      return false;
+    }
+    snapshot_ = std::move(snapshot);
+    stage_ = Stage::kPrepared;
+    return true;
+  }
+
+  bool Navigate(bool may_be_submitted, const Context& context,
+                const base::UnguessableToken& nonce, base::TimeTicks now) {
+    if (stage_ != Stage::kPrepared || !may_be_submitted ||
+        !Matches(context, nonce, now)) {
+      Invalidate();
+      return false;
+    }
+    stage_ = Stage::kNavigating;
+    return true;
+  }
+
+  bool Infer(const Context& context, const base::UnguessableToken& nonce,
+             base::TimeTicks now, bool current_document_authorized) {
+    if (!Matches(context, nonce, now) ||
+        (stage_ != Stage::kNavigating &&
+         !(stage_ == Stage::kPrepared && current_document_authorized))) {
+      Invalidate();
+      return false;
+    }
+    after_navigation_ = stage_ == Stage::kNavigating;
+    stage_ = Stage::kOffered;
+    return true;
+  }
+
+  bool OfferValid(const Context& context, base::TimeTicks now,
+                  bool current_document_authorized) {
+    if (stage_ != Stage::kOffered || !snapshot_ ||
+        !Matches(context, snapshot_->manager_nonce, now) ||
+        (!after_navigation_ && !current_document_authorized)) {
+      Invalidate();
+      return false;
+    }
+    return true;
+  }
+
+  bool Consume(const Context& context, const base::UnguessableToken& nonce,
+               const url::Origin& displayed_origin, base::TimeTicks now,
+               bool current_document_authorized) {
+    if (!OfferValid(context, now, current_document_authorized) ||
+        !Matches(context, nonce, now) ||
+        snapshot_->original_origin != displayed_origin) {
+      Invalidate();
+      return false;
+    }
+    snapshot_.reset();
+    stage_ = Stage::kConsumed;
+    return true;
+  }
+
+  bool PreserveWhileBarrierUnavailable(const Context& context,
+                                       base::TimeTicks now) {
+    if (!snapshot_ || !Matches(context, snapshot_->manager_nonce, now) ||
+        (stage_ != Stage::kPrepared && stage_ != Stage::kNavigating &&
+         !(stage_ == Stage::kOffered && after_navigation_))) {
+      Invalidate();
+      return false;
+    }
+    return true;
+  }
+
+  const Snapshot* snapshot() const {
+    return snapshot_ ? &*snapshot_ : nullptr;
+  }
+
+  bool after_navigation() const { return after_navigation_; }
+
+  void Invalidate() {
+    snapshot_.reset();
+    stage_ = Stage::kInvalid;
+  }
+
+ private:
+  enum class Stage { kEmpty, kPrepared, kNavigating, kOffered, kConsumed, kInvalid };
+
+  bool Matches(const Context& context, const base::UnguessableToken& nonce,
+               base::TimeTicks now) const {
+    return snapshot_ && context == context_ && snapshot_->context == context_ &&
+           snapshot_->manager_nonce == nonce && now < snapshot_->expires;
+  }
+
+  const Context context_;
+  std::optional<Snapshot> snapshot_;
+  Stage stage_ = Stage::kEmpty;
+  bool after_navigation_ = false;
+};
+
+}  // namespace ardiacore
+
+#endif  // ARDIA_CORE_AC_NATIVE_PASSWORD_SUBMISSION_STATE_H_
diff --git a/ardia/core/ac_native_password_submission_state_unittest.cc b/ardia/core/ac_native_password_submission_state_unittest.cc
new file mode 100644
index 0000000..512bad7
--- /dev/null
+++ b/ardia/core/ac_native_password_submission_state_unittest.cc
@@ -0,0 +1,157 @@
+#include "ardia/core/ac_native_password_submission_state.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace ardiacore {
+namespace {
+
+class NativePasswordSubmissionStateTest : public testing::Test {
+ protected:
+  using State = NativePasswordSubmissionState;
+  const State::Context context{base::UnguessableToken::Create(), 11, 23};
+  const base::UnguessableToken nonce = base::UnguessableToken::Create();
+  const base::UnguessableToken document = base::UnguessableToken::Create();
+  const url::Origin origin = url::Origin::Create(GURL("https://login.example/"));
+  const base::TimeTicks start = base::TimeTicks() + base::Seconds(100);
+  const base::TimeTicks expiry = start + base::Seconds(30);
+
+  State::Snapshot Snapshot() const {
+    return {context, nonce, document, origin, expiry};
+  }
+};
+
+TEST_F(NativePasswordSubmissionStateTest, SpeculativeFrameThenRedirectRetainsOriginalBindingOnce) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  ASSERT_TRUE(state.PreserveWhileBarrierUnavailable(context, start));
+  ASSERT_TRUE(state.Navigate(true, context, nonce, start));
+  ASSERT_TRUE(state.PreserveWhileBarrierUnavailable(context, start + base::Seconds(1)));
+  ASSERT_NE(state.snapshot(), nullptr);
+  EXPECT_EQ(state.snapshot()->document_binding, document);
+  EXPECT_EQ(state.snapshot()->original_origin, origin);
+  EXPECT_EQ(state.snapshot()->expires, expiry);
+  ASSERT_TRUE(state.Infer(context, nonce, start + base::Seconds(1), false));
+  ASSERT_TRUE(state.OfferValid(context, start + base::Seconds(2), false));
+  EXPECT_TRUE(state.Consume(context, nonce, origin, start + base::Seconds(3), false));
+  EXPECT_FALSE(state.Consume(context, nonce, origin, start + base::Seconds(3), true));
+  EXPECT_FALSE(state.Prepare(Snapshot(), start + base::Seconds(4)));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, SpeculativeFrameBeforeNavigationDoesNotAuthorizeCapture) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  EXPECT_TRUE(state.PreserveWhileBarrierUnavailable(context, start + base::Seconds(1)));
+  EXPECT_FALSE(state.OfferValid(context, start + base::Seconds(1), false));
+  EXPECT_FALSE(state.Navigate(true, context, nonce, start + base::Seconds(2)));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, NavigationAloneDoesNotAuthorizeOffer) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  ASSERT_TRUE(state.Navigate(true, context, nonce, start));
+  EXPECT_FALSE(state.OfferValid(context, start, false));
+  EXPECT_FALSE(state.Infer(context, nonce, start, false));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, ExplicitInvalidationIsPermanent) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  state.Invalidate();
+  EXPECT_FALSE(state.Infer(context, nonce, start, true));
+  EXPECT_FALSE(state.Prepare(Snapshot(), start));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, InvalidatedSessionCannotResumeViaNavigation) {
+  State old_state(context);
+  ASSERT_TRUE(old_state.Prepare(Snapshot(), start));
+  old_state.Invalidate();
+  EXPECT_FALSE(old_state.Navigate(true, context, nonce, start));
+  EXPECT_FALSE(old_state.Infer(context, nonce, start, true));
+  State successor(context);
+  ASSERT_TRUE(successor.Prepare(Snapshot(), start));
+  EXPECT_TRUE(successor.Infer(context, nonce, start, true));
+  EXPECT_FALSE(old_state.Consume(context, nonce, origin, start, true));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, InvalidNavigationOrInferenceCannotResurrect) {
+  State nonsubmit(context);
+  ASSERT_TRUE(nonsubmit.Prepare(Snapshot(), start));
+  EXPECT_FALSE(nonsubmit.Navigate(false, context, nonce, start));
+  EXPECT_FALSE(nonsubmit.Infer(context, nonce, start, true));
+  EXPECT_FALSE(nonsubmit.Prepare(Snapshot(), start));
+
+  State wrong_nonce(context);
+  ASSERT_TRUE(wrong_nonce.Prepare(Snapshot(), start));
+  EXPECT_FALSE(wrong_nonce.Navigate(true, context, base::UnguessableToken::Create(), start));
+  EXPECT_FALSE(wrong_nonce.Infer(context, nonce, start, true));
+
+  State no_ack(context);
+  ASSERT_TRUE(no_ack.Prepare(Snapshot(), start));
+  EXPECT_FALSE(no_ack.Infer(context, nonce, start, false));
+  EXPECT_FALSE(no_ack.Infer(context, nonce, start, true));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, OwnerAccountSessionLossAndExpiryRevoke) {
+  for (const State::Context changed : {
+           State::Context{context.session, 12, 23},
+           State::Context{context.session, 11, 24},
+           State::Context{base::UnguessableToken::Create(), 11, 23}}) {
+    State state(context);
+    ASSERT_TRUE(state.Prepare(Snapshot(), start));
+    EXPECT_FALSE(state.Navigate(true, changed, nonce, start));
+    EXPECT_FALSE(state.Infer(context, nonce, start, true));
+  }
+  State expired(context);
+  ASSERT_TRUE(expired.Prepare(Snapshot(), start));
+  EXPECT_FALSE(expired.Navigate(true, context, nonce, expiry));
+  EXPECT_FALSE(expired.Infer(context, nonce, expiry, true));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, WrongDisplayedOriginAndSecondNavigationRevoke) {
+  State wrong_origin(context);
+  ASSERT_TRUE(wrong_origin.Prepare(Snapshot(), start));
+  ASSERT_TRUE(wrong_origin.Infer(context, nonce, start, true));
+  EXPECT_FALSE(wrong_origin.Consume(context, nonce,
+      url::Origin::Create(GURL("https://other.example/")), start, true));
+  EXPECT_FALSE(wrong_origin.Consume(context, nonce, origin, start, true));
+
+  State second_navigation(context);
+  ASSERT_TRUE(second_navigation.Prepare(Snapshot(), start));
+  ASSERT_TRUE(second_navigation.Navigate(true, context, nonce, start));
+  EXPECT_FALSE(second_navigation.Navigate(true, context, nonce, start));
+  EXPECT_FALSE(second_navigation.Infer(context, nonce, start, false));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, RepeatedPrepareCannotExtendOrResurrect) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  auto repeated = Snapshot();
+  repeated.manager_nonce = base::UnguessableToken::Create();
+  ASSERT_TRUE(state.Prepare(repeated, start + base::Seconds(1)));
+  EXPECT_EQ(state.snapshot()->expires, expiry);
+  EXPECT_EQ(state.snapshot()->document_binding, document);
+  auto extended = repeated;
+  extended.expires += base::Seconds(1);
+  EXPECT_FALSE(state.Prepare(std::move(extended), start + base::Seconds(2)));
+  EXPECT_FALSE(state.Infer(context, repeated.manager_nonce, start + base::Seconds(2), true));
+
+  State expired(context);
+  ASSERT_TRUE(expired.Prepare(Snapshot(), start));
+  auto late = Snapshot();
+  late.expires += base::Minutes(1);
+  EXPECT_FALSE(expired.Prepare(std::move(late), expiry));
+}
+
+TEST_F(NativePasswordSubmissionStateTest, NavigationCannotExtendExpiryOrReplaceSnapshot) {
+  State state(context);
+  ASSERT_TRUE(state.Prepare(Snapshot(), start));
+  ASSERT_TRUE(state.Navigate(true, context, nonce, start));
+  auto replacement = Snapshot();
+  replacement.expires += base::Minutes(1);
+  EXPECT_FALSE(state.Prepare(std::move(replacement), start));
+  EXPECT_FALSE(state.Infer(context, nonce, start, false));
+}
+
+}  // namespace
+}  // namespace ardiacore
