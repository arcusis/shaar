+bool ContentPasswordManagerDriverFactory::NativePasswordLogSuppressionReady()
+    const {
+  if (!native_log_suppression_started_ || !web_contents()) return false;
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive()) return false;
+  auto entry = log_frames_.find(frame->GetGlobalId());
+  auto driver = frame_driver_map_.find(frame);
+  return entry != log_frames_.end() && entry->second.acknowledged &&
+         entry->second.document.AsRenderFrameHostIfValid() == frame &&
+         driver != frame_driver_map_.end() &&
+         driver->second.NativePasswordLogEndpointConnected();
+}
+
+void ContentPasswordManagerDriverFactory::RetryNativePasswordLogSuppression() {
+  if (!native_log_suppression_started_ || !web_contents()) return;
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) return;
+  auto entry = log_frames_.find(frame->GetGlobalId());
+  auto driver = frame_driver_map_.find(frame);
+  if (entry == log_frames_.end() ||
+      entry->second.document.AsRenderFrameHostIfValid() != frame ||
+      driver == frame_driver_map_.end() ||
+      !driver->second.NativePasswordLogEndpointConnected() ||
+      (!entry->second.pending && !entry->second.acknowledged)) {
+    RequestNativePasswordLogSuppression(frame);
+  }
+}
