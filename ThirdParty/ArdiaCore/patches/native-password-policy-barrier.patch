+  const auto id = frame->GetGlobalId();
+  const auto request = base::UnguessableToken::Create();
+  LogSuppressionFrame entry;
+  entry.document = frame->GetWeakDocumentPtr();
+  entry.request = request;
+  if (web_contents() && frame == web_contents()->GetPrimaryMainFrame())
+    entry.primary_generation = native_log_generation_;
+  log_frames_.insert_or_assign(id, std::move(entry));
+  ScheduleNativePasswordBarrierChange();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ContentPasswordManagerDriverFactory::OnNativePasswordLogTimeout,
+          weak_factory_.GetWeakPtr(), id, request),
+      base::Seconds(5));
+  auto* driver = GetDriverForFrame(frame);
+  if (!driver) return;
+  driver->InstallNativePasswordLogSuppression(
+      base::BindRepeating(
+          &ContentPasswordManagerDriverFactory::OnNativePasswordLogDisconnected,
+          weak_factory_.GetWeakPtr(), id, request),
+      base::BindOnce(
+          &ContentPasswordManagerDriverFactory::OnNativePasswordLogSuppressionResult,
+          weak_factory_.GetWeakPtr(), id, request));
+}
+
+void ContentPasswordManagerDriverFactory::OnNativePasswordLogSuppressionResult(
+    content::GlobalRenderFrameHostId id, base::UnguessableToken request,
+    bool installed) {
+  auto entry = log_frames_.find(id);
+  if (entry == log_frames_.end() || entry->second.request != request ||
+      !entry->second.pending) return;
+  entry->second.pending = false;
+  entry->second.acknowledged =
+      installed && entry->second.document.AsRenderFrameHostIfValid();
+  const auto failed_generation = entry->second.acknowledged
+                                     ? base::UnguessableToken()
+                                     : entry->second.primary_generation;
+  auto failure = native_primary_failure_;
+  ScheduleNativePasswordBarrierChange();
+  if (!failed_generation.is_empty() && !failure.is_null())
+    failure.Run(failed_generation);
+}
+
+void ContentPasswordManagerDriverFactory::OnNativePasswordLogDisconnected(
+    content::GlobalRenderFrameHostId id, base::UnguessableToken request) {
+  auto entry = log_frames_.find(id);
+  if (entry == log_frames_.end() || entry->second.request != request) return;
+  const auto failed_generation = entry->second.primary_generation;
+  auto failure = native_primary_failure_;
+  entry->second.pending = false;
+  entry->second.acknowledged = false;
+  if (web_contents() && web_contents()->GetPrimaryMainFrame() &&
+      web_contents()->GetPrimaryMainFrame()->GetGlobalId() == id)
+    native_log_generation_ = base::UnguessableToken::Create();
+  ScheduleNativePasswordBarrierChange();
+  if (!failed_generation.is_empty() && !failure.is_null())
+    failure.Run(failed_generation);
+}
+
+void ContentPasswordManagerDriverFactory::OnNativePasswordLogTimeout(
+    content::GlobalRenderFrameHostId id, base::UnguessableToken request) {
+  auto entry = log_frames_.find(id);
+  if (entry == log_frames_.end() || entry->second.request != request ||
+      !entry->second.pending) return;
+  const auto failed_generation = entry->second.primary_generation;
+  auto failure = native_primary_failure_;
+  entry->second.pending = false;
+  entry->second.acknowledged = false;
+  entry->second.request = base::UnguessableToken::Create();
+  if (web_contents() && web_contents()->GetPrimaryMainFrame() &&
+      web_contents()->GetPrimaryMainFrame()->GetGlobalId() == id)
+    native_log_generation_ = base::UnguessableToken::Create();
+  ScheduleNativePasswordBarrierChange();
+  if (!failed_generation.is_empty() && !failure.is_null())
+    failure.Run(failed_generation);
+}
+
+void ContentPasswordManagerDriverFactory::ScheduleNativePasswordBarrierChange() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ContentPasswordManagerDriverFactory::NotifyNativePasswordBarrierChange,
+          weak_factory_.GetWeakPtr()));
+}
+
+void ContentPasswordManagerDriverFactory::NotifyNativePasswordBarrierChange() {
+  auto changed = native_barrier_changed_;
+  if (!changed.is_null()) changed.Run();
+}
