+void ContentPasswordManagerDriverFactory::BeginNativePasswordLogSuppression(
+    base::RepeatingClosure changed,
+    base::RepeatingCallback<void(base::UnguessableToken)> primary_failure) {
+  if (native_log_suppression_started_ || !web_contents()) return;
+  native_log_suppression_started_ = true;
+  native_log_generation_ = base::UnguessableToken::Create();
+  native_barrier_changed_ = std::move(changed);
+  native_primary_failure_ = std::move(primary_failure);
+  web_contents()->ForEachRenderFrameHost([this](content::RenderFrameHost* frame) {
+    if (frame->IsRenderFrameLive())
+      RequestNativePasswordLogSuppression(frame);
+  });
