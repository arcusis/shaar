+TEST_F(PasswordAutofillAgentTest, NativeSnapshotUsesFocusedLiveForm) {
+  FocusElement(kUsernameName);
+  base::test::TestFuture<mojom::NativeFocusedFormSnapshotPtr> result;
+  password_autofill_agent_->GetNativeFocusedFormSnapshot(result.GetCallback());
+  auto snapshot = result.Take();
+  ASSERT_TRUE(snapshot);
+  EXPECT_EQ(snapshot->document_token, GetMainFrame()->GetDocument().Token());
+  EXPECT_EQ(snapshot->form_id,
+            form_util::GetFormRendererId(
+                username_element_.GetOwningFormForAutofill()));
+  EXPECT_EQ(snapshot->focused_field_id,
+            form_util::GetFieldRendererId(username_element_));
