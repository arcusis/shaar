diff --git a/ardia/core/ac_native_password_broker.h b/ardia/core/ac_native_password_broker.h
new file mode 100644
index 0000000..cf4613f
--- /dev/null
+++ b/ardia/core/ac_native_password_broker.h
@@ -0,0 +1,70 @@
+#ifndef ARDIA_CORE_AC_NATIVE_PASSWORD_BROKER_H_
+#define ARDIA_CORE_AC_NATIVE_PASSWORD_BROKER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "components/autofill/content/common/mojom/autofill_agent.mojom.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/origin.h"
+
+namespace content {
+class WebContents;
+class RenderFrameHost;
+}  // namespace content
+namespace ardiacore {
+class WindowHost;
+
+// Owned by the native host for one WebContents. Handles contain no credentials.
+class NativePasswordBroker : public content::WebContentsObserver {
+ public:
+  using Handle = base::UnguessableToken;
+  using RequestCallback = base::OnceCallback<void(std::optional<Handle>)>;
+  explicit NativePasswordBroker(content::WebContents* contents);
+  ~NativePasswordBroker() override;
+  void Request(base::WeakPtr<WindowHost> owner, RequestCallback callback);
+  void Consume(base::WeakPtr<WindowHost> owner,
+               const Handle& handle,
+               const std::u16string& username,
+               const std::u16string& password,
+               base::OnceCallback<void(bool)> callback);
+  void Cancel(const Handle& handle);
+  void CancelAll();
+
+ private:
+  struct Entry {
+    base::WeakPtr<WindowHost> owner;
+    content::WeakDocumentPtr document;
+    url::Origin origin;
+    autofill::FieldRendererId focused_field;
+    uint64_t focus_generation;
+    uint64_t selection_generation;
+    base::TimeTicks expires;
+    autofill::mojom::NativeFocusedFormSnapshotPtr snapshot;
+  };
+  bool Valid(const Entry& entry, base::WeakPtr<WindowHost> owner) const;
+  void OnSnapshot(Entry entry,
+                  Handle request_id,
+                  autofill::mojom::NativeFocusedFormSnapshotPtr snapshot);
+  void Invalidate();
+  void WebContentsDestroyed() override;
+  void RenderFrameDeleted(content::RenderFrameHost*) override;
+  void RenderFrameHostChanged(content::RenderFrameHost*,
+                              content::RenderFrameHost*) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override;
+  void PrimaryPageChanged(content::Page&) override;
+
+  std::map<Handle, Entry> entries_;
+  std::map<Handle, RequestCallback> pending_requests_;
+  bool invalidating_ = false;
+  bool destroying_ = false;
+  base::WeakPtrFactory<NativePasswordBroker> weak_factory_{this};
+};
+}  // namespace ardiacore
+#endif
diff --git a/ardia/core/ac_native_password_broker.mm b/ardia/core/ac_native_password_broker.mm
new file mode 100644
index 0000000..3d387b9
--- /dev/null
+++ b/ardia/core/ac_native_password_broker.mm
@@ -0,0 +1,181 @@
+#include "ardia/core/ac_native_password_broker.h"
+
+#include <utility>
+
+#include "ardia/core/ac_browser.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/password_manager/content/browser/content_password_manager_driver.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/cert/cert_status_flags.h"
+#include "url/url_constants.h"
+
+namespace ardiacore {
+namespace {
+constexpr size_t kMaxEntries = 16;
+constexpr auto kLifetime = base::Seconds(30);
+using Driver = password_manager::ContentPasswordManagerDriver;
+}  // namespace
+NativePasswordBroker::NativePasswordBroker(content::WebContents* contents)
+    : content::WebContentsObserver(contents) {}
+NativePasswordBroker::~NativePasswordBroker() {
+  destroying_ = true;
+  Invalidate();
+}
+
+bool NativePasswordBroker::Valid(const Entry& entry,
+                                 base::WeakPtr<WindowHost> owner) const {
+  auto* contents = web_contents();
+  if (!contents || !owner || owner.get() != entry.owner.get() ||
+      owner->closing() ||
+      owner->active_profile() !=
+          Profile::FromBrowserContext(contents->GetBrowserContext()) ||
+      owner->selection_generation() != entry.selection_generation) {
+    return false;
+  }
+  auto* browser = owner->ExistingBrowserFor(owner->active_profile());
+  auto* frame = contents->GetPrimaryMainFrame();
+  auto* navigation = contents->GetController().GetLastCommittedEntry();
+  if (!navigation || !navigation->GetSSL().certificate ||
+      net::IsCertStatusError(navigation->GetSSL().cert_status)) {
+    return false;
+  }
+  if (!browser ||
+      browser->GetTabStripModel()->GetActiveWebContents() != contents ||
+      !frame || !frame->IsRenderFrameLive() || !frame->IsActive() ||
+      frame->IsErrorDocument() || contents->GetFocusedFrame() != frame ||
+      entry.document.AsRenderFrameHostIfValid() != frame ||
+      frame->GetLastCommittedOrigin() != entry.origin ||
+      entry.origin.opaque() || entry.origin.scheme() != url::kHttpsScheme ||
+      !frame->GetLastCommittedURL().SchemeIs(url::kHttpsScheme) ||
+      base::TimeTicks::Now() >= entry.expires) {
+    return false;
+  }
+  auto* driver = Driver::GetForRenderFrameHost(frame);
+  return driver && driver->render_frame_host() == frame &&
+         driver->native_focused_field() == entry.focused_field &&
+         driver->native_focus_generation() == entry.focus_generation;
+}
+
+void NativePasswordBroker::Request(base::WeakPtr<WindowHost> owner,
+                                   RequestCallback callback) {
+  for (auto it = entries_.begin(); it != entries_.end();) {
+    if (base::TimeTicks::Now() >= it->second.expires) {
+      it = entries_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  auto* contents = web_contents();
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  auto* driver = frame && frame->IsRenderFrameLive()
+                     ? Driver::GetForRenderFrameHost(frame)
+                     : nullptr;
+  if (!driver || !owner || invalidating_ || destroying_ ||
+      entries_.size() + pending_requests_.size() >= kMaxEntries) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  Entry entry{owner,
+              frame->GetWeakDocumentPtr(),
+              frame->GetLastCommittedOrigin(),
+              driver->native_focused_field(),
+              driver->native_focus_generation(),
+              owner->selection_generation(),
+              base::TimeTicks::Now() + kLifetime,
+              nullptr};
+  if (!Valid(entry, owner)) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  Handle request_id = Handle::Create();
+  pending_requests_.emplace(request_id, std::move(callback));
+  driver->GetNativeFocusedFormSnapshot(
+      base::BindOnce(&NativePasswordBroker::OnSnapshot,
+                     weak_factory_.GetWeakPtr(), std::move(entry), request_id));
+}
+void NativePasswordBroker::OnSnapshot(
+    Entry entry,
+    Handle request_id,
+    autofill::mojom::NativeFocusedFormSnapshotPtr snapshot) {
+  auto pending = pending_requests_.extract(request_id);
+  if (pending.empty()) {
+    return;
+  }
+  RequestCallback callback = std::move(pending.mapped());
+  if (!snapshot || snapshot->focused_field_id != entry.focused_field ||
+      !Valid(entry, entry.owner) || entries_.size() >= kMaxEntries) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  entry.snapshot = std::move(snapshot);
+  Handle handle = Handle::Create();
+  entries_.emplace(handle, std::move(entry));
+  std::move(callback).Run(handle);
+}
+void NativePasswordBroker::Consume(base::WeakPtr<WindowHost> owner,
+                                   const Handle& handle,
+                                   const std::u16string& username,
+                                   const std::u16string& password,
+                                   base::OnceCallback<void(bool)> callback) {
+  auto node = entries_.extract(handle);
+  if (node.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  Entry entry = std::move(node.mapped());
+  if (!Valid(entry, owner)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto* driver =
+      Driver::GetForRenderFrameHost(web_contents()->GetPrimaryMainFrame());
+  driver->FillNativePasswordSuggestion(*entry.snapshot, username, password,
+                                       std::move(callback));
+}
+void NativePasswordBroker::Cancel(const Handle& handle) {
+  entries_.erase(handle);
+}
+void NativePasswordBroker::CancelAll() {
+  Invalidate();
+}
+void NativePasswordBroker::Invalidate() {
+  if (invalidating_) {
+    return;
+  }
+  invalidating_ = true;
+  entries_.clear();
+  auto pending = std::move(pending_requests_);
+  pending_requests_.clear();
+  weak_factory_.InvalidateWeakPtrs();
+  auto alive = weak_factory_.GetWeakPtr();
+  for (auto& [id, callback] : pending) {
+    std::move(callback).Run(std::nullopt);
+  }
+  if (alive) {
+    alive->invalidating_ = false;
+  }
+}
+void NativePasswordBroker::WebContentsDestroyed() {
+  Invalidate();
+}
+void NativePasswordBroker::RenderFrameDeleted(content::RenderFrameHost*) {
+  Invalidate();
+}
+void NativePasswordBroker::RenderFrameHostChanged(content::RenderFrameHost*,
+                                                  content::RenderFrameHost*) {
+  Invalidate();
+}
+void NativePasswordBroker::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus) {
+  Invalidate();
+}
+void NativePasswordBroker::PrimaryPageChanged(content::Page&) {
+  Invalidate();
+}
+}  // namespace ardiacore
diff --git a/ardia/core/ac_native_password_broker_browsertest.mm b/ardia/core/ac_native_password_broker_browsertest.mm
new file mode 100644
index 0000000..6f9e308
--- /dev/null
+++ b/ardia/core/ac_native_password_broker_browsertest.mm
@@ -0,0 +1,194 @@
+#include "ardia/core/ac_native_password_broker.h"
+
+#include "ardia/core/ac_browser.h"
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/password_manager/content/browser/content_password_manager_driver.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace ardiacore {
+class NativePasswordBrokerBrowserTest : public InProcessBrowserTest {
+ public:
+  NativePasswordBrokerBrowserTest()
+      : https_(net::EmbeddedTestServer::TYPE_HTTPS) {}
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(https_.Start());
+    ASSERT_TRUE(embedded_test_server()->Start());
+    host_ = std::make_unique<WindowHost>(nullptr, gfx::Rect(0, 0, 800, 600));
+    // Fixture only observes the existing browser; it does not adopt its views.
+    host_->browsers_[browser()->GetProfile()] = browser();
+    host_->active_profile_ = browser()->GetProfile();
+    browser()->GetTabStripModel()->AddObserver(host_.get());
+    contents_ = browser()->GetTabStripModel()->GetActiveWebContents();
+    broker_ = std::make_unique<NativePasswordBroker>(contents_);
+  }
+  void TearDownOnMainThread() override {
+    broker_.reset();
+    if (host_) {
+      browser()->GetTabStripModel()->RemoveObserver(host_.get());
+      host_->browsers_.clear();
+    }
+    host_.reset();
+  }
+  void Load(const GURL& url) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+    ASSERT_TRUE(content::ExecJs(contents_,
+                                "document.body.innerHTML='<form><input "
+                                "id=u><input id=p type=password></form>';"
+                                "document.getElementById('u').focus();"));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      auto* frame = contents_->GetPrimaryMainFrame();
+      auto* driver =
+          password_manager::ContentPasswordManagerDriver::GetForRenderFrameHost(
+              frame);
+      return driver &&
+             driver->native_focused_field() != autofill::FieldRendererId() &&
+             contents_->GetFocusedFrame() == frame;
+    }));
+  }
+  std::optional<NativePasswordBroker::Handle> Request() {
+    base::test::TestFuture<std::optional<NativePasswordBroker::Handle>> result;
+    broker_->Request(host_->GetWeakPtr(), result.GetCallback());
+    return result.Take();
+  }
+  bool Fill(const NativePasswordBroker::Handle& handle) {
+    base::test::TestFuture<bool> result;
+    broker_->Consume(host_->GetWeakPtr(), handle, u"user", u"secret",
+                     result.GetCallback());
+    return result.Get();
+  }
+
+ protected:
+  net::EmbeddedTestServer https_;
+  std::unique_ptr<WindowHost> host_;
+  raw_ptr<content::WebContents> contents_ = nullptr;
+  std::unique_ptr<NativePasswordBroker> broker_;
+};
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest, SuccessAndReplay) {
+  Load(https_.GetURL("/title1.html"));
+  auto handle = Request();
+  ASSERT_TRUE(handle);
+  EXPECT_TRUE(Fill(*handle));
+  EXPECT_EQ("user",
+            content::EvalJs(contents_, "document.getElementById('u').value"));
+  EXPECT_EQ("secret",
+            content::EvalJs(contents_, "document.getElementById('p').value"));
+  EXPECT_FALSE(Fill(*handle));
+}
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       RejectsChangedDocument) {
+  Load(https_.GetURL("/title1.html"));
+  auto handle = Request();
+  ASSERT_TRUE(handle);
+  Load(https_.GetURL("/title2.html"));
+  EXPECT_FALSE(Fill(*handle));
+}
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       RejectsFocusAwayAndBack) {
+  Load(https_.GetURL("/title1.html"));
+  auto handle = Request();
+  ASSERT_TRUE(handle);
+  auto* driver =
+      password_manager::ContentPasswordManagerDriver::GetForRenderFrameHost(
+          contents_->GetPrimaryMainFrame());
+  auto generation = driver->native_focus_generation();
+  ASSERT_TRUE(content::ExecJs(contents_,
+                              "document.getElementById('p').focus(); "
+                              "document.getElementById('u').focus();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return driver->native_focus_generation() > generation; }));
+  EXPECT_FALSE(Fill(*handle));
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest, RejectsTabAwayAndBack) {
+  Load(https_.GetURL("/title1.html"));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), https_.GetURL("/title2.html"),
+      WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  auto handle = Request();
+  ASSERT_TRUE(handle);
+  auto* tabs = browser()->GetTabStripModel();
+  tabs->ActivateTabAt(1);
+  tabs->ActivateTabAt(0);
+  EXPECT_FALSE(Fill(*handle));
+}
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       RejectsProfileAwayAndBack) {
+  Load(https_.GetURL("/title1.html"));
+  auto handle = Request();
+  ASSERT_TRUE(handle);
+  Profile* profile = browser()->GetProfile();
+  host_->SetActiveProfile(profile->GetPrimaryOTRProfile(true));
+  host_->SetActiveProfile(profile);
+  EXPECT_FALSE(Fill(*handle));
+}
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       PendingProfileAwayAndBackIsRejected) {
+  Load(https_.GetURL("/title1.html"));
+  base::test::TestFuture<std::optional<NativePasswordBroker::Handle>> result;
+  broker_->Request(host_->GetWeakPtr(), result.GetCallback());
+  ASSERT_FALSE(result.IsReady());
+  Profile* profile = browser()->GetProfile();
+  host_->SetActiveProfile(profile->GetPrimaryOTRProfile(true));
+  host_->SetActiveProfile(profile);
+  EXPECT_FALSE(result.Take());
+}
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       PendingDestructionCompletesOnce) {
+  Load(https_.GetURL("/title1.html"));
+  int calls = 0;
+  std::optional<NativePasswordBroker::Handle> value;
+  broker_->Request(
+      host_->GetWeakPtr(),
+      base::BindOnce(
+          [](int* calls, std::optional<NativePasswordBroker::Handle>* value,
+             std::optional<NativePasswordBroker::Handle> result) {
+            ++*calls;
+            *value = result;
+          },
+          &calls, &value));
+  ASSERT_EQ(0, calls);
+  broker_.reset();
+  EXPECT_EQ(1, calls);
+  EXPECT_FALSE(value);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, calls);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest,
+                       PendingCancelCompletesOnce) {
+  Load(https_.GetURL("/title1.html"));
+  int calls = 0;
+  broker_->Request(
+      host_->GetWeakPtr(),
+      base::BindOnce(
+          [](int* calls, std::optional<NativePasswordBroker::Handle> result) {
+            ++*calls;
+            EXPECT_FALSE(result);
+          },
+          &calls));
+  ASSERT_EQ(0, calls);
+  broker_->CancelAll();
+  EXPECT_EQ(1, calls);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, calls);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerBrowserTest, RejectsHttp) {
+  Load(embedded_test_server()->GetURL("/title1.html"));
+  EXPECT_FALSE(Request());
+}
+}  // namespace ardiacore
