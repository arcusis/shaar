+
+void PasswordAutofillAgent::GetNativeFocusedFormSnapshot(
+    base::OnceCallback<void(mojom::NativeFocusedFormSnapshotPtr)> callback) {
+  auto* frame =
+      unsafe_render_frame() ? unsafe_render_frame()->GetWebFrame() : nullptr;
+  if (!frame) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  auto document = frame->GetDocument();
+  auto focus = document.FocusedElement().DynamicTo<WebInputElement>();
+  if (!focus || !focus.IsConnected() || !IsElementEditable(focus) ||
+      !focus.IsTextField()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  auto form = focus.GetOwningFormForAutofill();
+  if (!form || !form.IsConnected()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  WebInputElement user;
+  WebInputElement pass;
+  for (const auto& control :
+       form_util::GetOwnedAutofillableFormControls(document, form)) {
+    auto input = control.DynamicTo<WebInputElement>();
+    if (!input || !input.IsConnected() || !IsElementEditable(input) ||
+        !input.IsTextField()) {
+      continue;
+    }
+    if (input.FormControlTypeForAutofill() == kInputPassword) {
+      if (pass) {
+        std::move(callback).Run(nullptr);
+        return;
+      }
+      pass = input;
+    } else {
+      if (user) {
+        std::move(callback).Run(nullptr);
+        return;
+      }
+      user = input;
+    }
+  }
+  if (!user || !pass || (focus != user && focus != pass)) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  auto snapshot = mojom::NativeFocusedFormSnapshot::New();
+  snapshot->document_token = document.Token();
+  snapshot->form_id = GetFormRendererId(form);
+  snapshot->focused_field_id = GetFieldRendererId(focus);
+  snapshot->focus_generation = native_focus_generation_;
+  snapshot->username_field_id = GetFieldRendererId(user);
+  snapshot->password_field_id = GetFieldRendererId(pass);
+  std::move(callback).Run(std::move(snapshot));
+}
+
+void PasswordAutofillAgent::FillNativePasswordSuggestion(
+    const blink::DocumentToken& document_token,
+    FormRendererId form_id,
+    FieldRendererId focused_field_id,
+    uint64_t focus_generation,
+    FieldRendererId username_field_id,
+    FieldRendererId password_field_id,
+    const std::u16string& username,
+    const std::u16string& password,
+    base::OnceCallback<void(bool)> callback) {
+  auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto valid = [&]() {
+    if (!weak || weak->native_focus_generation_ != focus_generation ||
+        !weak->unsafe_render_frame()) {
+      return false;
+    }
+    auto* frame = weak->unsafe_render_frame()->GetWebFrame();
+    if (!frame) {
+      return false;
+    }
+    auto document = frame->GetDocument();
+    if (document.IsNull() || document.Token() != document_token) {
+      return false;
+    }
+    auto user = GetFormControlByRendererId(username_field_id)
+                    .DynamicTo<WebInputElement>();
+    auto pass = GetFormControlByRendererId(password_field_id)
+                    .DynamicTo<WebInputElement>();
+    auto focus = document.FocusedElement();
+    if (!user || !pass || user == pass || !user.IsConnected() ||
+        !pass.IsConnected() || !IsElementEditable(user) ||
+        !IsElementEditable(pass) || !user.IsTextField() ||
+        user.FormControlTypeForAutofill() == kInputPassword ||
+        pass.FormControlTypeForAutofill() != kInputPassword ||
+        user.GetDocument() != document || pass.GetDocument() != document ||
+        (focus != user && focus != pass) ||
+        GetFieldRendererId(focus) != focused_field_id) {
+      return false;
+    }
+    auto form = user.GetOwningFormForAutofill();
+    return form && form.IsConnected() &&
+           form == pass.GetOwningFormForAutofill() &&
+           GetFormRendererId(form) == form_id;
+  };
+  if (!valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  ClearPreviewedForm();
+  if (!valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto user = GetFormControlByRendererId(username_field_id)
+                  .DynamicTo<WebInputElement>();
+  auto pass = GetFormControlByRendererId(password_field_id)
+                  .DynamicTo<WebInputElement>();
+  if (password_generation_agent_) {
+    password_generation_agent_->OnFieldAutofilled(pass);
+  }
+  if (!valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (user.Value().Utf16() != username) {
+    DoFillField(
+        user, username,
+        GetFieldFlags(
+            AutofillSuggestionTriggerSource::kFormControlElementClicked));
+  }
+  // Both notification and username fill can synchronously run page code.
+  if (!valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  pass = GetFormControlByRendererId(password_field_id)
+             .DynamicTo<WebInputElement>();
+  weak->FillPasswordFieldAndSave(
+      pass, password,
+      AutofillSuggestionTriggerSource::kFormControlElementClicked);
+  if (!weak || !valid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  user = GetFormControlByRendererId(username_field_id)
+             .DynamicTo<WebInputElement>();
+  pass = GetFormControlByRendererId(password_field_id)
+             .DynamicTo<WebInputElement>();
+  std::move(callback).Run(user.Value().Utf16() == username &&
+                          pass.Value().Utf16() == password);
+}
