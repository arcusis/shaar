+TEST_F(ChromePasswordManagerClientTest, CommittedNavigationContextIsScopedAndConsumed) {
+  auto* client = GetClient();
+  ASSERT_NE(client, nullptr);
+  std::vector<std::optional<int64_t>> observed;
+  auto navigation = base::BindRepeating(
+      [&](bool, const password_manager::PasswordFormManager*, std::optional<int64_t> id) {
+        observed.push_back(id);
+      });
+  client->SetNativeSubmissionCallbacks({}, {}, {}, navigation, {}, {});
+  client->NativeWithCommittedNavigation(11, base::BindOnce([&] {
+    client->NativeSubmissionWillNavigate(true, nullptr);
+    client->NativeWithCommittedNavigation(22, base::BindOnce([&] {
+      client->NativeSubmissionWillNavigate(true, nullptr);
+    }));
+    client->NativeSubmissionWillNavigate(true, nullptr);
+  }));
+  client->NativeSubmissionWillNavigate(true, nullptr);
+  ASSERT_EQ(observed.size(), 4u);
+  EXPECT_EQ(observed[0], 11);
+  EXPECT_EQ(observed[1], 22);
+  EXPECT_EQ(observed[2], std::nullopt);
+  EXPECT_EQ(observed[3], std::nullopt);
+
+  observed.clear();
+  client->NativeWithCommittedNavigation(33, base::BindOnce([&] {
+    client->SetNativeSubmissionCallbacks({}, {}, {}, navigation, {}, {});
+    client->NativeSubmissionWillNavigate(true, nullptr);
+  }));
+  client->NativeSubmissionWillNavigate(true, nullptr);
+  ASSERT_EQ(observed.size(), 2u);
+  EXPECT_EQ(observed[0], std::nullopt);
+  EXPECT_EQ(observed[1], std::nullopt);
+}
