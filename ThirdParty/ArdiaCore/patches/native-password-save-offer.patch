+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  auto offer = WaitForOffer();
+  ASSERT_TRUE(offer);
+  host_->widget()->Deactivate();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !host_->widget()->IsActive(); }));
+  int calls = 0;
+  broker_->ConfirmSaveOfferV1(host_->GetWeakPtr(), offer->nonce, offer->original_origin,
+      base::BindOnce([&](bool success, std::u16string username,
+                          password_manager::PasswordString password) {
+        ++calls;
+        EXPECT_FALSE(success);
+        EXPECT_TRUE(username.empty());
+        EXPECT_TRUE(password.empty());
+      }));
+  EXPECT_EQ(calls, 1);
+}
