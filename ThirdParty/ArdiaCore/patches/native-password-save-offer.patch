+  if (!browser || browser->GetTabStripModel()->GetActiveWebContents() != contents ||
+      ardiacore::TabBridge::GetOrCreate(contents)->tab() != tab) return nil;
+  static uint64_t next_generation = 0;
+  if (next_generation == UINT64_MAX) return nil;
+  const uint64_t generation = ++next_generation;
+  auto* broker = ardiacore::NativePasswordBroker::GetOrCreate(contents);
+  ArdiaCorePasswordSaveCapture* capture = [[ArdiaCorePasswordSaveCapture alloc]
+      initForOwner:self tab:tab host:host->GetWeakPtr() broker:broker->GetWeakPtr()
+      generation:generation accountEpoch:accountEpoch onOffer:onOffer onRevoke:onRevoke];
+  __weak ArdiaCorePasswordSaveCapture* weakCapture = capture;
+  bool armed = broker->ArmSaveCapture(host->GetWeakPtr(), generation, capture->_lease,
+      base::BindRepeating(^(ardiacore::NativePasswordBroker::SaveOfferInfo info) {
+        ArdiaCorePasswordSaveCapture* live = weakCapture;
+        if (!live || live->_revoked || !live->_host || !live->_broker ||
+            !live->_owner || !live->_tab || !live->_onOffer ||
+            info.expires <= base::TimeTicks::Now()) return;
+        ArdiaCorePasswordSaveOffer* offer =
+            [[ArdiaCorePasswordSaveOffer alloc] initForCapture:live info:info];
+        auto callback = live->_onOffer;
+        if (callback) callback(offer);
+      }),
+      base::BindOnce(^{
+        ArdiaCorePasswordSaveCapture* live = weakCapture;
+        if (live) [live revoke];
+      }));
+  if (!armed) {
+    capture->_onRevoke = nil;
+    [capture revoke];
+    return nil;
+  }
+  return capture;
+}
+
+- (void)consumePasswordSaveOffer:(ArdiaCorePasswordSaveOffer*)offer
+    displayedOrigin:(NSString*)displayedOrigin
+    completion:(void (^)(ArdiaCoreSaveOfferStatus, NSString*, NSString*))completion {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!completion) return;
+  ArdiaCorePasswordSaveCapture* capture = offer ? offer->_capture : nil;
+  if (!offer || offer->_used || !capture || capture->_revoked ||
+      capture->_owner != self || !capture->_tab || !capture->_host ||
+      capture->_host.get() != _host.get() || !capture->_broker ||
+      !capture->_host->widget() || !capture->_host->widget()->IsActive() ||
+      ![displayedOrigin isEqualToString:offer.originalOrigin]) {
+    if (offer) offer->_used = true;
+    completion(ArdiaCoreSaveOfferStatusUnavailable, nil, nil);
+    return;
+  }
+  offer->_used = true;
+  auto weakBroker = capture->_broker;
+  auto weakHost = capture->_host;
+  const auto handle = offer->_handle;
+  const auto origin = url::Origin::Create(GURL(base::SysNSStringToUTF8(displayedOrigin)));
+  weakBroker->ConfirmSaveOfferV1(weakHost, handle, origin,
+      base::BindOnce(^(bool success, std::u16string username,
+                       password_manager::PasswordString password) {
+        if (!success) {
+          completion(ArdiaCoreSaveOfferStatusUnavailable, nil, nil);
+          return;
+        }
+        completion(ArdiaCoreSaveOfferStatusConsumed, base::SysUTF16ToNSString(username),
+                   base::SysUTF16ToNSString(password.value()));
+      }));
+}
+
+- (void)cancelPasswordSaveCapture:(ArdiaCorePasswordSaveCapture*)capture {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!capture || capture->_owner != self || capture->_host.get() != _host.get()) return;
+  [capture revoke];
+}
