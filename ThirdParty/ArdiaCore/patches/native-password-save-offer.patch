+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerSaveBrowserTest,
+                       VersionOneReturnsTypedFailureExactlyOnceAndOriginalURL) {
+  ASSERT_NO_FATAL_FAILURE(LoadAndArm());
+  const GURL original = contents_->GetPrimaryMainFrame()->GetLastCommittedURL();
+  ASSERT_NO_FATAL_FAILURE(Submit());
+  auto offer = WaitForOffer();
+  ASSERT_TRUE(offer);
+  EXPECT_EQ(offer->original_url, original);
+  EXPECT_EQ(offer->original_origin, url::Origin::Create(original));
+  int calls = 0;
+  auto reply = base::BindOnce([&](bool success, std::u16string username,
+                                   password_manager::PasswordString password) {
+    ++calls;
+    EXPECT_FALSE(success);
+    EXPECT_TRUE(username.empty());
+    EXPECT_TRUE(password.empty());
+  });
+  broker_->ConfirmSaveOfferV1(host_->GetWeakPtr(), offer->nonce,
+      url::Origin::Create(GURL("https://other.example/")), std::move(reply));
+  EXPECT_EQ(calls, 1);
+  EXPECT_FALSE(broker_->PendingSaveOffer());
+  broker_->ConfirmSaveOfferV1(host_->GetWeakPtr(), offer->nonce, offer->original_origin,
+      base::BindOnce([&](bool success, std::u16string, password_manager::PasswordString) {
+        ++calls;
+        EXPECT_FALSE(success);
+      }));
+  EXPECT_EQ(calls, 2);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordBrokerSaveBrowserTest,
