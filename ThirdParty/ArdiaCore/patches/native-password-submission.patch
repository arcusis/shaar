+bool NativePasswordBroker::SaveLeaseValid() {
+  auto lease = save_account_lease_.lock();
+  if (!lease || !lease->valid(save_account_generation_)) return false;
+  auto* contents = web_contents();
+  if (!contents || contents->IsBeingDestroyed() || !save_owner_ ||
+      save_owner_->closing() || contents->GetBrowserContext()->IsOffTheRecord() ||
+      save_owner_->active_profile() != Profile::FromBrowserContext(contents->GetBrowserContext()) ||
+      save_owner_->selection_generation() != save_selection_generation_) return false;
+  auto* browser = save_owner_->ExistingBrowserFor(save_owner_->active_profile());
+  auto* client = ChromePasswordManagerClient::FromWebContents(contents);
+  return browser && browser->GetTabStripModel()->GetActiveWebContents() == contents &&
+         client && client->NativeCaptureSessionAllowed();
+}
+
+bool NativePasswordBroker::ArmSaveCapture(base::WeakPtr<WindowHost> owner,
+                                          uint64_t account_generation,
+                                          std::shared_ptr<AccountLease> lease) {
+  RevokeSaveCapture();
+  if (!owner || !lease || !lease->valid(account_generation)) return false;
+  save_owner_ = owner;
+  save_selection_generation_ = owner->selection_generation();
+  save_account_generation_ = account_generation;
+  save_account_lease_ = lease;
+  auto alive = save_weak_factory_.GetWeakPtr();
+  bool valid = SaveLeaseValid();
+  if (!alive) return false;
+  if (!valid) { RevokeSaveCapture(); return false; }
+  save_owner_subscription_ = owner->password_owner_selection().Add(
+      base::BindRepeating(&NativePasswordBroker::RevokeSaveCapture,
+                          save_weak_factory_.GetWeakPtr()));
+  save_account_subscription_ = lease->invalidations().Add(
+      base::BindRepeating(&NativePasswordBroker::RevokeSaveCapture,
+                          save_weak_factory_.GetWeakPtr()));
+  auto* client = ChromePasswordManagerClient::FromWebContents(web_contents());
+  client->SetNativeSubmissionCallbacks(
+      base::BindRepeating([](base::WeakPtr<NativePasswordBroker> broker) {
+        return broker && broker->SaveLeaseValid();
+      }, save_weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&NativePasswordBroker::PreparedSubmission, save_weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&NativePasswordBroker::InferredSubmission, save_weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&NativePasswordBroker::RevokeSaveCapture, save_weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void NativePasswordBroker::RevokeSaveCapture() {
+  if (web_contents()) {
+    if (auto* client = ChromePasswordManagerClient::FromWebContents(web_contents()))
+      client->InvalidateNativeCaptureSession();
+  }
+  prepared_save_.reset();
+  pending_save_.reset();
+  save_weak_factory_.InvalidateWeakPtrs();
+  save_owner_subscription_ = {};
+  save_account_subscription_ = {};
+  save_owner_.reset();
+  save_account_lease_.reset();
+}
+
+void NativePasswordBroker::PreparedSubmission(
+    password_manager::PasswordManagerDriver* driver, const autofill::FormData& form,
+    const password_manager::PasswordFormManager& manager) {
+  prepared_save_.reset();
+  pending_save_.reset();
+  if (!SaveLeaseValid()) return;
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || Driver::GetForRenderFrameHost(frame) != driver ||
+      frame->GetLastCommittedOrigin().opaque() ||
+      frame->GetLastCommittedOrigin().scheme() != url::kHttpsScheme ||
+      url::Origin::Create(form.url()) != frame->GetLastCommittedOrigin() ||
+      !form.action().SchemeIs(url::kHttpsScheme) ||
+      url::Origin::Create(form.action()) != frame->GetLastCommittedOrigin() ||
+      form.fields().empty() || form.fields().size() > 128 ||
+      manager.native_submission_nonce().is_empty()) return;
+  // Validate original browser-owned document only now. The minted binding
+  // remains historical metadata and is never used to read a later document.
+  auto document = frame->GetWeakDocumentPtr();
+  if (document.AsRenderFrameHostIfValid() != frame) return;
+  size_t password_fields = 0;
+  for (const auto& field : form.fields()) {
+    if (field.value().size() >= 1024) return;
+    if (field.form_control_type() == autofill::FormControlType::kInputPassword)
+      ++password_fields;
+  }
+  if (password_fields != 1) return;
+  prepared_save_.emplace(PreparedSave{manager.native_submission_nonce(), form.global_id(),
+                                      Handle::Create(), frame->GetLastCommittedOrigin(),
+                                      base::TimeTicks::Now() + kLifetime});
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&NativePasswordBroker::ExpireSave,
+                               save_weak_factory_.GetWeakPtr(), manager.native_submission_nonce()), kLifetime);
+}
+
+void NativePasswordBroker::InferredSubmission(const password_manager::PasswordFormManager& manager) {
+  auto alive = save_weak_factory_.GetWeakPtr();
+  bool valid = SaveLeaseValid();
+  if (!alive) return;
+  if (!valid || !prepared_save_ ||
+      base::TimeTicks::Now() >= prepared_save_->expires ||
+      manager.native_submission_nonce() != prepared_save_->manager_nonce ||
+      !manager.GetSubmittedForm() ||
+      manager.GetSubmittedForm()->form_data.global_id() != prepared_save_->form_id) {
+    prepared_save_.reset();
+    return;
+  }
+  const auto event = manager.GetSubmittedForm()->submission_event;
+  using Event = autofill::mojom::SubmissionIndicatorEvent;
+  if (event != Event::HTML_FORM_SUBMISSION && event != Event::XHR_SUCCEEDED &&
+      event != Event::SAME_DOCUMENT_NAVIGATION) {
+    prepared_save_.reset();
+    return;
+  }
+  const auto& form = manager.GetPendingCredentials();
+  if (form.scheme != password_manager::PasswordForm::Scheme::kHtml ||
+      form.IsFederatedCredential() || form.only_for_fallback || form.password_value.empty() ||
+      form.password_value.size() >= 1024 || form.username_value.size() >= 1024 ||
+      url::Origin::Create(form.url) != prepared_save_->original_origin) {
+    prepared_save_.reset();
+    return;
+  }
+  Handle nonce = prepared_save_->manager_nonce;
+  pending_save_.emplace(PendingSave{nonce, prepared_save_->form_id,
+                                    prepared_save_->document_binding, prepared_save_->original_origin,
+                                    prepared_save_->expires, form.username_value, form.password_value});
+  prepared_save_.reset();
+}
+
+void NativePasswordBroker::ExpireSave(Handle nonce) {
+  if ((prepared_save_ && prepared_save_->manager_nonce == nonce) ||
+      (pending_save_ && pending_save_->nonce == nonce))
+    RevokeSaveCapture();
+}
+
+std::optional<NativePasswordBroker::SaveOfferInfo> NativePasswordBroker::PendingSaveOffer() {
+  if (!SaveLeaseValid() || !pending_save_ || base::TimeTicks::Now() >= pending_save_->expires)
+    return std::nullopt;
+  return SaveOfferInfo{pending_save_->nonce, pending_save_->original_origin};
+}
+
+void NativePasswordBroker::ConfirmSaveOffer(base::WeakPtr<WindowHost> owner, const Handle& nonce,
+    const url::Origin& displayed_original_origin, SaveResult completion) {
+  auto offer = std::move(pending_save_);
+  pending_save_.reset();
+  if (completion.is_null() || !offer || !owner || owner.get() != save_owner_.get() || !SaveLeaseValid() ||
+      offer->nonce != nonce || offer->original_origin != displayed_original_origin ||
+      base::TimeTicks::Now() >= offer->expires) return;
+  std::move(completion).Run(std::move(offer->username), std::move(offer->password));
+}
