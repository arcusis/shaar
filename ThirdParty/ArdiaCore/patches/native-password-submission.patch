+bool ChromePasswordManagerClient::NativeCaptureSessionAllowed() const {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto state = std::static_pointer_cast<NativePasswordPolicyState>(native_policy_state_);
+  return state && state->enabled && !state->retired && !state->transitioning &&
+         !state->capture_blocked;
+}
+
+bool ChromePasswordManagerClient::NativeCaptureAllowed(
+    const url::Origin& origin, const GURL& url) const {
+  if (!NativeCaptureSessionAllowed() || !web_contents() || IsOffTheRecord() ||
+      !GetProfile() || GetProfile()->IsGuestSession() || origin.opaque() ||
+      origin.scheme() != "https" || !url.SchemeIs("https") ||
+      url::Origin::Create(url) != origin || native_capture_check_.is_null()) return false;
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+  return frame && frame->IsActive() && frame->IsRenderFrameLive() &&
+         !frame->IsErrorDocument() && frame->GetLastCommittedOrigin() == origin &&
+         entry && entry->GetSSL().certificate &&
+         !net::IsCertStatusError(entry->GetSSL().cert_status) &&
+         IsPasswordManagementEnabledForCurrentPage(url) && native_capture_check_.Run();
+}
