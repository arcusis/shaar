+void ChromePasswordManagerClient::NativeSubmissionPrepared(
+    PasswordManagerDriver* driver, const autofill::FormData& form,
+    const password_manager::PasswordFormManager& manager) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto alive = weak_ptr_factory_.GetWeakPtr();
+  bool allowed = driver && NativeCaptureAllowed(driver->GetLastCommittedOrigin(), form.url());
+  if (alive && allowed && !native_prepared_.is_null())
+    native_prepared_.Run(driver, form, manager);
+}
+
+void ChromePasswordManagerClient::NativeSubmissionInferred(
+    const password_manager::PasswordFormManager& manager) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto alive = weak_ptr_factory_.GetWeakPtr();
+  bool allowed = NativeCaptureSessionAllowed() && !native_capture_check_.is_null() &&
+                 native_capture_check_.Run();
+  if (alive && allowed && !native_inferred_.is_null()) native_inferred_.Run(manager);
+}
