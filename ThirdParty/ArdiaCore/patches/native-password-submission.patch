+void ChromePasswordManagerClient::SetNativePasswordOnlyPolicyForTesting(
+    Profile* profile, bool enabled) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile || profile->IsOffTheRecord() || profile->IsGuestSession()) return;
+  // A client must already have installed the observer before shutdown begins.
+  auto state = NativePolicy(profile);
+  if (!state || state->retired) return;
+  if (state->transitioning) {
+    state->reentered = true;
+    state->enabled = true;
+    state->capture_blocked = true;
+    return;
+  }
+  if (state->enabled == enabled && !state->capture_blocked) return;
+  state->transitioning = true;
+  state->reentered = false;
+  state->capture_blocked = true;
+  if (enabled) state->enabled = true;
+  const auto profile_alive = profile->GetWeakPtr();
+  const auto clients = state->clients;
+  // Only retained state and weak references cross a callback boundary. New
+  // clients or nested transitions mark reentry and leave capture blocked.
+  for (auto client : clients) {
+    if (!profile_alive || state->retired) break;
+    if (!client) continue;
+    auto revoke = client->native_revoke_;
+    if (!revoke.is_null()) revoke.Run();
+    if (!profile_alive || state->retired) break;
+    if (!client) continue;
+    client->password_manager_.DropFormManagers();
+    if (!profile_alive || state->retired) break;
+    if (!client) continue;
+    client->SetNativeSubmissionCallbacks({}, {}, {}, {});
+  }
+  if (!profile_alive || state->retired || state->reentered) {
+    state->enabled = true;
+    state->capture_blocked = true;
+  } else {
+    state->enabled = enabled;
+    state->capture_blocked = !enabled;
+  }
+  // Notify renderer after the effective policy changes, never by retaining a
+  // Profile or client pointer across callbacks. Renderer acknowledgement is a
+  // separate activation barrier and is not established here.
+  for (auto client : clients) {
+    if (!profile_alive || state->retired) break;
+    if (!client) continue;
+    if (auto* factory = client->GetDriverFactory())
+      factory->RequestSendLoggingAvailability();
+  }
+  if (!profile_alive || state->retired || state->reentered) {
+    state->enabled = true;
+    state->capture_blocked = true;
+  }
+  state->transitioning = false;
+}
