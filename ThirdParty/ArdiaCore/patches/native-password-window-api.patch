+- (void)requestPasswordFillForTab:(ArdiaCoreTab*)tab
+                      completion:(void (^)(ArdiaCorePasswordFillRequest*))completion {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::WebContents* contents = tab.contents;
+  auto* host = _host.get();
+  if (!contents || contents->IsBeingDestroyed() || !contents->GetPrimaryMainFrame() ||
+      !host || host->closing() || !host->widget() ||
+      !host->widget()->IsActive() ||
+      contents->GetBrowserContext()->IsOffTheRecord()) {
+    completion(nil);
+    return;
+  }
+  auto* browser = host->ExistingBrowserFor(host->active_profile());
+  if (!browser || browser->GetTabStripModel()->GetActiveWebContents() != contents ||
+      ardiacore::TabBridge::GetOrCreate(contents)->tab() != tab) {
+    completion(nil);
+    return;
+  }
+  auto* broker = ardiacore::NativePasswordBroker::GetOrCreate(contents);
+  auto weakBroker = broker->GetWeakPtr();
+  auto weakHost = host->GetWeakPtr();
+  __weak ArdiaCoreWindow* weakOwner = self;
+  __weak ArdiaCoreTab* weakTab = tab;
+  NSString* origin = base::SysUTF8ToNSString(
+      contents->GetPrimaryMainFrame()->GetLastCommittedOrigin().Serialize());
+  auto gate = std::make_shared<ardiacore::PasswordCompletionGate>(base::BindOnce(^{ completion(nil); }));
+  gate->Start(host->password_owner_closing());
+  broker->Request(weakHost, base::BindOnce(
+      ^(std::optional<ardiacore::NativePasswordBroker::Handle> handle) {
+        if (!gate->Finish()) {
+          if (handle && weakBroker) weakBroker->Cancel(*handle);
+          return;
+        }
+        ArdiaCoreWindow* owner = weakOwner;
+        ArdiaCoreTab* actualTab = weakTab;
+        if (!handle || !owner || !actualTab || !weakHost || !weakBroker ||
+            weakHost->closing() || !weakHost->widget() || !weakHost->widget()->IsActive()) {
+          if (handle && weakBroker) weakBroker->Cancel(*handle);
+          completion(nil);
+          return;
+        }
+        completion([[ArdiaCorePasswordFillRequest alloc] initWithOwner:owner
+            tab:actualTab host:weakHost broker:weakBroker handle:*handle origin:origin]);
+      }));
+}
+
+- (void)fillPasswordRequest:(ArdiaCorePasswordFillRequest*)request
+                   username:(NSString*)username
+                   password:(NSString*)password
+                 completion:(void (^)(BOOL))completion {
