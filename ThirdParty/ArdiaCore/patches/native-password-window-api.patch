+#include "ui/views/widget/widget.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace ardiacore {
+
+TEST(NativePasswordCompletionGateTest, OwnerDestructionCompletesOnce) {
+  base::test::TaskEnvironment tasks(base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  base::RepeatingClosureList owner;
+  int failures = 0;
+  auto gate = std::make_shared<PasswordCompletionGate>(
+      base::BindOnce([](int* count) { ++*count; }, &failures));
+  gate->Start(owner);
+  owner.Notify();
+  EXPECT_EQ(1, failures);
+  EXPECT_FALSE(gate->Finish());
+  tasks.FastForwardBy(base::Seconds(30));
+  EXPECT_EQ(1, failures);
+}
+
+TEST(NativePasswordCompletionGateTest, PendingDeadlineAndLateReplyCompleteOnce) {
+  base::test::TaskEnvironment tasks(base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  base::RepeatingClosureList owner;
+  int failures = 0;
+  auto gate = std::make_shared<PasswordCompletionGate>(
+      base::BindOnce([](int* count) { ++*count; }, &failures));
+  gate->Start(owner);
+  tasks.FastForwardBy(base::Seconds(30));
+  EXPECT_EQ(1, failures);
+  EXPECT_FALSE(gate->Finish());
+  owner.Notify();
+  EXPECT_EQ(1, failures);
+}
+
+class NativePasswordWindowApiBrowserTest : public InProcessBrowserTest {
+ public:
+  NativePasswordWindowApiBrowserTest() : https_(net::EmbeddedTestServer::TYPE_HTTPS) {}
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(https_.Start());
+    window_ = [[ArdiaCoreWindow alloc] initWithContentRect:NSMakeRect(0, 0, 800, 600)];
+    profile_ = [ArdiaCoreProfile wrapperFor:browser()->GetProfile()];
+    window_.activeProfile = profile_;
+    window_.host->widget()->Show();
+    window_.host->widget()->Activate();
+    tab_ = [window_ openTab:base::SysUTF8ToNSString(https_.GetURL("/title1.html").spec())
+                    profile:profile_ foreground:YES];
+    ASSERT_TRUE(tab_);
+    ASSERT_TRUE(content::WaitForLoadStop(tab_.contents));
+    ASSERT_TRUE(content::ExecJs(tab_.contents,
+        "document.body.innerHTML='<form><input id=u><input id=p type=password></form>';"
+        "document.getElementById('u').focus()"));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      auto* frame = tab_.contents->GetPrimaryMainFrame();
+      auto* driver = password_manager::ContentPasswordManagerDriver::GetForRenderFrameHost(frame);
+      return driver && driver->native_focused_field() != autofill::FieldRendererId() &&
+             tab_.contents->GetFocusedFrame() == frame;
+    }));
+  }
+  void TearDownOnMainThread() override { [window_ close]; tab_ = nil; window_ = nil; }
+  ArdiaCorePasswordFillRequest* Request(ArdiaCoreWindow* window, ArdiaCoreTab* tab) {
+    __block bool done = false;
+    __block ArdiaCorePasswordFillRequest* result = nil;
+    [window requestPasswordFillForTab:tab completion:^(ArdiaCorePasswordFillRequest* request) {
+      result = request; done = true;
+    }];
+    EXPECT_TRUE(base::test::RunUntil([&] { return done; }));
+    return result;
+  }
+  bool Fill(ArdiaCoreWindow* window, ArdiaCorePasswordFillRequest* request) {
+    __block bool done = false;
+    __block BOOL result = NO;
+    [window fillPasswordRequest:request username:@"user" password:@"secret"
+                     completion:^(BOOL filled) { result = filled; done = true; }];
+    EXPECT_TRUE(base::test::RunUntil([&] { return done; }));
+    return result;
+  }
+ protected:
+  net::EmbeddedTestServer https_;
+  ArdiaCoreWindow* __strong window_;
+  ArdiaCoreProfile* __strong profile_;
+  ArdiaCoreTab* __strong tab_;
+};
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, HostDestructionFencesPendingGate) {
+  auto host = std::make_unique<WindowHost>(nil, gfx::Rect(0, 0, 800, 600));
+  int failures = 0;
+  auto gate = std::make_shared<PasswordCompletionGate>(
+      base::BindOnce([](int* count) { ++*count; }, &failures));
+  gate->Start(host->password_owner_closing());
+  host.reset();
+  EXPECT_EQ(1, failures);
+  EXPECT_FALSE(gate->Finish());
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, CloseCallbackMayDestroyHost) {
+  auto host = std::make_unique<WindowHost>(nil, gfx::Rect(0, 0, 800, 600));
+  int failures = 0;
+  auto gate = std::make_shared<PasswordCompletionGate>(base::BindOnce(
+      [](std::unique_ptr<WindowHost>* owner, int* count) {
+        ++*count;
+        owner->reset();
+      }, &host, &failures));
+  gate->Start(host->password_owner_closing());
+  host->Close();
+  EXPECT_FALSE(host);
+  EXPECT_EQ(1, failures);
+  EXPECT_FALSE(gate->Finish());
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, SuccessAndReplay) {
+  ArdiaCorePasswordFillRequest* request = Request(window_, tab_);
+  ASSERT_TRUE(request);
+  EXPECT_TRUE([request.origin hasPrefix:@"https://"]);
+  EXPECT_TRUE(Fill(window_, request));
+  EXPECT_EQ("secret", content::EvalJs(tab_.contents, "document.getElementById('p').value"));
+  EXPECT_FALSE(Fill(window_, request));
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, WrongOwnerTabAndCancel) {
+  ArdiaCorePasswordFillRequest* request = Request(window_, tab_);
+  ASSERT_TRUE(request);
+  ArdiaCoreWindow* other = [[ArdiaCoreWindow alloc] initWithContentRect:NSMakeRect(0, 0, 800, 600)];
+  EXPECT_FALSE(Fill(other, request));
+  EXPECT_FALSE(Request(other, tab_));
+  [other cancelPasswordRequest:request];
+  [window_ cancelPasswordRequest:request];
+  EXPECT_FALSE(Fill(window_, request));
+  [other close];
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, CancelPendingFillFencesReply) {
+  ArdiaCorePasswordFillRequest* request = Request(window_, tab_);
+  ASSERT_TRUE(request);
+  __block int calls = 0;
+  __block BOOL result = YES;
+  [window_ fillPasswordRequest:request username:@"user" password:@"secret"
+                    completion:^(BOOL filled) { ++calls; result = filled; }];
+  [window_ cancelPasswordRequest:request];
+  ASSERT_TRUE(base::test::RunUntil([&] { return calls != 0; }));
+  EXPECT_EQ(1, calls);
+  EXPECT_FALSE(result);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, calls);
+}
+
+IN_PROC_BROWSER_TEST_F(NativePasswordWindowApiBrowserTest, PrivateProfileRejected) {
+  Profile* private_profile = browser()->GetProfile()->GetPrimaryOTRProfile(true);
+  ArdiaCoreProfile* wrapper = [ArdiaCoreProfile wrapperFor:private_profile];
+  window_.activeProfile = wrapper;
+  ArdiaCoreTab* private_tab = [window_ openTab:base::SysUTF8ToNSString(https_.GetURL("/title1.html").spec())
+                                      profile:wrapper foreground:YES];
+  ASSERT_TRUE(private_tab);
+  ASSERT_TRUE(content::WaitForLoadStop(private_tab.contents));
+  ASSERT_TRUE(content::ExecJs(private_tab.contents,
+      "document.body.innerHTML='<form><input id=u><input type=password></form>';"
+      "document.getElementById('u').focus()"));
+  EXPECT_FALSE(Request(window_, private_tab));
+}
+}  // namespace ardiacore
