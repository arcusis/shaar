new file mode 100644
index 0000000..a3cdc4b
--- /dev/null
+++ b/ardia/core/ac_native_password_completion_gate.h
@@ -0,0 +1,45 @@
+#ifndef ARDIA_CORE_AC_NATIVE_PASSWORD_COMPLETION_GATE_H_
+#define ARDIA_CORE_AC_NATIVE_PASSWORD_COMPLETION_GATE_H_
+
+#include <memory>
+#include <utility>
+#include "base/callback_list.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+
+namespace ardiacore {
+// One gate per operation. The host's callback list owns it until completion;
+// the delayed task bounds its lifetime even if the Mojo reply never arrives.
+class PasswordCompletionGate : public std::enable_shared_from_this<PasswordCompletionGate> {
+ public:
+  explicit PasswordCompletionGate(base::OnceClosure failure)
+      : failure_(std::move(failure)) {}
+  void Start(base::RepeatingClosureList& owners, base::TimeDelta deadline = base::Seconds(30)) {
+    auto self = shared_from_this();
+    subscription_ = owners.Add(base::BindRepeating(
+        [](std::shared_ptr<PasswordCompletionGate> gate) { gate->Fail(); }, self));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce([](std::shared_ptr<PasswordCompletionGate> gate) {
+          gate->Fail();
+        }, self), deadline);
+  }
+  bool Finish() {
+    if (!failure_) return false;
+    failure_.Reset();
+    subscription_ = {};
+    return true;
+  }
+  void Fail() {
+    if (!failure_) return;
+    auto failure = std::move(failure_);
+    subscription_ = {};
+    std::move(failure).Run();
+  }
+ private:
+  base::OnceClosure failure_;
+  base::CallbackListSubscription subscription_;
+};
+}  // namespace ardiacore
+
+#endif
