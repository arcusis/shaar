+
+// Enabled by the embedded engine before the host can create a private profile.
+// Defined in extension_util.cc so standalone Chromium tests retain their
+// defaults.
+extern std::atomic_bool g_private_profile_policies_enabled;
+
+// Applies only transient OTR state. Returns false if required settings did not
+// take effect, so the host can refuse to create an unprotected private window.
+bool PreparePrivateProfile(Profile* profile);
