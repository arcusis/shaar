+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "ardia/core/ac_private_privacy.h"
+
+#include <utility>
+
+#include "ardia/core/ac_private_requests.h"
+#include "base/no_destructor.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ardia/ac_engine.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_manager_observer.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "chrome/common/pref_names.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/prefs/pref_service.h"
+
+namespace ardiacore {
+namespace {
+
+ContentSetting CookieDefault(Profile* profile) {
+  auto* settings = HostContentSettingsMapFactory::GetForProfile(profile);
+  if (!profile->IsOffTheRecord()) {
+    return settings->GetDefaultContentSetting(ContentSettingsType::COOKIES,
+                                              nullptr);
+  }
+  // Preserve provider precedence, including policies above the OTR rule map.
+  for (const auto& rule :
+       settings->GetSettingsForOneType(ContentSettingsType::COOKIES)) {
+    if (rule.primary_pattern == ContentSettingsPattern::Wildcard() &&
+        rule.secondary_pattern == ContentSettingsPattern::Wildcard()) {
+      return rule.GetContentSetting();
+    }
+  }
+  return CONTENT_SETTING_DEFAULT;
+}
+
+class PrivateProfilePolicies : public ProfileManagerObserver,
+                               public ProfileObserver {
+ public:
+  explicit PrivateProfilePolicies(ProfileManager* manager) {
+    manager_observation_.Observe(manager);
+    for (Profile* profile : manager->GetLoadedProfiles()) {
+      OnProfileAdded(profile);
+    }
+  }
+
+  void OnProfileAdded(Profile* profile) override {
+    if (profile->IsOffTheRecord()) {
+      PreparePrivateProfile(profile);
+      return;
+    }
+    if (!profile_observations_.IsObservingSource(profile)) {
+      profile_observations_.AddObservation(profile);
+    }
+    for (Profile* otr : profile->GetAllOffTheRecordProfiles()) {
+      PreparePrivateProfile(otr);
+    }
+  }
+
+  void OnOffTheRecordProfileCreated(Profile* profile) override {
+    PreparePrivateProfile(profile);
+  }
+
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    profile_observations_.RemoveObservation(profile);
+  }
+
+  void OnProfileManagerDestroying() override {
+    profile_observations_.RemoveAllObservations();
+    manager_observation_.Reset();
+  }
+
+ private:
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      manager_observation_{this};
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver>
+      profile_observations_{this};
+};
+
+}  // namespace
+
+bool PreparePrivateProfile(Profile* profile) {
+  if (!g_private_profile_policies_enabled || !profile ||
+      !profile->IsOffTheRecord() || profile->ShutdownStarted() ||
+      profile->GetOriginalProfile()->ShutdownStarted()) {
+    return false;
+  }
+  PrefService* preferences = profile->GetPrefs();
+  preferences->SetBoolean(prefs::kHttpsOnlyModeEnabled, true);
+  preferences->SetBoolean(prefs::kHttpsFirstBalancedMode, false);
+  preferences->SetBoolean(prefs::kEnableReferrers, false);
+  preferences->SetString(prefs::kWebRTCIPHandlingPolicy,
+                         "disable_non_proxied_udp");
+  preferences->SetList(prefs::kWebRTCIPHandlingUrl, base::ListValue());
+  preferences->SetList(prefs::kWebRtcLocalIpsAllowedUrls, base::ListValue());
+
+  // The OTR PrefProvider stores this wildcard in memory ahead of inherited
+  // regular-profile exceptions. Exact OTR site allowances still take priority.
+  auto* settings = HostContentSettingsMapFactory::GetForProfile(profile);
+  settings->SetContentSettingCustomScope(
+      ContentSettingsPattern::Wildcard(), ContentSettingsPattern::Wildcard(),
+      ContentSettingsType::COOKIES, CONTENT_SETTING_BLOCK);
+  return preferences->GetBoolean(prefs::kHttpsOnlyModeEnabled) &&
+         !preferences->GetBoolean(prefs::kEnableReferrers) &&
+         preferences->GetString(prefs::kWebRTCIPHandlingPolicy) ==
+             "disable_non_proxied_udp" &&
+         preferences->GetList(prefs::kWebRTCIPHandlingUrl).empty() &&
+         preferences->GetList(prefs::kWebRtcLocalIpsAllowedUrls).empty() &&
+         CookieDefault(profile) == CONTENT_SETTING_BLOCK &&
+         PrivateTrackerRulesReady(profile);
+}
+
+void StartPrivateProfilePolicies(ProfileManager* manager) {
+  g_private_profile_policies_enabled = true;
+  InstallPrivateWebSocketPolicy();
+  static base::NoDestructor<PrivateProfilePolicies> policies(manager);
+}
+
+}  // namespace ardiacore
+
+AC_ENGINE_CALL(ac_site_settings_set_default) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kAllow, true);
+  if (!call) {
+    return;
+  }
+  if (!call.profile()->IsOffTheRecord()) {
+    return call.TakeReply().Error(
+        "default settings require an off-the-record profile");
+  }
+  if (call.String("type") != "cookies") {
+    return call.TakeReply().Error(
+        "only the private cookie/storage default is supported");
+  }
+  const std::string value = call.String("value");
+  if (value != "block" && value != "allow") {
+    return call.TakeReply().Error("value must be block or allow");
+  }
+  HostContentSettingsMapFactory::GetForProfile(call.profile())
+      ->SetContentSettingCustomScope(
+          ContentSettingsPattern::Wildcard(),
+          ContentSettingsPattern::Wildcard(), ContentSettingsType::COOKIES,
+          value == "block" ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_ALLOW);
+  if (ardiacore::CookieDefault(call.profile()) !=
+      (value == "block" ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_ALLOW)) {
+    return call.TakeReply().Error("private cookie default did not take effect");
+  }
+  call.TakeReply().Ok();
+}
+
+AC_ENGINE_CALL(ac_private_privacy_get) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kAllow, true);
+  if (!call) {
+    return;
+  }
+  Profile* profile = call.profile();
+  PrefService* preferences = profile->GetPrefs();
+  const ContentSetting cookies = ardiacore::CookieDefault(profile);
+  base::DictValue status;
+  status.Set("schema", 1);
+  status.Set("offTheRecord", profile->IsOffTheRecord());
+  status.Set("globalCookies", cookies == CONTENT_SETTING_BLOCK ? "block"
+                               : cookies == CONTENT_SETTING_ALLOW ? "allow"
+                                                                   : "inherited");
+  status.Set("httpsOnly", preferences->GetBoolean(prefs::kHttpsOnlyModeEnabled));
+  status.Set("referrersEnabled", preferences->GetBoolean(prefs::kEnableReferrers));
+  status.Set("webRTCIPHandlingPolicy",
+             preferences->GetString(prefs::kWebRTCIPHandlingPolicy));
+  status.Set("webRTCPolicyExceptionCount",
+             static_cast<int>(preferences->GetList(prefs::kWebRTCIPHandlingUrl).size()));
+  status.Set("localIPExceptionCount",
+             static_cast<int>(preferences->GetList(prefs::kWebRtcLocalIpsAllowedUrls).size()));
+  status.Set("extensionsDisabled", profile->IsOffTheRecord() &&
+                                    ardiacore::g_private_profile_policies_enabled);
+  status.Merge(ardiacore::PrivateTrackerStatus(profile));
+  call.TakeReply().Send(std::move(status));
+}
