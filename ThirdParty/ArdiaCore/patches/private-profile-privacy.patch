+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace ardiacore {
+namespace {
+
+class TrackerRulesState : public ardia::ProfileState {
+ public:
+  explicit TrackerRulesState(Profile* profile) : ProfileState(profile) {}
+  std::string revision;
+  std::set<std::string, std::less<>> domains;
+
+ protected:
+  void Release() override {
+    domains.clear();
+    revision.clear();
+  }
+};
+
+class PrivateTrackerState : public ardia::ProfileState {
+ public:
+  explicit PrivateTrackerState(Profile* profile) : ProfileState(profile) {}
+  std::set<std::string> allowed_origins;
+  int blocked_requests = 0;
+
+ protected:
+  void Release() override { allowed_origins.clear(); }
+};
+
+TrackerRulesState& RulesFor(Profile* profile) {
+  return ardia::StateFor<TrackerRulesState>(profile->GetOriginalProfile());
+}
+
+bool ValidDomain(const std::string& domain) {
+  if (domain.empty() || domain.size() > 253 ||
+      domain.find('.') == std::string::npos || domain.back() == '.') {
+    return false;
+  }
+  const GURL canonical("https://" + domain + "/");
+  if (!canonical.is_valid() || canonical.HostIsIPAddress() ||
+      canonical.host() != domain) {
+    return false;
+  }
+  std::string_view labels(domain);
+  while (!labels.empty()) {
+    const size_t dot = labels.find('.');
+    const std::string_view label = labels.substr(0, dot);
+    if (label.empty() || label.size() > 63 || label.front() == '-' ||
+        label.back() == '-' ||
+        !std::all_of(label.begin(), label.end(), [](char c) {
+          return base::IsAsciiAlphaNumeric(c) || c == '-';
+        })) {
+      return false;
+    }
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    labels.remove_prefix(dot + 1);
+  }
+  return true;
+}
+
+bool MatchesTracker(const TrackerRulesState& rules, const GURL& url) {
+  std::string_view host = url.host();
+  while (!host.empty() && host.back() == '.') {
+    host.remove_suffix(1);
+  }
+  while (!host.empty()) {
+    if (rules.domains.contains(host)) {
+      return true;
+    }
+    const size_t dot = host.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    host.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
+int PolicyError(Profile* profile,
+                const GURL& url,
+                const std::optional<url::Origin>& top_origin) {
+  if (!profile || profile->ShutdownStarted() ||
+      profile->GetOriginalProfile()->ShutdownStarted()) {
+    return net::ERR_CONTEXT_SHUT_DOWN;
+  }
+  if (!profile->IsOffTheRecord()) {
+    return net::OK;
+  }
+  const TrackerRulesState& rules = RulesFor(profile);
+  if (rules.domains.empty()) {
+    return net::ERR_BLOCKED_BY_CLIENT;
+  }
+  if ((!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsWSOrWSS()) ||
+      !MatchesTracker(rules, url)) {
+    return net::OK;
+  }
+  PrivateTrackerState& state = ardia::StateFor<PrivateTrackerState>(profile);
+  if (top_origin && !top_origin->opaque()) {
+    if (state.allowed_origins.contains(top_origin->Serialize()) ||
+        net::registry_controlled_domains::SameDomainOrHost(
+            url, *top_origin,
+            net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)) {
+      return net::OK;
+    }
+  }
+  if (state.blocked_requests < std::numeric_limits<int>::max()) {
+    ++state.blocked_requests;
+  }
+  return net::ERR_BLOCKED_BY_CLIENT;
+}
+
+class PrivateRequest : public network::mojom::URLLoader,
+                       public network::mojom::URLLoaderClient,
+                       public base::SelfDeleting {
+ public:
+  PrivateRequest(mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+                 mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+                 base::WeakPtr<Profile> profile,
+                 std::optional<url::Origin> top_origin,
+                 bool main_frame,
+                 base::SelfDeletingPassKey key)
+      : base::SelfDeleting(key),
+        receiver_(this, std::move(receiver)),
+        client_(std::move(client)),
+        upstream_client_(this),
+        profile_(std::move(profile)),
+        top_origin_(std::move(top_origin)),
+        main_frame_(main_frame) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&PrivateRequest::OnDisconnect, base::Unretained(this)));
+    client_.set_disconnect_handler(
+        base::BindOnce(&PrivateRequest::OnDisconnect, base::Unretained(this)));
+  }
+
+  void Start(network::mojom::URLLoaderFactory* factory,
+             int32_t request_id,
+             uint32_t options,
+             const network::ResourceRequest& request,
+             const net::MutableNetworkTrafficAnnotationTag& annotation) {
+    current_url_ = request.url;
+    if (main_frame_) {
+      top_origin_ = url::Origin::Create(current_url_);
+    }
+    const int error = PolicyError(profile_.get(), current_url_, top_origin_);
+    if (error != net::OK) {
+      Finish(network::URLLoaderCompletionStatus(error));
+      return;
+    }
+    network::ResourceRequest clean_request(request);
+    clean_request.referrer = GURL();
+    clean_request.referrer_policy = net::ReferrerPolicy::NO_REFERRER;
+    clean_request.headers.RemoveHeader("Referer");
+    clean_request.cors_exempt_headers.RemoveHeader("Referer");
+    auto upstream_receiver = upstream_loader_.BindNewPipeAndPassReceiver();
+    upstream_loader_.set_disconnect_handler(base::BindOnce(
+        &PrivateRequest::OnUpstreamDisconnect, base::Unretained(this)));
+    factory->CreateLoaderAndStart(
+        std::move(upstream_receiver), request_id, options, clean_request,
+        upstream_client_.BindNewPipeAndPassRemote(), annotation);
+  }
+
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams headers,
+                      const std::optional<GURL>& new_url) override {
+    const GURL& destination = new_url ? *new_url : current_url_;
+    const int error = PolicyError(profile_.get(), destination, top_origin_);
+    if (error != net::OK) {
+      Finish(network::URLLoaderCompletionStatus(error));
+      return;
+    }
+    headers.removed_headers.push_back("Referer");
+    headers.modified_headers.RemoveHeader("Referer");
+    headers.modified_cors_exempt_headers.RemoveHeader("Referer");
+    upstream_loader_->FollowRedirect(std::move(headers), new_url);
+  }
+
+  void SetPriority(net::RequestPriority priority,
+                   int32_t intra_priority_value) override {
+    upstream_loader_->SetPriority(priority, intra_priority_value);
+  }
+
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    client_->OnReceiveEarlyHints(std::move(hints));
+  }
+
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> metadata) override {
+    client_->OnReceiveResponse(std::move(head), std::move(body),
+                               std::move(metadata));
+  }
+
+  void OnReceiveRedirect(const net::RedirectInfo& redirect,
+                         network::mojom::URLResponseHeadPtr head) override {
+    current_url_ = redirect.new_url;
+    if (main_frame_) {
+      top_origin_ = url::Origin::Create(current_url_);
+    }
+    const int error = PolicyError(profile_.get(), current_url_, top_origin_);
+    if (error != net::OK) {
+      Finish(network::URLLoaderCompletionStatus(error));
+      return;
+    }
+    net::RedirectInfo clean_redirect(redirect);
+    clean_redirect.new_referrer.clear();
+    clean_redirect.new_referrer_policy = net::ReferrerPolicy::NO_REFERRER;
+    client_->OnReceiveRedirect(clean_redirect, std::move(head));
+  }
+
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        OnUploadProgressCallback callback) override {
+    client_->OnUploadProgress(current_position, total_size,
+                              std::move(callback));
+  }
+
+  void OnTransferSizeUpdated(int32_t diff) override {
+    client_->OnTransferSizeUpdated(diff);
+  }
+
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    Finish(status);
+  }
+
+ private:
+  ~PrivateRequest() override = default;
+  void OnDisconnect() { delete this; }
+  void OnUpstreamDisconnect() {
+    Finish(network::URLLoaderCompletionStatus(net::ERR_ABORTED));
+  }
+  void Finish(const network::URLLoaderCompletionStatus& status) {
+    client_->OnComplete(status);
+    delete this;
+  }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  mojo::Receiver<network::mojom::URLLoaderClient> upstream_client_;
+  mojo::Remote<network::mojom::URLLoader> upstream_loader_;
+  base::WeakPtr<Profile> profile_;
+  std::optional<url::Origin> top_origin_;
+  const bool main_frame_;
+  GURL current_url_;
+};
+
+class PrivateFactory : public network::SelfDeletingURLLoaderFactory {
+ public:
+  PrivateFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> upstream,
+      base::WeakPtr<Profile> profile,
+      const net::IsolationInfo& isolation,
+      base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key),
+        upstream_(std::move(upstream)),
+        profile_(std::move(profile)),
+        top_origin_(isolation.top_frame_origin()),
+        main_frame_(isolation.request_type() ==
+                    net::IsolationInfo::RequestType::kMainFrame) {
+    upstream_.set_disconnect_handler(
+        base::BindOnce(&PrivateFactory::OnDisconnect, base::Unretained(this)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    auto* proxy = base::MakeSelfDeleting<PrivateRequest>(
+        std::move(receiver), std::move(client), profile_, top_origin_,
+        main_frame_);
+    proxy->Start(upstream_.get(), request_id, options, request, annotation);
+  }
+
+ private:
+  ~PrivateFactory() override = default;
+  void OnDisconnect() { DisconnectReceiversAndDestroy(); }
+
+  mojo::Remote<network::mojom::URLLoaderFactory> upstream_;
+  base::WeakPtr<Profile> profile_;
+  const std::optional<url::Origin> top_origin_;
+  const bool main_frame_;
+};
+
+GURL SiteFor(ardia::Call& call) {
+  const GURL site(call.String("origin"));
+  if (!site.is_valid() || !site.SchemeIsHTTPOrHTTPS() || site.has_username() ||
+      site.has_password() || url::Origin::Create(site).GetURL() != site) {
+    return GURL();
+  }
+  return site;
+}
+
+}  // namespace
+
+void InstallPrivateWebSocketPolicy() {
+  content::SetWebSocketHandshakePolicy(base::BindRepeating(
+      [](content::BrowserContext* context, const GURL& url,
+         const std::optional<url::Origin>& top_origin) -> int {
+        if (!PrivateRequestProtectionEnabled(context)) {
+          return net::OK;
+        }
+        return PolicyError(Profile::FromBrowserContext(context), url, top_origin);
+      }));
+}
+
+bool PrivateTrackerRulesReady(Profile* profile) {
+  return profile && !profile->ShutdownStarted() &&
+         !profile->GetOriginalProfile()->ShutdownStarted() &&
+         !RulesFor(profile).domains.empty();
+}
+
+bool PrivateRequestProtectionEnabled(content::BrowserContext* context) {
+  return g_private_profile_policies_enabled && context &&
+         context->IsOffTheRecord();
+}
+
+base::DictValue PrivateTrackerStatus(Profile* profile) {
+  const auto& rules = RulesFor(profile);
+  const bool private_profile = profile->IsOffTheRecord();
+  return base::DictValue()
+      .Set("trackerProtectionEnabled",
+           private_profile && !rules.domains.empty())
+      .Set("trackerRulesRevision", rules.revision)
+      .Set("trackerDomainCount", static_cast<int>(rules.domains.size()))
+      .Set("blockedTrackerRequests",
+           private_profile
+               ? ardia::StateFor<PrivateTrackerState>(profile).blocked_requests
+               : 0);
+}
+
+bool ShouldBlockPrivateTracker(content::BrowserContext* context,
+                               const GURL& url,
+                               const std::optional<url::Origin>& top_origin) {
+  if (!PrivateRequestProtectionEnabled(context)) {
+    return false;
+  }
+  return PolicyError(Profile::FromBrowserContext(context), url, top_origin) !=
+         net::OK;
+}
+
+void MaybeProxyPrivateRequests(content::BrowserContext* context,
+                               const net::IsolationInfo& isolation,
+                               network::URLLoaderFactoryBuilder& builder) {
+  if (!PrivateRequestProtectionEnabled(context)) {
+    return;
+  }
+  auto [receiver, remote] = builder.Append();
+  base::MakeSelfDeleting<PrivateFactory>(
+      std::move(receiver), std::move(remote),
+      Profile::FromBrowserContext(context)->GetWeakPtr(), isolation);
+}
+
+}  // namespace ardiacore
+
+AC_ENGINE_CALL(ac_private_tracker_rules_set) {
+  if (args_json && std::strlen(args_json) > 4 * 1024 * 1024) {
+    return ardia::Reply(reply, context)
+        .Error("tracker rules exceed the size limit");
+  }
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kRefuse, true);
+  if (!call) {
+    return;
+  }
+  const auto* domains = call.args().FindList("domains");
+  const std::string revision = call.String("revision");
+  if (call.args().FindInt("schema") != 1 || revision.empty() ||
+      revision.size() > 128 || !domains || domains->empty() ||
+      domains->size() > 100000) {
+    return call.TakeReply().Error(
+        "invalid tracker ruleset schema, revision, or domain count");
+  }
+  std::set<std::string, std::less<>> validated;
+  for (const auto& entry : *domains) {
+    const std::string* domain = entry.GetIfString();
+    if (!domain || !ardiacore::ValidDomain(*domain)) {
+      return call.TakeReply().Error(
+          "tracker rules must contain canonical DNS names");
+    }
+    validated.insert(*domain);
+  }
+  auto& rules = ardiacore::RulesFor(call.profile());
+  if (rules.revision == revision && rules.domains != validated) {
+    return call.TakeReply().Error(
+        "tracker rules revision already names different content");
+  }
+  rules.domains = std::move(validated);
+  rules.revision = revision;
+  call.TakeReply().Send(
+      base::DictValue()
+          .Set("revision", rules.revision)
+          .Set("domainCount", static_cast<int>(rules.domains.size())));
+}
+
+AC_ENGINE_CALL(ac_private_tracker_site_set) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kAllow, true);
+  if (!call) {
+    return;
+  }
+  const auto allow = call.args().FindBool("allow");
+  const GURL site = ardiacore::SiteFor(call);
+  if (!call.profile()->IsOffTheRecord() || !allow || !site.is_valid()) {
+    return call.TakeReply().Error("private tracker allowance requires an OTR "
+                                  "profile, exact origin, and boolean allow");
+  }
+  const std::string origin = url::Origin::Create(site).Serialize();
+  auto& state = ardia::StateFor<ardiacore::PrivateTrackerState>(call.profile());
+  if (*allow) {
+    state.allowed_origins.insert(origin);
+  } else {
+    state.allowed_origins.erase(origin);
+  }
+  call.TakeReply().Send(
+      base::DictValue().Set("origin", origin).Set("trackersAllowed", *allow));
+}
+
+AC_ENGINE_CALL(ac_private_tracker_site_get) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kAllow, true);
+  if (!call) {
+    return;
+  }
+  const GURL site = ardiacore::SiteFor(call);
+  if (!call.profile()->IsOffTheRecord() || !site.is_valid()) {
+    return call.TakeReply().Error(
+        "private tracker setting requires an OTR profile and exact origin");
+  }
+  const std::string origin = url::Origin::Create(site).Serialize();
+  const auto& state =
+      ardia::StateFor<ardiacore::PrivateTrackerState>(call.profile());
+  call.TakeReply().Send(
+      base::DictValue()
+          .Set("origin", origin)
+          .Set("trackersAllowed", state.allowed_origins.contains(origin)));
+}
