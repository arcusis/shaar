+TEST_F(ContentSettingsPrefProviderTest, PrivateCookieDefaultIsTransient) {
+  const auto wildcard = ContentSettingsPattern::Wildcard();
+  const GURL allowed_site("https://allowed.example");
+  const GURL other_site("https://other.example");
+  const auto allowed_pattern = ContentSettingsPattern::FromURL(allowed_site);
+  const auto cookies = ContentSettingsType::COOKIES;
+  const ContentSettingConstraints constraints;
+  auto value_for = [&](PrefProvider& provider, const GURL& site, bool otr) {
+    auto rule = provider.GetRule(site, site, cookies, otr);
+    return rule ? rule->value.Clone() : base::Value();
+  };
+
+  EXPECT_TRUE(provider_->SetWebsiteSetting(allowed_pattern, wildcard, cookies,
+                                           base::Value(CONTENT_SETTING_ALLOW),
+                                           constraints));
+  EXPECT_FALSE(provider_->SetWebsiteSetting(wildcard, wildcard, cookies,
+                                            base::Value(CONTENT_SETTING_BLOCK),
+                                            constraints));
+  {
+    PrefProvider otr(&prefs_, true, true, false);
+    EXPECT_TRUE(otr.SetWebsiteSetting(wildcard, wildcard, cookies,
+                                      base::Value(CONTENT_SETTING_BLOCK),
+                                      constraints));
+    EXPECT_EQ(base::Value(CONTENT_SETTING_BLOCK),
+              value_for(otr, allowed_site, true));
+    EXPECT_EQ(base::Value(CONTENT_SETTING_BLOCK),
+              value_for(otr, other_site, true));
+    EXPECT_EQ(base::Value(CONTENT_SETTING_ALLOW),
+              value_for(*provider_, allowed_site, false));
+    EXPECT_TRUE(otr.SetWebsiteSetting(allowed_pattern, wildcard, cookies,
+                                      base::Value(CONTENT_SETTING_ALLOW),
+                                      constraints));
+    EXPECT_EQ(base::Value(CONTENT_SETTING_ALLOW),
+              value_for(otr, allowed_site, true));
+    EXPECT_EQ(base::Value(CONTENT_SETTING_BLOCK),
+              value_for(otr, other_site, true));
+    otr.ShutdownOnUIThread();
+  }
+  // Recreating OTR state must not restore either its default or its allowance.
+  PrefProvider recreated(&prefs_, true, true, false);
+  EXPECT_TRUE(value_for(recreated, allowed_site, true).is_none());
+  EXPECT_TRUE(value_for(recreated, other_site, true).is_none());
+  EXPECT_EQ(base::Value(CONTENT_SETTING_ALLOW),
+            value_for(*provider_, allowed_site, false));
+  recreated.ShutdownOnUIThread();
+}
+
+TEST_F(ContentSettingsPrefProviderTest, PrivateDefaultsRemainCookieOnly) {
+  const auto wildcard = ContentSettingsPattern::Wildcard();
+  PrefProvider otr(&prefs_, true, true, false);
+  EXPECT_FALSE(otr.SetWebsiteSetting(
+      wildcard, wildcard, ContentSettingsType::JAVASCRIPT,
+      base::Value(CONTENT_SETTING_BLOCK), ContentSettingConstraints()));
+  otr.ShutdownOnUIThread();
+}
 
