index 2319db76..45db5835 100644
--- a/chrome/browser/ardia/ac_downloads.cc
+++ b/chrome/browser/ardia/ac_downloads.cc
@@ -12,6 +12,7 @@
 #include <vector>
 
 #include "base/files/file_path.h"
+#include "base/files/file_util.h"
 #include "base/functional/bind.h"
 #include "base/json/values_util.h"
 #include "base/memory/raw_ptr.h"
@@ -20,6 +21,7 @@
 #include "base/task/sequenced_task_runner.h"
 #include "base/time/time.h"
 #include "chrome/browser/download/download_crx_util.h"
+#include "chrome/browser/download/download_prefs.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/profiles/profile_observer.h"
 #include "chrome/common/pref_names.h"
@@ -395,3 +397,136 @@ AC_ENGINE_CALL(ac_downloads_remove) {
     call.TakeReply().Ok();
   }
 }
+
+namespace {
+
+void DirectoryError(ardia::Call& call,
+                    std::string_view code,
+                    std::string_view message) {
+  call.TakeReply().Error(code, message);
+}
+
+bool ValidDownloadDirectory(const base::FilePath& path) {
+  return !path.empty() && path.IsAbsolute() && !path.ReferencesParent() &&
+         base::DirectoryExists(path) && base::PathIsWritable(path);
+}
+
+DownloadPrefs* DownloadPrefsFor(ardia::Call& call) {
+  Profile* profile = call.profile();
+  if (!profile || profile->IsOffTheRecord() || profile->ShutdownStarted()) {
+    DirectoryError(call, "profile_unavailable",
+                   "normal profile is not available");
+    return nullptr;
+  }
+  DownloadPrefs* download_prefs =
+      DownloadPrefs::FromBrowserContext(profile);
+  if (!download_prefs) {
+    DirectoryError(call, "download_preferences_unavailable",
+                   "download preferences are not available");
+    return nullptr;
+  }
+  if (download_prefs->IsDownloadPathManaged()) {
+    DirectoryError(call, "policy_managed",
+                   "download directory is controlled by policy");
+    return nullptr;
+  }
+  const auto* preference = profile->GetPrefs()->FindPreference(
+      prefs::kDownloadDefaultDirectory);
+  if (!preference || !preference->IsUserModifiable()) {
+    DirectoryError(call, "preference_controlled",
+                   "download directory cannot be changed by this profile");
+    return nullptr;
+  }
+  return download_prefs;
+}
+
+}  // namespace
+
+AC_ENGINE_CALL(ac_downloads_directory_get) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kRefuse, true);
+  if (!call) {
+    return;
+  }
+  DownloadPrefs* download_prefs = DownloadPrefsFor(call);
+  if (!download_prefs) {
+    return;
+  }
+  const base::FilePath effective = download_prefs->DownloadPath();
+  const base::FilePath stored =
+      call.profile()->GetPrefs()->GetFilePath(prefs::kDownloadDefaultDirectory);
+  if (effective != stored || !ValidDownloadDirectory(effective)) {
+    DirectoryError(call, "directory_unavailable",
+                   "effective download directory is not a usable directory");
+    return;
+  }
+  call.TakeReply().Send(
+      base::DictValue().Set("ok", true).Set("directory", effective.value()));
+}
+
+AC_ENGINE_CALL(ac_downloads_directory_set) {
+  ardia::Call call(profile_dir, args_json, reply, context,
+                   ardia::OffTheRecord::kRefuse, true);
+  if (!call) {
+    return;
+  }
+  DownloadPrefs* download_prefs = DownloadPrefsFor(call);
+  if (!download_prefs) {
+    return;
+  }
+  const std::string requested = call.String("directory");
+  if (requested.empty() || requested.find('\0') != std::string::npos) {
+    DirectoryError(call, "invalid_directory",
+                   "directory must be a nonempty absolute path");
+    return;
+  }
+  const base::FilePath directory(requested);
+  if (!directory.IsAbsolute() || directory.ReferencesParent()) {
+    DirectoryError(call, "invalid_directory",
+                   "directory must be a normalized absolute path");
+    return;
+  }
+  if (!ValidDownloadDirectory(directory)) {
+    DirectoryError(call, "directory_unavailable",
+                   "directory must exist and be writable");
+    return;
+  }
+
+  PrefService* prefs = call.profile()->GetPrefs();
+  const PrefService::Preference* preference =
+      prefs->FindPreference(prefs::kDownloadDefaultDirectory);
+  const bool had_user_setting = preference->HasUserSetting();
+  const PrefService::Preference* save_preference =
+      prefs->FindPreference(prefs::kSaveFileDefaultDirectory);
+  if (!save_preference) {
+    DirectoryError(call, "download_preferences_unavailable",
+                   "save directory preference is not available");
+    return;
+  }
+  const bool had_user_save_setting = save_preference->HasUserSetting();
+  const base::Value previous_download = preference->GetValue()->Clone();
+  const base::Value previous_save = save_preference->GetValue()->Clone();
+  download_prefs->SetDownloadPath(directory);
+  const base::FilePath effective = download_prefs->DownloadPath();
+  const base::FilePath stored =
+      prefs->GetFilePath(prefs::kDownloadDefaultDirectory);
+  if (effective != directory || stored != directory ||
+      !ValidDownloadDirectory(effective)) {
+    if (had_user_setting) {
+      prefs->Set(prefs::kDownloadDefaultDirectory, previous_download);
+    } else {
+      prefs->ClearPref(prefs::kDownloadDefaultDirectory);
+    }
+    if (had_user_save_setting) {
+      prefs->Set(prefs::kSaveFileDefaultDirectory, previous_save);
+    } else {
+      prefs->ClearPref(prefs::kSaveFileDefaultDirectory);
+    }
+    DirectoryError(call, "directory_rejected",
+                   "Chromium did not retain requested download directory");
+    return;
+  }
+  call.TakeReply().Send(
+      base::DictValue().Set("ok", true).Set("directory", effective.value()));
+}
+
