+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+// A name-aware fake verifies that an existing profile keeps the exact secret
+// which encrypted its cookies and passwords. It never accesses macOS Keychain.
+class NamedPasswordKeychain : public FakeKeychainV2 {
+ public:
+  NamedPasswordKeychain() : FakeKeychainV2("test") {}
+
+  void Seed(std::string_view service,
+            std::string_view account,
+            std::string_view secret) {
+    passwords_[{std::string(service), std::string(account)}] =
+        std::vector<uint8_t>(secret.begin(), secret.end());
+  }
+
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service, std::string_view account) override {
+    if (service == "Ardia Safe Storage") {
+      ++legacy_reads_;
+      if (legacy_error_ != noErr) {
+        return base::unexpected(legacy_error_);
+      }
+    }
+    auto found = passwords_.find({std::string(service), std::string(account)});
+    if (found == passwords_.end()) {
+      return base::unexpected(errSecItemNotFound);
+    }
+    return found->second;
+  }
+
+  OSStatus AddGenericPassword(std::string_view service,
+                              std::string_view account,
+                              base::span<const uint8_t> secret) override {
+    if (add_error_ != noErr) {
+      return add_error_;
+    }
+    bool inserted = passwords_
+                        .emplace(std::make_pair(std::string(service),
+                                                std::string(account)),
+                                 std::vector<uint8_t>(secret.begin(),
+                                                      secret.end()))
+                        .second;
+    return inserted ? noErr : errSecDuplicateItem;
+  }
+
+  bool Has(std::string_view service, std::string_view account) const {
+    return passwords_.contains({std::string(service), std::string(account)});
+  }
+
+  int legacy_reads() const { return legacy_reads_; }
+  void set_legacy_error(OSStatus error) { legacy_error_ = error; }
+  void set_add_error(OSStatus error) { add_error_ = error; }
+
+ private:
+  std::map<std::pair<std::string, std::string>, std::vector<uint8_t>>
+      passwords_;
+  int legacy_reads_ = 0;
+  OSStatus legacy_error_ = noErr;
+  OSStatus add_error_ = noErr;
+};
+
+TEST(KeychainPasswordTest, ShaarFreshInstallCreatesOnlyShaarItem) {
+  NamedPasswordKeychain keychain;
+  KeychainPassword password(keychain);
+  EXPECT_EQ(24U, password.GetPassword().length());
+  EXPECT_TRUE(keychain.Has("Shaar Safe Storage", "Shaar"));
+  EXPECT_FALSE(keychain.Has("Ardia Safe Storage", "Ardia"));
+}
+
+TEST(KeychainPasswordTest, ShaarMigratesExistingArdiaSecretOnlyOnce) {
+  NamedPasswordKeychain keychain;
+  keychain.Seed("Ardia Safe Storage", "Ardia", "existing-secret");
+  KeychainPassword password(keychain);
+  EXPECT_EQ("existing-secret", password.GetPassword());
+  EXPECT_EQ("existing-secret", password.GetPassword());
+  EXPECT_EQ(1, keychain.legacy_reads());
+  EXPECT_TRUE(keychain.Has("Shaar Safe Storage", "Shaar"));
+  EXPECT_TRUE(keychain.Has("Ardia Safe Storage", "Ardia"));
+}
+
+TEST(KeychainPasswordTest, ShaarPrefersExistingNewItem) {
+  NamedPasswordKeychain keychain;
+  keychain.Seed("Ardia Safe Storage", "Ardia", "old-secret");
+  keychain.Seed("Shaar Safe Storage", "Shaar", "new-secret");
+  KeychainPassword password(keychain);
+  EXPECT_EQ("new-secret", password.GetPassword());
+  EXPECT_EQ(0, keychain.legacy_reads());
+}
+
+TEST(KeychainPasswordTest, ShaarDoesNotReplaceUnreadableLegacySecret) {
+  NamedPasswordKeychain keychain;
+  keychain.set_legacy_error(errSecAuthFailed);
+  KeychainPassword password(keychain);
+  EXPECT_TRUE(password.GetPassword().empty());
+  EXPECT_FALSE(keychain.Has("Shaar Safe Storage", "Shaar"));
+}
+
+TEST(KeychainPasswordTest, ShaarKeepsLegacySecretIfCopyFails) {
+  NamedPasswordKeychain keychain;
+  keychain.Seed("Ardia Safe Storage", "Ardia", "existing-secret");
+  keychain.set_add_error(errSecAuthFailed);
+  KeychainPassword password(keychain);
+  EXPECT_TRUE(password.GetPassword().empty());
+  EXPECT_TRUE(keychain.Has("Ardia Safe Storage", "Ardia"));
+  EXPECT_FALSE(keychain.Has("Shaar Safe Storage", "Shaar"));
+}
+#endif  // !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+
 }  // namespace
