@@ -0,0 +1,134 @@
+use std::fmt;
+
+use serde::{Deserialize, Serialize};
+use serde_repr::{Deserialize_repr, Serialize_repr};
+
+use crate::api::enums::TwoFactorProvider as ApiTwoFactorProvider;
+
+/// Two-factor providers supported by password login.
+#[derive(Serialize_repr, Deserialize_repr, Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+#[cfg_attr(feature = "uniffi", derive(uniffi::Enum))]
+#[bitwarden_ffi::wasm_record]
+pub enum TwoFactorProvider {
+    /// Time-based authenticator application.
+    Authenticator = 0,
+    /// Email verification code.
+    Email = 1,
+    /// Duo verification.
+    Duo = 2,
+    /// YubiKey verification.
+    Yubikey = 3,
+    /// Deprecated U2F verification.
+    U2f = 4,
+    /// Previously remembered device.
+    Remember = 5,
+    /// Organization-managed Duo verification.
+    OrganizationDuo = 6,
+    /// WebAuthn verification.
+    WebAuthn = 7,
+}
+
+impl From<TwoFactorProvider> for ApiTwoFactorProvider {
+    fn from(provider: TwoFactorProvider) -> Self {
+        match provider {
+            TwoFactorProvider::Authenticator => Self::Authenticator,
+            TwoFactorProvider::Email => Self::Email,
+            TwoFactorProvider::Duo => Self::Duo,
+            TwoFactorProvider::Yubikey => Self::Yubikey,
+            TwoFactorProvider::U2f => Self::U2f,
+            TwoFactorProvider::Remember => Self::Remember,
+            TwoFactorProvider::OrganizationDuo => Self::OrganizationDuo,
+            TwoFactorProvider::WebAuthn => Self::WebAuthn,
+        }
+    }
+}
+
+/// Two-factor response supplied when retrying password login after a challenge.
+#[derive(Serialize, Deserialize, Clone, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[cfg_attr(feature = "uniffi", derive(uniffi::Record))]
+#[bitwarden_ffi::wasm_record]
+pub struct TwoFactorRequest {
+    /// Provider-specific verification response.
+    pub token: String,
+    /// Provider that produced the verification response.
+    pub provider: TwoFactorProvider,
+    /// Ask the server to remember this device when supported.
+    pub remember: bool,
+}
+
+impl fmt::Debug for TwoFactorRequest {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("TwoFactorRequest")
+            .field("token", &"[REDACTED]")
+            .field("provider", &self.provider)
+            .field("remember", &self.remember)
+            .finish()
+    }
+}
+
+/// Available two-factor methods returned by the Identity API.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[cfg_attr(feature = "uniffi", derive(uniffi::Record))]
+#[bitwarden_ffi::wasm_record]
+pub struct TwoFactorChallenge {
+    /// Recognized providers offered by the server.
+    pub providers: Vec<TwoFactorProvider>,
+    /// Provider identifiers not recognized by this SDK version.
+    pub unknown_provider_ids: Vec<String>,
+}
+
+impl TwoFactorChallenge {
+    pub(crate) fn from_provider_ids(provider_ids: impl IntoIterator<Item = String>) -> Self {
+        let mut providers = Vec::new();
+        let mut unknown_provider_ids = Vec::new();
+
+        for provider_id in provider_ids {
+            let provider = match provider_id.as_str() {
+                "0" => Some(TwoFactorProvider::Authenticator),
+                "1" => Some(TwoFactorProvider::Email),
+                "2" => Some(TwoFactorProvider::Duo),
+                "3" => Some(TwoFactorProvider::Yubikey),
+                "4" => Some(TwoFactorProvider::U2f),
+                "5" => Some(TwoFactorProvider::Remember),
+                "6" => Some(TwoFactorProvider::OrganizationDuo),
+                "7" => Some(TwoFactorProvider::WebAuthn),
+                _ => None,
+            };
+
+            if let Some(provider) = provider {
+                providers.push(provider);
+            } else {
+                unknown_provider_ids.push(provider_id);
+            }
+        }
+
+        providers.sort_by_key(|provider| *provider as u8);
+        unknown_provider_ids.sort();
+        Self {
+            providers,
+            unknown_provider_ids,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{TwoFactorProvider, TwoFactorRequest};
+
+    #[test]
+    fn mfa_request_debug_redacts_token() {
+        let request = TwoFactorRequest {
+            token: "diagnostic-redaction-sentinel".to_string(),
+            provider: TwoFactorProvider::Authenticator,
+            remember: false,
+        };
+
+        let diagnostic = format!("{request:?}");
+        assert!(!diagnostic.contains(&request.token));
+        assert!(diagnostic.contains("[REDACTED]"));
+    }
+}
