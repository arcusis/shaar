@@ -0,0 +1,69 @@
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Deserializer, de::IgnoredAny};
+
+use crate::login::models::TwoFactorChallenge;
+
+#[derive(Deserialize, Debug, PartialEq, Eq)]
+pub(crate) struct TwoFactorRequiredApiResponse {
+    error: String,
+    #[serde(rename = "error_description", alias = "errorDescription")]
+    error_description: String,
+    #[serde(
+        rename = "twoFactorProviders2",
+        alias = "TwoFactorProviders2",
+        deserialize_with = "deserialize_provider_ids"
+    )]
+    provider_ids: Vec<String>,
+}
+
+impl TwoFactorRequiredApiResponse {
+    pub(crate) fn into_challenge(self) -> Result<TwoFactorChallenge, String> {
+        if self.error != "invalid_grant" || self.error_description != "Two factor required." {
+            return Err("Two-factor challenge response was invalid.".to_string());
+        }
+
+        if self.provider_ids.is_empty() {
+            return Err("Two-factor challenge contained no providers.".to_string());
+        }
+
+        let challenge = TwoFactorChallenge::from_provider_ids(self.provider_ids);
+        if challenge.providers.is_empty() {
+            return Err("Two-factor challenge contained no supported providers.".to_string());
+        }
+
+        Ok(challenge)
+    }
+}
+
+fn deserialize_provider_ids<'de, D>(deserializer: D) -> Result<Vec<String>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum ProviderPayload {
+        Object(BTreeMap<String, IgnoredAny>),
+        Null(Option<()>),
+    }
+
+    let providers: BTreeMap<String, ProviderPayload> = BTreeMap::deserialize(deserializer)?;
+    let mut provider_ids = Vec::with_capacity(providers.len());
+
+    for (provider_id, payload) in providers {
+        match payload {
+            ProviderPayload::Object(fields) => {
+                let _ = fields;
+                provider_ids.push(provider_id);
+            }
+            ProviderPayload::Null(_) if provider_id == "0" => provider_ids.push(provider_id),
+            ProviderPayload::Null(_) => {
+                return Err(serde::de::Error::custom(
+                    "two-factor provider data must be an object",
+                ));
+            }
+        }
+    }
+
+    Ok(provider_ids)
+}
