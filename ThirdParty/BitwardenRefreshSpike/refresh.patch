+#[cfg(test)]
+mod refresh_sync_status_tests {
+    use super::*;
+    #[tokio::test]
+    async fn only_http_401_is_unauthorized() {
+        use std::io::{Read, Write};
+        use std::net::TcpListener;
+        use std::time::Duration;
+
+        for status in [401, 403, 500, 200, 0] {
+            let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+            let addr = listener.local_addr().unwrap();
+            listener.set_nonblocking(true).unwrap();
+            let server = std::thread::spawn(move || {
+                let deadline = std::time::Instant::now() + Duration::from_secs(5);
+                let (mut stream, _) = loop {
+                    match listener.accept() {
+                        Ok(connection) => break connection,
+                        Err(error)
+                            if error.kind() == std::io::ErrorKind::WouldBlock
+                                && std::time::Instant::now() < deadline =>
+                        {
+                            std::thread::sleep(Duration::from_millis(10))
+                        }
+                        Err(error) => panic!("loopback accept failed: {error}"),
+                    }
+                };
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(5)))
+                    .unwrap();
+                let mut request = [0u8; 4096];
+                let count = stream.read(&mut request).unwrap();
+                assert!(
+                    std::str::from_utf8(&request[..count])
+                        .unwrap()
+                        .starts_with("GET /sync")
+                );
+                if status == 0 {
+                    return;
+                }
+                let body = "dummy-secret-not-json";
+                write!(stream, "HTTP/1.1 {status} Test\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
+            });
+            let settings = bitwarden_core::ClientSettings {
+                api_url: format!("http://{addr}"),
+                ..Default::default()
+            };
+            let sdk = SyncCipherSnapshotClient::new(bitwarden_core::Client::new(Some(settings)));
+            let error = sdk.sync(true).await.err().expect("expected sync error");
+            assert_eq!(sync_error_is_unauthorized(&error), status == 401);
+            server.join().unwrap();
+        }
+        assert!(!sync_error_is_unauthorized(
+            &bitwarden_sync::SyncError::AccountDeleted
+        ));
+    }
+}
