+/// Token renewal result; callers must validate account binding and persist before use.
+#[derive(uniffi::Record)]
+pub struct RefreshResult {
+    pub access_token: String,
+    pub refresh_token: Option<String>,
+    pub expires_in: u64,
+}
+
+/// Redacted renewal failure categories.
+#[derive(Debug, thiserror::Error, uniffi::Error)]
+pub enum RefreshError {
+    #[error("Invalid refresh input")]
+    InvalidInput,
+    #[error("Refresh grant rejected")]
+    Rejected,
+    #[error("Refresh request failed")]
+    RequestFailed,
+    #[error("Invalid refresh response")]
+    InvalidResponse,
+}
+
+fn valid_token(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 16384 && value.bytes().all(|b| b.is_ascii_graphic())
+}
+
+fn validated_refresh(
+    access_token: String,
+    refresh_token: Option<String>,
+    expires_in: u64,
+) -> std::result::Result<RefreshResult, RefreshError> {
+    if !valid_token(&access_token) {
+        return Err(RefreshError::InvalidResponse);
+    }
+    let parts: Vec<_> = access_token.split('.').collect();
+    if parts.len() != 3
+        || parts.iter().any(|part| {
+            part.is_empty()
+                || bitwarden_encoding::B64Url::try_from(*part).is_err()
+                || !part
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+        })
+        || !matches!(access_token.parse::<bitwarden_core::auth::JwtToken>(), Ok(claims) if !claims.sub.is_empty() && claims.exp > 0 && claims.exp <= i64::MAX as u64)
+        || refresh_token
+            .as_ref()
+            .is_some_and(|token| !valid_token(token))
+        || expires_in == 0
+        || expires_in > u32::MAX as u64
+    {
+        return Err(RefreshError::InvalidResponse);
+    }
+    Ok(RefreshResult {
+        access_token,
+        refresh_token,
+        expires_in,
+    })
+}
+
+fn map_refresh_error(error: bitwarden_core::auth::login::LoginError) -> RefreshError {
+    match error {
+        bitwarden_core::auth::login::LoginError::IdentityFail(response)
+            if response.error == "invalid_grant" =>
+        {
+            RefreshError::Rejected
+        }
+        bitwarden_core::auth::login::LoginError::InvalidResponse => RefreshError::InvalidResponse,
+        bitwarden_core::auth::login::LoginError::Api(bitwarden_core::ApiError::Response(
+            response,
+        )) if response.status.is_success() => RefreshError::InvalidResponse,
+        _ => RefreshError::RequestFailed,
+    }
+}
