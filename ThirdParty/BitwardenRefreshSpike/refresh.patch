+#[cfg(test)]
+mod refresh_adapter_tests {
+    use super::*;
+    use std::collections::HashMap;
+    use wiremock::{
+        Mock, MockServer, ResponseTemplate,
+        matchers::{method, path},
+    };
+
+    async fn run_response(
+        status: u16,
+        body: &str,
+    ) -> Result<(String, Option<String>, u64), LoginError> {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/connect/token"))
+            .respond_with(ResponseTemplate::new(status).set_body_raw(body, "application/json"))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let settings = crate::ClientSettings {
+            identity_url: server.uri(),
+            ..Default::default()
+        };
+        let client = crate::Client::new(Some(settings));
+        let configs: std::sync::Arc<crate::client::ApiConfigurations> =
+            crate::client::FromClientPart::get_part(&client);
+        let login = UserLoginMethod::Username {
+            client_id: "original/client".into(),
+            email: "dummy@example.test".into(),
+            kdf: bitwarden_crypto::Kdf::default_pbkdf2(),
+        };
+        let result = renew_pm_token_sdk_managed(
+            Some("old+token".into()),
+            &login,
+            configs.identity_config.clone(),
+        )
+        .await;
+        let requests = server.received_requests().await.unwrap();
+        let form: HashMap<String, String> = serde_qs::from_bytes(&requests[0].body).unwrap();
+        assert_eq!(
+            form.get("grant_type").map(String::as_str),
+            Some("refresh_token")
+        );
+        assert_eq!(
+            form.get("client_id").map(String::as_str),
+            Some("original/client")
+        );
+        assert_eq!(
+            form.get("refresh_token").map(String::as_str),
+            Some("old+token")
+        );
+        assert_eq!(form.len(), 3);
+        result
+    }
+
+    #[tokio::test]
+    async fn renewal_form_rotation_and_http_status() {
+        let omitted =
+            r#"{"access_token":"dummy","expires_in":3600,"token_type":"Bearer","scope":"api"}"#;
+        let rotated = r#"{"access_token":"dummy","expires_in":3600,"refresh_token":"new","token_type":"Bearer","scope":"api"}"#;
+        assert_eq!(run_response(200, omitted).await.unwrap().1, None);
+        assert_eq!(
+            run_response(200, rotated).await.unwrap().1.as_deref(),
+            Some("new")
+        );
+        for status in [401, 403, 500] {
+            assert!(
+                matches!(run_response(status, rotated).await, Err(LoginError::Api(crate::ApiError::Response(response))) if response.status.as_u16() == status)
+            );
+        }
+        assert!(matches!(
+            run_response(200, "not-json").await,
+            Err(LoginError::InvalidResponse)
+        ));
+        assert!(matches!(
+            run_response(200, &"x".repeat(128 * 1024 + 1)).await,
+            Err(LoginError::InvalidResponse)
+        ));
+        assert!(run_response(200, r#"{"access_token":"dummy","expires_in":3600,"refresh_token":null,"token_type":"Bearer","scope":"api"}"#).await.is_err());
+    }
+}
