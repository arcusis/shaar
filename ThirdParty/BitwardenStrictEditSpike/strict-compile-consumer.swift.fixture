import Foundation
import ArcusisBitwardenSDK

// This function is typechecked and linked, but is never called by the builder.
func compileStrictSDKInterfaces(
  client: Client,
  cipherId: CipherId,
  preparation: StrictPersonalPreparation
) async -> StrictPersonalWriteOutcome {
  _ = client.strictPreparePersonalLogin(cipherId: cipherId, expectedGeneration: 1)
  _ = preparation.revisionToken()
  return await client.strictPersonalUpdate(
    preparation: preparation, username: nil, password: "synthetic-unused")
}
