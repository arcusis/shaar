+    #[tokio::test]
+    async fn strict_personal_normalizes_only_empty_totp() {
+        let client = Client::init_test_account(test_bitwarden_com_account()).await;
+        let ciphers = client.vault().ciphers();
+        for value in ["", " ", "synthetic-totp"] {
+            let mut view = test_cipher_view();
+            // Notes use the same item key and preserve an encrypted empty
+            // string, unlike LoginView encryption's TOTP normalization.
+            view.notes = Some(value.to_owned());
+            let mut original = ciphers.encrypt(view).await.unwrap().cipher;
+            original.login.as_mut().unwrap().totp = original.notes.clone();
+            let decrypted = ciphers.decrypt(original.clone()).await.unwrap();
+            assert_eq!(decrypted.login.unwrap().totp.as_deref(), Some(value));
+            let request = ciphers
+                .strict_personal_update_request(
+                    original,
+                    Some("test_username".to_owned()),
+                    "synthetic-new-password".to_owned(),
+                )
+                .expect("valid empty or nonempty TOTP must allow a strict update");
+            assert_eq!(request.login.unwrap().totp.is_none(), value.is_empty());
+        }
+    }
 
