+/// Minimal strict preparation from a single SDK-owned published sync snapshot.
+/// This does not establish host acceptance or wire-model completeness.
+#[derive(uniffi::Object)]
+pub struct StrictPersonalPreparation {
+    cipher_id: CipherId,
+    generation: u64,
+    revision_token: String,
+    // Retains the producing SDK sync binding for a future same-client revalidation.
+    #[allow(dead_code)]
+    binding: Arc<crate::sync::SyncClientBinding>,
+}
+
+#[uniffi::export]
+impl StrictPersonalPreparation {
+    /// Selected cipher identity.
+    pub fn cipher_id(&self) -> CipherId {
+        self.cipher_id
+    }
+    /// Published SDK sync generation.
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+    /// Opaque to callers; preserves the Rust chrono timestamp precision.
+    pub fn revision_token(&self) -> String {
+        self.revision_token.clone()
+    }
+}
+
+#[uniffi::export]
+impl Client {
+    /// Prepare only if the unique selected cipher remains in the same generation.
+    pub fn strict_prepare_personal_login(
+        &self,
+        cipher_id: CipherId,
+        expected_generation: u64,
+    ) -> Option<Arc<StrictPersonalPreparation>> {
+        let strict_snapshot = self.1.0.strict_snapshot();
+        let snapshot = strict_snapshot.snapshot();
+        if expected_generation == 0
+            || snapshot.generation != expected_generation
+            || !strict_snapshot.is_proven(cipher_id)
+        {
+            return None;
+        }
+        let mut matches = snapshot.ciphers.iter().filter(|c| c.id == Some(cipher_id));
+        let original = matches.next()?.clone();
+        if matches.next().is_some() {
+            return None;
+        }
+        let revision_token = self
+            .0
+            .vault()
+            .ciphers()
+            .strict_personal_revision(original)?;
+        let current = self.1.0.strict_snapshot();
+        if current.snapshot().generation != expected_generation || !current.is_proven(cipher_id) {
+            return None;
+        }
+        Some(Arc::new(StrictPersonalPreparation {
+            cipher_id,
+            generation: expected_generation,
+            revision_token,
+            binding: Arc::clone(&self.1),
+        }))
+    }
+}
