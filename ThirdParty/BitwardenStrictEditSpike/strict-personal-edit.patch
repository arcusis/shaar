+// The deliberately closed v1 subset requires explicit keys, even when a supported
+// optional value is null. Unknown keys, duplicates, unsupported FIDO and the legacy
+// ignored login.uri disqualify only strict eligibility, never the ordinary typed read.
+fn object<'a>(
+    value: &'a Captured,
+    allowed: &[&str],
+) -> Option<std::collections::HashMap<String, &'a Captured>> {
+    let Captured::Object(map) = value else {
+        return None;
+    };
+    let mut out = std::collections::HashMap::new();
+    for (key, value) in &map.0 {
+        let mut normalized = key.to_ascii_lowercase();
+        if normalized == "r#type" {
+            normalized = "type".to_owned();
+        }
+        if normalized == "r#match" {
+            normalized = "match".to_owned();
+        }
+        let canonical = match normalized.as_str() {
+            "organizationid" => "organizationId",
+            "partialdata" => "partialData",
+            "securenote" => "secureNote",
+            "sshkey" => "sshKey",
+            "bankaccount" => "bankAccount",
+            "driverslicense" => "driversLicense",
+            "passwordhistory" => "passwordHistory",
+            "organizationusetotp" => "organizationUseTotp",
+            "revisiondate" => "revisionDate",
+            "creationdate" => "creationDate",
+            "deleteddate" => "deletedDate",
+            "folderid" => "folderId",
+            "viewpassword" => "viewPassword",
+            "archiveddate" => "archivedDate",
+            "collectionids" => "collectionIds",
+            "passwordrevisiondate" => "passwordRevisionDate",
+            "autofillonpageload" => "autofillOnPageLoad",
+            "fido2credentials" => "fido2Credentials",
+            "urichecksum" => "uriChecksum",
+            "linkedid" => "linkedId",
+            "lastuseddate" => "lastUsedDate",
+            "filename" => "fileName",
+            "sizename" => "sizeName",
+            _ => normalized.as_str(),
+        };
+        let mut pascal = canonical.to_owned();
+        if let Some(first) = pascal.get_mut(0..1) {
+            first.make_ascii_uppercase();
+        }
+        let exact_name = match canonical {
+            "type" => key == "type" || key == "R#type",
+            "match" => key == "match" || key == "R#match",
+            _ => key == canonical || *key == pascal,
+        };
+        if !exact_name
+            || !allowed.contains(&normalized.as_str())
+            || out.insert(normalized, value).is_some()
+        {
+            return None;
+        }
+    }
+    if allowed.iter().any(|key| !out.contains_key(*key)) {
+        return None;
+    }
+    Some(out)
+}
+fn nonnull(value: &Captured) -> bool {
+    !matches!(value, Captured::Null)
+}
+fn null(value: &Captured) -> bool {
+    matches!(value, Captured::Null)
+}
+fn array_or_null(value: &Captured, keys: &[&str], required_nonnull: &[&str]) -> bool {
+    match value {
+        Captured::Null => true,
+        Captured::Array(items) => items.iter().all(|item| {
+            object(item, keys).is_some_and(|m| required_nonnull.iter().all(|k| nonnull(m[*k])))
+        }),
+        _ => false,
+    }
+}
+fn unique_attachment_ids(value: &Captured) -> bool {
+    let Captured::Array(attachments) = value else {
+        return null(value);
+    };
+    let mut seen = std::collections::HashSet::new();
+    attachments.iter().all(|attachment| {
+        let Some(fields) = object(
+            attachment,
+            &["object", "id", "url", "filename", "key", "size", "sizename"],
+        ) else {
+            return false;
+        };
+        let Captured::String(id) = fields["id"] else {
+            return false;
+        };
+        !id.is_empty() && seen.insert(id.as_str())
+    })
+}
+
+fn revision_fits_chrono(value: &Captured) -> bool {
+    let Captured::String(value) = value else {
+        return false;
+    };
+    let Some((_, time)) = value.split_once('T') else {
+        return false;
+    };
+    match time.split_once('.') {
+        None => true,
+        Some((_, fraction)) => {
+            let digits = fraction.bytes().take_while(u8::is_ascii_digit).count();
+            (1..=9).contains(&digits)
+        }
+    }
+}
+fn eligible(cipher: &Captured) -> Option<uuid::Uuid> {
+    let keys = [
+        "object",
+        "id",
+        "organizationid",
+        "type",
+        "data",
+        "partialdata",
+        "name",
+        "notes",
+        "login",
+        "card",
+        "identity",
+        "securenote",
+        "sshkey",
+        "bankaccount",
+        "driverslicense",
+        "passport",
+        "fields",
+        "passwordhistory",
+        "attachments",
+        "organizationusetotp",
+        "revisiondate",
+        "creationdate",
+        "deleteddate",
+        "reprompt",
+        "key",
+        "folderid",
+        "favorite",
+        "edit",
+        "viewpassword",
+        "archiveddate",
+        "permissions",
+        "collectionids",
+    ];
+    let m = object(cipher, &keys)?;
+    if [
+        "id",
+        "type",
+        "name",
+        "login",
+        "revisiondate",
+        "creationdate",
+        "reprompt",
+        "favorite",
+        "edit",
+        "viewpassword",
+        "organizationusetotp",
+    ]
+    .iter()
+    .any(|k| !nonnull(m[*k]))
+    {
+        return None;
+    }
+    if [
+        "organizationid",
+        "data",
+        "partialdata",
+        "card",
+        "identity",
+        "securenote",
+        "sshkey",
+        "bankaccount",
+        "driverslicense",
+        "passport",
+        "deleteddate",
+        "archiveddate",
+        "permissions",
+    ]
+    .iter()
+    .any(|k| !null(m[*k]))
+    {
+        return None;
+    }
+    if !matches!(m["collectionids"], Captured::Array(v) if v.is_empty()) {
+        return None;
+    }
+    if !revision_fits_chrono(m["revisiondate"]) || !revision_fits_chrono(m["creationdate"]) {
+        return None;
+    }
+    let login = object(
+        m["login"],
+        &[
+            "uri",
+            "uris",
+            "username",
+            "password",
+            "passwordrevisiondate",
+            "totp",
+            "autofillonpageload",
+            "fido2credentials",
+        ],
+    )?;
+    if !null(login["passwordrevisiondate"]) && !revision_fits_chrono(login["passwordrevisiondate"])
+    {
+        return None;
+    }
+    if !null(login["uri"])
+        || !(null(login["fido2credentials"])
+            || matches!(login["fido2credentials"], Captured::Array(v) if v.is_empty()))
+    {
+        return None;
+    }
+    if !array_or_null(
+        login["uris"],
+        &["uri", "urichecksum", "match"],
+        &["uri", "urichecksum"],
+    ) || !array_or_null(
+        m["fields"],
+        &["type", "name", "value", "linkedid"],
+        &["type"],
+    ) || !array_or_null(
+        m["passwordhistory"],
+        &["password", "lastuseddate"],
+        &["password", "lastuseddate"],
+    ) || !array_or_null(
+        m["attachments"],
+        &["object", "id", "url", "filename", "key", "size", "sizename"],
+        &["id"],
+    ) {
+        return None;
+    }
+    if !unique_attachment_ids(m["attachments"]) {
+        return None;
+    }
+    if let Captured::Array(history) = m["passwordhistory"] {
+        if history.iter().any(|entry| {
+            object(entry, &["password", "lastuseddate"])
+                .is_none_or(|fields| !revision_fits_chrono(fields["lastuseddate"]))
+        }) {
+            return None;
+        }
+    }
+    let Captured::String(id) = m["id"] else {
+        return None;
+    };
+    let id: uuid::Uuid = id.parse().ok()?;
+    (!id.is_nil()).then_some(id)
+}
+struct StrictSyncWireResponse(StrictSyncResponse);
+impl<'de> serde::Deserialize<'de> for StrictSyncWireResponse {
+    fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        let raw = Captured::deserialize(d)?;
+        let json = serde_json::to_string(&raw).map_err(serde::de::Error::custom)?;
+        let response = serde_json::from_str(&json).map_err(serde::de::Error::custom)?;
+        let mut ids = std::collections::HashSet::new();
+        let mut duplicates = std::collections::HashSet::new();
+        if let Captured::Object(root) = &raw {
+            for (key, value) in &root.0 {
+                if key.eq_ignore_ascii_case("ciphers") {
+                    if let Captured::Array(ciphers) = value {
+                        for cipher in ciphers {
+                            if let Some(id) = eligible(cipher) {
+                                if !ids.insert(id) {
+                                    duplicates.insert(id);
+                                }
+                            } else if let Captured::Object(fields) = cipher {
+                                for (name, value) in &fields.0 {
+                                    if name.eq_ignore_ascii_case("id") {
+                                        if let Captured::String(value) = value {
+                                            if let Ok(id) = value.parse() {
+                                                duplicates.insert(id);
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        ids.retain(|id| !duplicates.contains(id));
+        Ok(Self(StrictSyncResponse {
+            response,
+            eligible_ids: ids,
+        }))
+    }
+}
