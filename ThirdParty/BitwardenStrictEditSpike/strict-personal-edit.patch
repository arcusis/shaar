+/// A sync response paired with nonsecret eligibility derived during JSON parsing.
+/// Only the SDK parser can create a proven sidecar; host-built responses are unproven.
+pub struct StrictSyncResponse {
+    response: models::SyncResponseModel,
+    eligible_ids: std::collections::HashSet<uuid::Uuid>,
+}
+
+impl StrictSyncResponse {
+    /// Wrap a response without claiming anything about its wire completeness.
+    pub fn unproven(response: models::SyncResponseModel) -> Self {
+        Self {
+            response,
+            eligible_ids: Default::default(),
+        }
+    }
+    /// The unchanged typed SDK response.
+    pub fn response(&self) -> &models::SyncResponseModel {
+        &self.response
+    }
+    /// Whether this ID passed the original envelope schema check.
+    pub fn is_eligible(&self, id: uuid::Uuid) -> bool {
+        self.eligible_ids.contains(&id)
+    }
+}
