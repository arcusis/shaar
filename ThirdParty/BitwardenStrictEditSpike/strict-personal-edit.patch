+#[cfg(test)]
+mod strict_schema_tests {
+    use super::*;
+    const ID: &str = "11111111-1111-4111-8111-111111111111";
+
+    fn cipher() -> serde_json::Value {
+        serde_json::json!({
+            "object":"cipher", "id":ID, "organizationId":null, "type":1, "data":null, "partialData":null,
+            "name":"encrypted", "notes":null, "login":{ "uri":null, "uris":null, "username":null,
+                "password":null, "passwordRevisionDate":null, "totp":null, "autofillOnPageLoad":null, "fido2Credentials":null },
+            "card":null,"identity":null,"secureNote":null,"sshKey":null,"bankAccount":null,
+            "driversLicense":null,"passport":null,"fields":null,"passwordHistory":null,"attachments":null,
+            "organizationUseTotp":false,"revisionDate":"2025-01-01T00:00:00.123456789Z",
+            "creationDate":"2025-01-01T00:00:00Z","deletedDate":null,"reprompt":0,"key":null,
+            "folderId":null,"favorite":false,"edit":true,"viewPassword":true,"archivedDate":null,
+            "permissions":null,"collectionIds":[]
+        })
+    }
+    fn parse(cipher: serde_json::Value) -> StrictSyncResponse {
+        let json = serde_json::json!({"ciphers":[cipher]}).to_string();
+        serde_json::from_str::<StrictSyncWireResponse>(&json)
+            .unwrap()
+            .0
+    }
+    #[test]
+    fn strict_schema_accepts_complete_and_host_constructed_is_unproven() {
+        let proven = parse(cipher());
+        let id = ID.parse().unwrap();
+        assert!(proven.is_eligible(id));
+        let unproven = StrictSyncResponse::unproven(proven.response().clone());
+        assert!(!unproven.is_eligible(id));
+    }
+    #[test]
+    fn strict_schema_rejects_unknown_missing_null_and_unsupported_without_breaking_read() {
+        let id = ID.parse().unwrap();
+        let mut variants = Vec::new();
+        let mut unknown = cipher();
+        unknown["login"]["future"] = serde_json::json!(1);
+        variants.push(unknown);
+        let mut missing = cipher();
+        missing.as_object_mut().unwrap().remove("notes");
+        variants.push(missing);
+        let mut null_edit = cipher();
+        null_edit["edit"] = serde_json::Value::Null;
+        variants.push(null_edit);
+        let mut org = cipher();
+        org["collectionIds"] = serde_json::json!(["aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"]);
+        variants.push(org);
+        let mut excessive_precision = cipher();
+        excessive_precision["revisionDate"] = serde_json::json!("2025-01-01T00:00:00.1234567891Z");
+        variants.push(excessive_precision);
+        let mut excessive_creation = cipher();
+        excessive_creation["creationDate"] = serde_json::json!("2025-01-01T00:00:00.1234567891Z");
+        variants.push(excessive_creation);
+        let mut excessive_password_revision = cipher();
+        excessive_password_revision["login"]["passwordRevisionDate"] =
+            serde_json::json!("2025-01-01T00:00:00.1234567891Z");
+        variants.push(excessive_password_revision);
+        let mut excessive_history_date = cipher();
+        excessive_history_date["passwordHistory"] = serde_json::json!([{
+            "password":"encrypted", "lastUsedDate":"2025-01-01T00:00:00.1234567891Z"
+        }]);
+        variants.push(excessive_history_date);
+        let mut nil_id = cipher();
+        nil_id["id"] = serde_json::json!("00000000-0000-0000-0000-000000000000");
+        assert!(!parse(nil_id).is_eligible(uuid::Uuid::nil()));
+        let mut legacy = cipher();
+        legacy["login"]["uri"] = serde_json::json!("encrypted");
+        variants.push(legacy);
+        let mut bad_alias = cipher();
+        bad_alias["login"]["uris"] =
+            serde_json::json!([{ "uri":"ciphertext", "uriChecksum":"ciphertext", "Match":1 }]);
+        variants.push(bad_alias);
+        for variant in variants {
+            let result = parse(variant);
+            assert!(!result.is_eligible(id));
+            assert_eq!(result.response().ciphers.as_ref().unwrap().len(), 1);
+        }
+    }
+    #[test]
+    fn strict_schema_rejects_duplicate_attachment_ids_without_changing_reads() {
+        let id = ID.parse().unwrap();
+        let attachment = serde_json::json!({
+            "object":"attachment", "id":"attachment-a", "url":null, "fileName":null,
+            "key":null, "size":null, "sizeName":null
+        });
+        let mut duplicate = cipher();
+        duplicate["attachments"] = serde_json::json!([attachment.clone(), attachment.clone()]);
+        let parsed = parse(duplicate);
+        assert!(!parsed.is_eligible(id));
+        assert_eq!(
+            parsed.response().ciphers.as_ref().unwrap()[0]
+                .attachments
+                .as_ref()
+                .unwrap()
+                .len(),
+            2
+        );
+        let mut unique = cipher();
+        let mut second = attachment.clone();
+        second["id"] = serde_json::json!("attachment-b");
+        unique["attachments"] = serde_json::json!([attachment, second]);
+        assert!(parse(unique).is_eligible(id));
+    }
+
+    #[test]
+    fn strict_schema_rejects_duplicate_unknown_and_duplicate_id() {
+        let id = ID.parse().unwrap();
+        let json = serde_json::json!({"ciphers":[cipher()]})
+            .to_string()
+            .replace(
+                "\"username\":null",
+                "\"future\":1,\"future\":2,\"username\":null",
+            );
+        let result = serde_json::from_str::<StrictSyncWireResponse>(&json)
+            .unwrap()
+            .0;
+        assert!(!result.is_eligible(id));
+        let duplicate_known = serde_json::json!({"ciphers":[cipher()]})
+            .to_string()
+            .replace(
+                "\"name\":\"encrypted\"",
+                "\"name\":null,\"name\":\"encrypted\"",
+            );
+        assert!(serde_json::from_str::<models::SyncResponseModel>(&duplicate_known).is_err());
+        assert!(serde_json::from_str::<StrictSyncWireResponse>(&duplicate_known).is_err());
+        let mut second = cipher();
+        second["edit"] = serde_json::Value::Null;
+        let json = serde_json::json!({"ciphers":[cipher(),second]}).to_string();
+        let result = serde_json::from_str::<StrictSyncWireResponse>(&json)
+            .unwrap()
+            .0;
+        assert!(!result.is_eligible(id));
+    }
 }
