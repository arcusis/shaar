+/// SDK-owned strict provenance captured with the published snapshot.
+pub struct StrictSyncSnapshot {
+    snapshot: SyncSnapshot,
+    eligible_ids: std::collections::HashSet<bitwarden_vault::CipherId>,
+}
+impl StrictSyncSnapshot {
+    /// Published ciphertext and generation captured with this sidecar.
+    pub fn snapshot(&self) -> &SyncSnapshot {
+        &self.snapshot
+    }
+    /// Check this sidecar's parser-owned eligibility for the selected ID.
+    pub fn is_proven(&self, id: bitwarden_vault::CipherId) -> bool {
+        self.eligible_ids.contains(&id)
+    }
