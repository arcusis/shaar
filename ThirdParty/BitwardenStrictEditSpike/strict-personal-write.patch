+/// Client-scoped coordination only; parser-owned snapshot proof is still required.
+#[doc(hidden)]
+#[derive(Default)]
+pub struct StrictOperationGate {
+    state: std::sync::Mutex<StrictOperationState>,
+}
+#[derive(Default)]
+struct StrictOperationState {
+    epoch: u64,
+    syncs: usize,
+    write_active: bool,
+    exhausted: bool,
+}
+/// RAII reservation for an SDK snapshot sync.
+#[doc(hidden)]
+pub struct StrictSyncLease {
+    gate: Arc<StrictOperationGate>,
+    epoch: u64,
+}
+/// RAII reservation for a strict write; dropping never restores authority.
+#[doc(hidden)]
+pub struct StrictWriteLease {
+    gate: Arc<StrictOperationGate>,
+}
+impl StrictOperationGate {
+    /// Begin sync before any suspension, invalidating prior certificates.
+    pub fn begin_sync(self: &Arc<Self>) -> Option<StrictSyncLease> {
+        let mut state = self.state.lock().ok()?;
+        if state.exhausted || state.write_active { return None; }
+        let Some(epoch) = state.epoch.checked_add(1) else { state.exhausted = true; return None; };
+        let Some(syncs) = state.syncs.checked_add(1) else { state.exhausted = true; return None; };
+        state.epoch = epoch;
+        state.syncs = syncs;
+        Some(StrictSyncLease { gate: self.clone(), epoch })
+    }
+    /// Current epoch only when no sync or write is in flight.
+    pub fn idle_epoch(&self) -> Option<u64> {
+        let state = self.state.lock().ok()?;
+        if state.exhausted || state.write_active || state.syncs != 0 { None } else { Some(state.epoch) }
+    }
+    /// Atomically reserve a single write and invalidate all sibling certificates.
+    pub fn begin_write(self: &Arc<Self>, expected_epoch: u64) -> Option<StrictWriteLease> {
+        let mut state = self.state.lock().ok()?;
+        if state.exhausted || state.write_active || state.syncs != 0 || state.epoch != expected_epoch { return None; }
+        let Some(epoch) = state.epoch.checked_add(1) else { state.exhausted = true; return None; };
+        state.epoch = epoch;
+        state.write_active = true;
+        Some(StrictWriteLease { gate: self.clone() })
+    }
+}
+impl StrictSyncLease {
+    /// Epoch reserved at sync start.
+    pub fn epoch(&self) -> u64 { self.epoch }
+    /// Only the latest sync may certify, with no conflicting operation active.
+    pub fn can_certify(&self) -> bool {
+        self.gate.state.lock().ok().is_some_and(|state| {
+            !state.exhausted && !state.write_active && state.syncs == 1 && state.epoch == self.epoch
+        })
+    }
+}
+impl Drop for StrictSyncLease {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.gate.state.lock() {
+            match state.syncs.checked_sub(1) {
+                Some(syncs) => state.syncs = syncs,
+                None => state.exhausted = true,
+            }
+        }
+    }
+}
+impl Drop for StrictWriteLease {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.gate.state.lock() {
+            if state.write_active { state.write_active = false; } else { state.exhausted = true; }
+        }
+    }
+}
