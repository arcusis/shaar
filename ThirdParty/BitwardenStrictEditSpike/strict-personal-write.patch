+    #[tokio::test]
+    async fn strict_write_sibling_sync_and_write_invalidate_shared_authority() {
+        let (first, intercept) = fixture("2025-01-01T00:00:00.123456789Z").await;
+        let second = sibling(&first, &intercept);
+        let id = CIPHER_ID.parse().unwrap();
+        assert!(first.sync(true).await.unwrap());
+        let stale = first.strict_prepare_personal_login(id, 1).unwrap();
+        assert!(second.sync(true).await.unwrap());
+        assert_eq!(first.encrypted_snapshot().ciphers.len(), 1);
+        assert!(!first.strict_snapshot().is_proven(id));
+        assert_eq!(first.strict_personal_update(&stale, None, "synthetic-first".into()).await,
+            StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+        let current = Arc::new(second.strict_prepare_personal_login(id, 1).unwrap());
+        intercept.hold_write.store(true, Ordering::SeqCst);
+        let pending = { let second = second.clone(); let current = current.clone(); tokio::spawn(async move {
+            second.strict_personal_update(&current, None, "synthetic-second".into()).await
+        }) };
+        for _ in 0..1000 { if intercept.write_entered.load(Ordering::SeqCst) == 1 { break; } tokio::task::yield_now().await; }
+        assert_eq!(intercept.write_entered.load(Ordering::SeqCst), 1);
+        assert!(first.sync(true).await.is_err());
+        assert!(second.sync(true).await.is_err());
+        assert!(first.strict_prepare_personal_login(id, 1).is_none());
+        assert_eq!(second.strict_personal_update(&current, None, "synthetic-replay".into()).await,
+            StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+        pending.abort(); let _ = pending.await;
+        assert!(!second.strict_snapshot().is_proven(id));
+        intercept.hold_write.store(false, Ordering::SeqCst);
+        assert!(first.sync(true).await.unwrap());
+        let fresh = first.strict_prepare_personal_login(id, 2).unwrap();
+        assert_eq!(first.strict_personal_update(&fresh, None, "synthetic-fresh".into()).await,
+            StrictPersonalWriteOutcome::Unconfirmed);
+        assert!(second.strict_prepare_personal_login(id, 1).is_none());
+        assert_eq!(intercept.writes.lock().unwrap().len(), 2);
+        assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+    }
