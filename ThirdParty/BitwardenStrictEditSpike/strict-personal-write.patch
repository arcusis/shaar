+            assert_eq!(sdk.strict_personal_update(&prep, None, "synthetic-new-pass".into()).await, StrictPersonalWriteOutcome::Unconfirmed);
+            assert_eq!(sdk.strict_personal_update(&prep, None, "synthetic-new-pass".into()).await, StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+            assert_eq!(intercept.writes.lock().unwrap().len(), 1);
+            assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+        }
+    }
+
+    #[tokio::test]
+    async fn strict_write_keyless_legacy_uses_sdk_key_generation() {
+        let (sdk, intercept) = fixture_with_options("2025-01-01T00:00:00.123456789Z", 0, true).await;
+        assert!(sdk.sync(true).await.unwrap());
+        let id = CIPHER_ID.parse().unwrap();
+        let prep = sdk.strict_prepare_personal_login(id, 1).unwrap();
+        assert_eq!(sdk.strict_personal_update(&prep, Some("synthetic-new-user".into()), "synthetic-new-pass".into()).await, StrictPersonalWriteOutcome::Unconfirmed);
+        let body = { let writes = intercept.writes.lock().unwrap(); assert_eq!(writes.len(), 1); writes[0].clone() };
+        assert!(body["key"].as_str().is_some_and(|key| !key.is_empty()));
+        assert_eq!(body["lastKnownRevisionDate"], "2025-01-01T00:00:00.123456789Z");
+        assert!(!body.to_string().contains("synthetic-new-pass"));
+        let sync: Value = serde_json::from_str(&intercept.sync_response.lock().unwrap()).unwrap();
+        let mut response = sync["ciphers"][0].clone();
+        for field in ["name", "notes", "key", "login", "fields", "passwordHistory"] {
+            response[field] = body.get(field).cloned().unwrap_or(Value::Null);
+        }
+        let model: bitwarden_api_api::models::CipherDetailsResponseModel = serde_json::from_value(response).unwrap();
+        let decoded = sdk.client.vault().ciphers().decrypt(bitwarden_vault::Cipher::try_from(model).unwrap()).await.unwrap();
+        assert_eq!(decoded.notes.as_deref(), Some("Synthetic preserved note"));
+        assert_eq!(decoded.login.unwrap().password.as_deref(), Some("synthetic-new-pass"));
+        assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn strict_write_rejects_attachment_with_unproven_server_preservation() {
+        let (sdk, intercept) = fixture("2025-01-01T00:00:00.123456789Z").await;
+        {
+            let mut raw = intercept.sync_response.lock().unwrap();
+            let mut json: Value = serde_json::from_str(&raw).unwrap();
+            json["ciphers"][0]["attachments"] = json!([{"object":"attachment", "id":"attachment-a",
+                "url":null, "fileName":null, "key":null, "size":"7", "sizeName":"7 bytes"}]);
+            *raw = json.to_string();
+        }
+        assert!(sdk.sync(true).await.unwrap());
+        let prep = sdk.strict_prepare_personal_login(CIPHER_ID.parse().unwrap(), 1).unwrap();
+        assert_eq!(sdk.strict_personal_update(&prep, None, "synthetic-new-pass".into()).await, StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+        assert!(intercept.writes.lock().unwrap().is_empty());
+        assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn strict_write_rejects_while_sync_is_pending() {
+        let (sdk, intercept) = fixture("2025-01-01T00:00:00.123456789Z").await;
+        assert!(sdk.sync(true).await.unwrap());
+        let prep = sdk.strict_prepare_personal_login(CIPHER_ID.parse().unwrap(), 1).unwrap();
+        intercept.hold_sync.store(true, Ordering::SeqCst);
+        let pending = { let sdk = sdk.clone(); tokio::spawn(async move { sdk.sync(true).await }) };
+        for _ in 0..1000 { if intercept.sync_entered.load(Ordering::SeqCst) == 2 { break; } tokio::task::yield_now().await; }
+        assert_eq!(intercept.sync_entered.load(Ordering::SeqCst), 2);
+        assert_eq!(sdk.strict_personal_update(&prep, None, "synthetic-new-pass".into()).await, StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+        assert!(intercept.writes.lock().unwrap().is_empty());
+        pending.abort(); let _ = pending.await;
+        assert!(sdk.strict_prepare_personal_login(CIPHER_ID.parse().unwrap(), 1).is_none());
+        assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn strict_write_rejects_sync_overlap_and_revokes_after_cancellation() {
+        let (sdk, intercept) = fixture("2025-01-01T00:00:00.123456790Z").await;
+        assert!(sdk.sync(true).await.unwrap());
+        let id = CIPHER_ID.parse().unwrap();
+        let prep = Arc::new(sdk.strict_prepare_personal_login(id, 1).unwrap());
+        intercept.hold_write.store(true, Ordering::SeqCst);
+        let worker = { let sdk = sdk.clone(); let prep = prep.clone(); tokio::spawn(async move {
+            sdk.strict_personal_update(&prep, None, "synthetic-next-pass".into()).await
+        }) };
+        for _ in 0..1000 { if intercept.write_entered.load(Ordering::SeqCst) > 0 { break; } tokio::task::yield_now().await; }
+        assert_eq!(intercept.write_entered.load(Ordering::SeqCst), 1);
+        assert!(sdk.sync(true).await.is_err());
+        assert_eq!(sdk.strict_personal_update(&prep, None, "another".into()).await, StrictPersonalWriteOutcome::RejectedBeforeDispatch);
+        worker.abort(); let _ = worker.await;
+        assert!(sdk.strict_prepare_personal_login(id, 1).is_none());
+        assert_eq!(intercept.writes.lock().unwrap().len(), 1);
+        assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+    }
+}
