+    async fn fixture_with_options(revision: &str, history_count: usize, keyless: bool) -> (Arc<SyncCipherSnapshotClient>, Arc<Intercept>) {
+        let intercept = Arc::new(Intercept::default());
+        let settings = bitwarden_core::ClientSettings {
+            api_url: "https://strict-write.invalid".into(), identity_url: "https://strict-write.invalid".into(),
+            ..Default::default() };
+        // The production client is genuinely strict-ready; only this cfg(test)
+        // fixture supplies a separate all-intercepting API for sync and PUT.
+        let client = bitwarden_core::ClientBuilder::new_with_native_managed_tokens(Arc::new(SyntheticTokens))
+            .with_settings(settings.clone()).build();
+        let transport = bitwarden_core::Client::builder().with_settings(settings)
+            .with_middleware(vec![intercept.clone()]).build();
+        client.internal.init_user_id(USER_ID.parse().unwrap()).await.unwrap();
+        {
+            let mut ctx = client.internal.get_key_store().context_mut();
+            let key = ctx.make_symmetric_key(SymmetricKeyAlgorithm::Aes256CbcHmac);
+            ctx.persist_symmetric_key(key, SymmetricKeySlotId::User).unwrap();
+        }
+        let mut view = login_view(revision);
+        if keyless {
+            let login = view.login.as_mut().unwrap();
+            login.uris = None;
+            login.totp = None;
+            view.fields = None;
+        }
+        if history_count > 0 {
+            view.password_history = Some((0..history_count).map(|i| bitwarden_vault::PasswordHistoryView {
+                password: format!("synthetic-history-{i}"),
+                last_used_date: "2024-02-01T00:00:00Z".parse().unwrap(),
+            }).collect());
+        }
+        let mut encrypted = client.vault().ciphers().encrypt(view).await.unwrap().cipher;
+        if keyless {
+            let mut ctx = client.internal.get_key_store().context_mut();
+            encrypted.key = None;
+            encrypted.name = Some("Synthetic title".encrypt(&mut ctx, SymmetricKeySlotId::User).unwrap());
+            encrypted.notes = Some("Synthetic preserved note".encrypt(&mut ctx, SymmetricKeySlotId::User).unwrap());
+            let login = encrypted.login.as_mut().unwrap();
+            login.username = Some("synthetic-old-user".encrypt(&mut ctx, SymmetricKeySlotId::User).unwrap());
+            login.password = Some("synthetic-old-pass".encrypt(&mut ctx, SymmetricKeySlotId::User).unwrap());
+        }
+        *intercept.sync_response.lock().unwrap() = json!({"profile":{"organizations":[]},"ciphers":[wire(&encrypted)]}).to_string();
+        let mut sdk = transport.sync();
+        sdk.enable_strict_schema();
+        let state = Arc::new(Mutex::new(SyncSnapshotState::default()));
+        let handler = Arc::new(SyncSnapshotHandler(state.clone()));
+        sdk.register_sync_handler(handler.clone());
+        sdk.register_error_handler(handler);
+        (Arc::new(SyncCipherSnapshotClient {
+            sdk, state, client, strict_test_api: Some(transport.internal.get_api_configurations()),
+        }), intercept)
+    }
+
+    fn sibling(owner: &Arc<SyncCipherSnapshotClient>, intercept: &Arc<Intercept>) -> Arc<SyncCipherSnapshotClient> {
+        let settings = bitwarden_core::ClientSettings {
+            api_url: "https://strict-write.invalid".into(), identity_url: "https://strict-write.invalid".into(),
+            ..Default::default()
+        };
+        let transport = bitwarden_core::Client::builder().with_settings(settings)
+            .with_middleware(vec![intercept.clone()]).build();
+        let mut sdk = transport.sync();
+        sdk.enable_strict_schema();
+        let state = Arc::new(Mutex::new(SyncSnapshotState::default()));
+        let handler = Arc::new(SyncSnapshotHandler(state.clone()));
+        sdk.register_sync_handler(handler.clone());
+        sdk.register_error_handler(handler);
+        Arc::new(SyncCipherSnapshotClient {
+            sdk, state, client: owner.client.clone(),
+            strict_test_api: Some(transport.internal.get_api_configurations()),
+        })
+    }
