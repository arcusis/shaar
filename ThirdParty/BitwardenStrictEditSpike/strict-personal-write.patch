+        sync_response: Mutex<String>,
+        writes: Mutex<Vec<Value>>,
+        hold_write: AtomicBool,
+        hold_sync: AtomicBool,
+        sync_entered: AtomicUsize,
+        write_entered: AtomicUsize,
+        write_status: AtomicU16,
+        write_body: Mutex<String>,
+        unexpected: AtomicUsize,
+    }
+    #[async_trait::async_trait]
+    impl Middleware for Intercept {
+        async fn handle(
+            &self, request: reqwest::Request, _extensions: &mut http::Extensions, _next: Next<'_>,
+        ) -> reqwest_middleware::Result<reqwest::Response> {
+            let url = request.url();
+            let valid_origin = url.scheme() == "https" && url.host_str() == Some("strict-write.invalid")
+                && url.port().is_none() && url.query().is_none() && url.fragment().is_none();
+            if valid_origin && request.method() == reqwest::Method::GET && url.path() == "/sync" {
+                self.sync_entered.fetch_add(1, Ordering::SeqCst);
+                if self.hold_sync.load(Ordering::SeqCst) { return std::future::pending().await; }
+                let response = self.sync_response.lock().unwrap().clone();
+                return Ok(http::Response::builder().status(200).header("content-type", "application/json")
+                    .body(response).unwrap().into());
+            }
+            if valid_origin && request.method() == reqwest::Method::PUT
+                && url.path() == format!("/ciphers/{CIPHER_ID}") {
+                let bytes = request.body().and_then(|b| b.as_bytes()).expect("buffered request");
+                self.writes.lock().unwrap().push(serde_json::from_slice(bytes).unwrap());
+                self.write_entered.fetch_add(1, Ordering::SeqCst);
+                if self.hold_write.load(Ordering::SeqCst) {
+                    return std::future::pending().await;
+                }
+                let status = match self.write_status.load(Ordering::SeqCst) { 0 => 200, value => value };
+                let body = self.write_body.lock().unwrap().clone();
+                return Ok(http::Response::builder().status(status).header("content-type", "application/json")
+                    .body(if body.is_empty() { "{}".to_string() } else { body }).unwrap().into());
+            }
+            // Every unexpected request is intercepted: never invoke Next or open a socket.
+            self.unexpected.fetch_add(1, Ordering::SeqCst);
+            Ok(http::Response::builder().status(403).body("blocked".to_string()).unwrap().into())
+        }
+    }
+
+    fn login_view(revision: &str) -> CipherView {
+        CipherView {
+            partial: false, id: Some(CIPHER_ID.parse().unwrap()), organization_id: None,
+            folder_id: Some("33333333-3333-4333-8333-333333333333".parse().unwrap()),
+            collection_ids: vec![], key: None, name: "Synthetic title".into(),
+            notes: Some("Synthetic preserved note".into()), r#type: CipherType::Login,
+            login: Some(LoginView { username: Some("synthetic-old-user".into()),
+                password: Some("synthetic-old-pass".into()), password_revision_date: None,
+                uris: Some(vec![bitwarden_vault::LoginUriView {
+                    uri: Some("https://example.invalid/login?q=synthetic".into()),
+                    r#match: Some(bitwarden_vault::UriMatchType::Exact), uri_checksum: None,
+                }]), totp: Some("synthetic-totp-value".into()), autofill_on_page_load: None, fido2_credentials: None }),
+            identity: None, card: None, secure_note: None, ssh_key: None, bank_account: None,
+            drivers_license: None, passport: None, favorite: true, reprompt: CipherRepromptType::None,
+            organization_use_totp: false, edit: true, permissions: None, view_password: true,
+            local_data: None, attachments: None, attachment_decryption_failures: None,
+            fields: Some(vec![bitwarden_vault::FieldView {
