index f22f69b..47a82da 100644
--- a/crates/bitwarden-vault/src/cipher/cipher_client/mod.rs
+++ b/crates/bitwarden-vault/src/cipher/cipher_client/mod.rs
@@ -350,6 +350,54 @@ impl CiphersClient {
         Some(revision)
     }
 
+    /// Build a strict request from an already-authorized SDK snapshot. This is a
+    /// cryptographic transformation only; it grants no write authority and performs no I/O.
+    pub fn strict_personal_update_request(
+        &self,
+        original: Cipher,
+        username: Option<String>,
+        password: String,
+    ) -> Option<bitwarden_api_api::models::CipherRequestModel> {
+        if password.is_empty() || original.local_data.is_some()
+            || original.attachments.as_ref().is_some_and(|a| !a.is_empty()) {
+            return None;
+        }
+        let original_view: CipherView = self.key_store.decrypt(&StrictPersonalDecrypt(original.clone())).ok()?;
+        let mut modified = original_view.clone();
+        let login = modified.login.as_mut()?;
+        login.username = username;
+        login.password = Some(password);
+        modified.update_password_history(&original_view);
+        let previous = original_view.password_history.as_deref().unwrap_or(&[]);
+        let updated = modified.password_history.as_deref().unwrap_or(&[]);
+        if !updated.ends_with(previous) {
+            return None;
+        }
+        if updated.is_empty() && original_view.password_history.is_none() {
+            modified.password_history = None;
+        }
+        let encrypted_by_key_id = self.key_store.context()
+            .get_symmetric_key_id(modified.key_identifier()).map(|id| id.to_string());
+        let mut encrypted: Cipher = self.key_store.encrypt(EncryptMode::Legacy(modified.clone())).ok()?;
+        // Retain original encrypted attachment representation, including absent vs empty.
+        encrypted.attachments = original.attachments.clone();
+        let verified: CipherView = self.key_store.decrypt(&StrictPersonalDecrypt(encrypted.clone())).ok()?;
+        // Legacy keyless originals acquire a new SDK-generated item key. All
+        // other decrypted fields must survive the encrypt/decrypt round trip.
+        if original.key.is_none() {
+            modified.key = verified.key.clone();
+        }
+        if verified != modified {
+            return None;
+        }
+        let mut request: bitwarden_api_api::models::CipherRequestModel = encrypted.try_into().ok()?;
+        request.last_known_revision_date = Some(original.revision_date.to_rfc3339_opts(
+            chrono::SecondsFormat::AutoSi, true));
+        request.encrypted_for = Some(self.client.internal.get_user_id()?.into());
+        request.encrypted_by_key_id = encrypted_by_key_id;
+        Some(request)
+    }
+
     fn get_repository(&self) -> Result<Arc<dyn Repository<Cipher>>, RepositoryError> {
