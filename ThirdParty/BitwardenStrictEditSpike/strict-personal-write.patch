+
+    fn wire(cipher: &bitwarden_vault::Cipher) -> Value {
+        let encrypted = serde_json::to_value(cipher).unwrap();
+        let login = &encrypted["login"];
+        let uris = login["uris"].as_array().map(|items| items.iter().map(|item| json!({
+            "uri":item["uri"], "uriChecksum":item["uriChecksum"], "match":item["match"]
+        })).collect::<Vec<_>>());
+        let fields = encrypted["fields"].as_array().map(|items| items.iter().map(|item| json!({
+            "name":item["name"], "value":item["value"], "type":item["type"], "linkedId":item["linkedId"]
+        })).collect::<Vec<_>>());
+        json!({"object":"cipher", "id":CIPHER_ID, "organizationId":null, "type":1,
+            "data":null, "partialData":null, "name":encrypted["name"], "notes":encrypted["notes"],
+            "login":{"uri":null,"uris":uris,"username":login["username"],"password":login["password"],
+                "passwordRevisionDate":null,"totp":login["totp"],"autofillOnPageLoad":null,"fido2Credentials":null},
+            "card":null,"identity":null,"secureNote":null,"sshKey":null,"bankAccount":null,
+            "driversLicense":null,"passport":null,"fields":fields,"passwordHistory":encrypted["passwordHistory"],"attachments":null,
+            "organizationUseTotp":false,"revisionDate":cipher.revision_date.to_rfc3339(),
+            "creationDate":cipher.creation_date.to_rfc3339(),"deletedDate":null,"reprompt":0,
+            "key":encrypted["key"],"folderId":"33333333-3333-4333-8333-333333333333",
+            "favorite":true,"edit":true,"viewPassword":true,"archivedDate":null,
+            "permissions":null,"collectionIds":[]})
+    }
