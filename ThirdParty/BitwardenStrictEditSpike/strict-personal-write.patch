+        let gate = Arc::new(StrictOperationGate::default());
+        gate.state.lock().unwrap().epoch = u64::MAX;
+        assert!(gate.begin_sync().is_none());
+        assert!(gate.idle_epoch().is_none());
+        assert!(gate.begin_write(u64::MAX).is_none());
+
+        let count_gate = Arc::new(StrictOperationGate::default());
+        count_gate.state.lock().unwrap().syncs = usize::MAX;
+        assert!(count_gate.begin_sync().is_none());
+        assert!(count_gate.idle_epoch().is_none());
+
+        let poisoned = Arc::new(StrictOperationGate::default());
+        let copy = poisoned.clone();
+        let _ = std::panic::catch_unwind(move || {
+            let _lock = copy.state.lock().unwrap();
+            panic!("synthetic poison");
+        });
+        assert!(poisoned.begin_sync().is_none());
+        assert!(poisoned.begin_write(0).is_none());
+        assert!(poisoned.idle_epoch().is_none());
+    }
+}
