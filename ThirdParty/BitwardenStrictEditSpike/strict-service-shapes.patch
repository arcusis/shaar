+        || !equivalent_list(data["fields"], cipher["fields"], &["type", "name", "value", "linkedid"], &["type"])
+        || !equivalent_list(data["passwordhistory"], cipher["passwordhistory"], &["password", "lastuseddate"], &["password", "lastuseddate"])
