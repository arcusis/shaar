+        let uris = login["uris"].as_array().map(|items| items.iter().map(|item| json!({
+            "Uri":item["uri"], "UriChecksum":item["uriChecksum"], "Match":item["match"]
+        })).collect::<Vec<_>>());
+        let fields = c["fields"].as_array().map(|items| items.iter().map(|item| json!({
+            "Type":item["type"], "Name":item["name"], "Value":item["value"], "LinkedId":item["linkedId"]
+        })).collect::<Vec<_>>());
+        let history = c["passwordHistory"].as_array().map(|items| items.iter().map(|item| json!({
+            "Password":item["password"], "LastUsedDate":item["lastUsedDate"]
+        })).collect::<Vec<_>>());
+        let mut data = json!({"Name":c["name"],"Notes":c["notes"],"Fields":fields,"PasswordHistory":history,
+            "Uris":uris,"Username":login["username"],"Password":login["password"],
+            "PasswordRevisionDate":login["passwordRevisionDate"],"Totp":login["totp"],
+            "AutofillOnPageLoad":login["autofillOnPageLoad"],"Fido2Credentials":login["fido2Credentials"]});
+        fn omit_null(value: &mut Value) {
+            match value {
+                Value::Object(map) => { map.retain(|_, value| !value.is_null()); for value in map.values_mut() { omit_null(value); } }
+                Value::Array(items) => { for value in items { omit_null(value); } }
+                _ => {}
+            }
+        }
+        omit_null(&mut data);
+        data.to_string()
+    }
