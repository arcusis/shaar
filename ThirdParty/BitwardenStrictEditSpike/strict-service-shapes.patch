+    async fn strict_service_shapes_reject_false_edit_and_contradictory_data_before_write() {
+        for change in ["edit", "view", "contradictory", "unknown"] {
+            let (sdk, intercept) = fixture_with_keyed_attachments().await;
+            {
+                let mut raw = intercept.sync_response.lock().unwrap();
+                let mut envelope: Value = serde_json::from_str(&raw).unwrap();
+                let c = &mut envelope["ciphers"][0];
+                c["permissions"] = json!({"delete":false,"restore":false});
+                c["data"] = json!(legacy_data_from_record(c));
+                match change {
+                    "edit" => c["edit"] = json!(false),
+                    "view" => c["viewPassword"] = json!(false),
+                    "contradictory" => c["name"] = json!("different"),
+                    "unknown" => { let mut data: Value = serde_json::from_str(c["data"].as_str().unwrap()).unwrap();
+                        data["future"] = json!("unknown"); c["data"] = json!(data.to_string()); },
+                    _ => unreachable!(),
+                }
+                *raw = envelope.to_string();
+            }
+            assert!(sdk.sync(true).await.unwrap());
+            assert!(sdk.strict_prepare_personal_login(CIPHER_ID.parse().unwrap(), 1).is_none(), "{change}");
+            assert!(intercept.writes.lock().unwrap().is_empty());
+            assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+        }
+    }
