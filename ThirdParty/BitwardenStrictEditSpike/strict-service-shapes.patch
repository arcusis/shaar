+    async fn strict_service_shapes_real_crypto_preserve_fields_and_attachments() {
+        // Cloud and self-hosted use the same pinned Bitwarden server source;
+        // Vaultwarden has its own source-shaped response, not a live claim.
+        for (provider, match_mode) in [("bitwarden-cloud", 0), ("bitwarden-selfhosted", 1), ("vaultwarden", 2), ("synthetic-independent-permissions", 3), ("bitwarden-regex", 4), ("bitwarden-never", 5)] {
+            let (sdk, intercept) = fixture_with_keyed_attachments().await;
+            {
+                let mut raw = intercept.sync_response.lock().unwrap();
+                let mut envelope: Value = serde_json::from_str(&raw).unwrap();
+                let c = &mut envelope["ciphers"][0];
+                c.as_object_mut().unwrap().remove("partialData");
+                c["permissions"] = if provider == "synthetic-independent-permissions" {
+                    json!({"delete":false, "restore":false})
+                } else { json!({"delete":true, "restore":true}) };
+                c["login"]["uris"][0]["match"] = json!(match_mode);
+                c["login"]["uri"] = c["login"]["uris"][0]["uri"].clone();
+                if provider == "vaultwarden" {
+                    c.as_object_mut().unwrap().remove("data");
+                    c["organizationUseTotp"] = json!(true);
+                } else {
+                    c["data"] = json!(legacy_data_from_record(c));
+                }
+                *raw = envelope.to_string();
+            }
+            assert!(sdk.sync(true).await.unwrap(), "{provider}");
+            let original = sdk.encrypted_snapshot().ciphers[0].clone();
+            assert_eq!(original.data.is_some(), provider != "vaultwarden");
+            let old_view = sdk.client.vault().ciphers().decrypt(original.clone()).await.unwrap();
+            let prep = sdk.strict_prepare_personal_login(CIPHER_ID.parse().unwrap(), 1).expect(provider);
+            assert_eq!(prep.revision(), "2025-01-01T00:00:00.123456789Z");
+            assert_eq!(sdk.strict_personal_update(&prep, Some("synthetic-new-user".into()), "synthetic-new-pass".into()).await,
+                StrictPersonalWriteOutcome::Unconfirmed, "{provider}");
+            assert_eq!(sdk.encrypted_snapshot().ciphers[0].data, original.data, "published data changed");
+            let body = { let writes = intercept.writes.lock().unwrap(); assert_eq!(writes.len(), 1); writes[0].clone() };
+            assert!(body.get("data").is_none());
+            assert_eq!(body["lastKnownRevisionDate"], "2025-01-01T00:00:00.123456789Z");
+            assert_eq!(body["login"]["uris"][0]["match"], json!(match_mode));
+            let original_wire: Value = serde_json::from_str(&intercept.sync_response.lock().unwrap()).unwrap();
+            let mut response = original_wire["ciphers"][0].clone();
+            let attachments = response["attachments"].as_array().unwrap();
+            for attachment in attachments {
+                let id = attachment["id"].as_str().unwrap();
+                assert_eq!(body["attachments2"][id]["fileName"], attachment["fileName"]);
+                assert_eq!(body["attachments2"][id]["key"], attachment["key"]);
+            }
+            for field in ["name", "notes", "key", "login", "fields", "passwordHistory"] {
+                response[field] = body.get(field).cloned().unwrap_or(Value::Null);
+            }
+            if provider != "vaultwarden" { response["data"] = json!(legacy_data_from_record(&response)); }
+            let model: bitwarden_api_api::models::CipherDetailsResponseModel = serde_json::from_value(response).unwrap();
+            let decoded = sdk.client.vault().ciphers().decrypt(bitwarden_vault::Cipher::try_from(model).unwrap()).await.unwrap();
+            assert_eq!(decoded.name, old_view.name); assert_eq!(decoded.notes, old_view.notes);
+            assert_eq!(decoded.fields, old_view.fields); assert_eq!(decoded.attachments, old_view.attachments);
+            assert_eq!(decoded.permissions, old_view.permissions);
+            assert_eq!(decoded.login.unwrap().password.as_deref(), Some("synthetic-new-pass"));
+            assert_eq!(intercept.unexpected.load(Ordering::SeqCst), 0);
+        }
+    }
