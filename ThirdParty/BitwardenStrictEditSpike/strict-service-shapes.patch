+fn equivalent_list(left: &Captured, right: &Captured, keys: &[&str], required: &[&str]) -> bool {
+    match (left, right) {
+        (Captured::Null, Captured::Null) => true,
+        (Captured::Array(a), Captured::Array(b)) if a.len() == b.len() => {
+            let optional: Vec<&str> = keys.iter().copied().filter(|key| !required.contains(key)).collect();
+            a.iter().zip(b).all(|(x, y)| {
+                let Some(x) = object_optional_kind(x, keys, &optional, true) else { return false; };
+                let Some(y) = object_optional(y, keys, &optional) else { return false; };
+                required.iter().all(|key| nonnull(x[*key]) && nonnull(y[*key]))
+                    && keys.iter().all(|key| x[*key] == y[*key])
+            })
+        }
+        _ => false,
+    }
+}
