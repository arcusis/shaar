+fn bounded_data(value: &Captured, depth: usize, remaining: &mut usize) -> bool {
+    if depth > 12 || *remaining == 0 { return false; }
+    *remaining -= 1;
+    match value {
+        Captured::Array(items) => items.iter().all(|v| bounded_data(v, depth + 1, remaining)),
+        Captured::Object(items) => items.0.iter().all(|(_, v)| bounded_data(v, depth + 1, remaining)),
+        _ => true,
+    }
