diff --git a/crates/bitwarden-core/src/key_management/org_replacement_tests.rs b/crates/bitwarden-core/src/key_management/org_replacement_tests.rs
new file mode 100644
index 0000000..9773d1a
--- /dev/null
+++ b/crates/bitwarden-core/src/key_management/org_replacement_tests.rs
@@ -0,0 +1,295 @@
+use crate::{
+    Client, OrganizationId,
+    client::{
+        encryption_settings::{EncryptionSettings, EncryptionSettingsError},
+        persisted_state::OrganizationSharedKey,
+        test_accounts::test_bitwarden_com_account,
+    },
+    key_management::{PrivateKeySlotId, SymmetricKeySlotId, crypto::InitOrgCryptoRequest},
+};
+use bitwarden_crypto::{
+    Decryptable, PrimitiveEncryptable, SymmetricKeyAlgorithm, UnsignedSharedKey,
+};
+use bitwarden_state::repository::{Repository, RepositoryError};
+use bitwarden_test::MemoryRepository;
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+
+struct ControlledRepo {
+    inner: MemoryRepository<OrganizationSharedKey>,
+    fail_remove: AtomicBool,
+    fail_set: AtomicBool,
+}
+impl Default for ControlledRepo {
+    fn default() -> Self {
+        Self {
+            inner: MemoryRepository::default(),
+            fail_remove: AtomicBool::new(false),
+            fail_set: AtomicBool::new(false),
+        }
+    }
+}
+async fn yield_once() {
+    let mut yielded = false;
+    futures::future::poll_fn(|cx| {
+        if yielded {
+            std::task::Poll::Ready(())
+        } else {
+            yielded = true;
+            cx.waker().wake_by_ref();
+            std::task::Poll::Pending
+        }
+    })
+    .await
+}
+#[async_trait::async_trait]
+impl Repository<OrganizationSharedKey> for ControlledRepo {
+    async fn get(
+        &self,
+        k: OrganizationId,
+    ) -> Result<Option<OrganizationSharedKey>, RepositoryError> {
+        self.inner.get(k).await
+    }
+    async fn list(&self) -> Result<Vec<OrganizationSharedKey>, RepositoryError> {
+        self.inner.list().await
+    }
+    async fn set(
+        &self,
+        k: OrganizationId,
+        v: OrganizationSharedKey,
+    ) -> Result<(), RepositoryError> {
+        self.inner.set(k, v).await
+    }
+    async fn set_bulk(
+        &self,
+        v: Vec<(OrganizationId, OrganizationSharedKey)>,
+    ) -> Result<(), RepositoryError> {
+        yield_once().await;
+        if self.fail_set.load(Ordering::SeqCst) {
+            if let Some((id, entry)) = v.first() {
+                self.inner.set(*id, entry.clone()).await?;
+            }
+            return Err(RepositoryError::Internal("injected".into()));
+        }
+        self.inner.set_bulk(v).await
+    }
+    async fn remove(&self, k: OrganizationId) -> Result<(), RepositoryError> {
+        self.inner.remove(k).await
+    }
+    async fn remove_bulk(&self, k: Vec<OrganizationId>) -> Result<(), RepositoryError> {
+        self.inner.remove_bulk(k).await
+    }
+    async fn remove_all(&self) -> Result<(), RepositoryError> {
+        yield_once().await;
+        if self.fail_remove.load(Ordering::SeqCst) {
+            return Err(RepositoryError::Internal("injected".into()));
+        }
+        self.inner.remove_all().await
+    }
+}
+fn has(client: &Client, id: OrganizationId) -> bool {
+    client
+        .internal
+        .get_key_store()
+        .context()
+        .has_symmetric_key(SymmetricKeySlotId::Organization(id))
+}
+fn req(keys: Vec<(OrganizationId, UnsignedSharedKey)>) -> InitOrgCryptoRequest {
+    InitOrgCryptoRequest {
+        organization_keys: keys.into_iter().collect(),
+    }
+}
+
+fn generated_org_key(client: &Client) -> UnsignedSharedKey {
+    let store = client.internal.get_key_store();
+    let mut ctx = store.context_mut();
+    #[allow(deprecated)]
+    let public = ctx
+        .dangerous_get_private_key(PrivateKeySlotId::UserPrivateKey)
+        .unwrap()
+        .to_public_key();
+    let key = ctx.make_symmetric_key(SymmetricKeyAlgorithm::XAes256Gcm);
+    UnsignedSharedKey::encapsulate(key, &public, &ctx).unwrap()
+}
+
+#[tokio::test]
+async fn replacement_security_regression() {
+    let client = Client::init_test_account(test_bitwarden_com_account()).await;
+    let other = Client::init_test_account(test_bitwarden_com_account()).await;
+    let repo = client
+        .internal
+        .state_registry
+        .get::<OrganizationSharedKey>()
+        .unwrap();
+    let original = repo.list().await.unwrap().pop().unwrap();
+    let old = original.org_id;
+    let next = OrganizationId::new_v4();
+    let generated = generated_org_key(&client);
+    let personal = {
+        let store = client.internal.get_key_store();
+        let mut ctx = store.context_mut();
+        "personal"
+            .encrypt(&mut ctx, SymmetricKeySlotId::User)
+            .unwrap()
+    };
+    let ciphertext = {
+        let store = client.internal.get_key_store();
+        let mut ctx = store.context_mut();
+        "organization"
+            .encrypt(&mut ctx, SymmetricKeySlotId::Organization(old))
+            .unwrap()
+    };
+    client
+        .crypto()
+        .initialize_org_crypto(req(vec![(next, generated.clone())]))
+        .await
+        .unwrap();
+    assert!(!has(&client, old));
+    assert!(has(&client, next));
+    assert!(has(&other, old));
+    assert!(repo.get(old).await.unwrap().is_none());
+    assert!(repo.get(next).await.unwrap().is_some());
+    {
+        let store = client.internal.get_key_store();
+        let mut ctx = store.context_mut();
+        let revoked: Result<String, _> =
+            ciphertext.decrypt(&mut ctx, SymmetricKeySlotId::Organization(old));
+        assert!(revoked.is_err());
+        let plain: String = personal
+            .decrypt(&mut ctx, SymmetricKeySlotId::User)
+            .unwrap();
+        assert_eq!(plain, "personal");
+    }
+    client
+        .crypto()
+        .initialize_org_crypto(req(vec![]))
+        .await
+        .unwrap();
+    assert!(!has(&client, next));
+    assert!(repo.list().await.unwrap().is_empty());
+    assert!(has(&other, old));
+    client
+        .crypto()
+        .initialize_org_crypto(req(vec![(old, original.key.clone())]))
+        .await
+        .unwrap();
+    let uninitialized = Client::new_test(None);
+    assert!(
+        uninitialized
+            .crypto()
+            .initialize_org_crypto(req(vec![(old, original.key.clone())]))
+            .await
+            .is_err()
+    );
+    assert!(!has(&uninitialized, old));
+    let bad = UnsignedSharedKey::Rsa2048_OaepSha256_B64 { data: vec![0] };
+    assert!(
+        EncryptionSettings::set_org_keys(
+            vec![(next, original.key.clone()), (old, bad.clone())],
+            client.internal.get_key_store(),
+            true
+        )
+        .is_err()
+    );
+    assert!(!has(&client, old));
+    assert!(!has(&client, next));
+    assert!(
+        client
+            .crypto()
+            .initialize_org_crypto(req(vec![(next, original.key), (old, bad)]))
+            .await
+            .is_err()
+    );
+    assert!(repo.list().await.unwrap().is_empty());
+    assert!(!has(&client, old));
+    assert!(!has(&client, next));
+    let plain: String = {
+        let store = client.internal.get_key_store();
+        personal
+            .decrypt(&mut store.context_mut(), SymmetricKeySlotId::User)
+            .unwrap()
+    };
+    assert_eq!(plain, "personal");
+}
+
+#[tokio::test]
+async fn repository_failure_and_concurrent_replacement() {
+    let client = Client::init_test_account(test_bitwarden_com_account()).await;
+    let original = client
+        .internal
+        .state_registry
+        .get::<OrganizationSharedKey>()
+        .unwrap()
+        .list()
+        .await
+        .unwrap()
+        .pop()
+        .unwrap();
+    let repo = Arc::new(ControlledRepo::default());
+    client
+        .internal
+        .state_registry
+        .register_client_managed(repo.clone());
+    repo.set(original.org_id, original.clone()).await.unwrap();
+    client.require_fresh_organization_sync().await;
+    repo.fail_remove.store(true, Ordering::SeqCst);
+    assert!(matches!(
+        client.crypto().initialize_org_crypto(req(vec![])).await,
+        Err(EncryptionSettingsError::OrganizationKeyStateUpdateFailed)
+    ));
+    assert!(!has(&client, original.org_id));
+    assert!(repo.get(original.org_id).await.unwrap().is_some());
+    let recreated = Client::init_test_account(test_bitwarden_com_account()).await;
+    recreated
+        .internal
+        .state_registry
+        .register_client_managed(repo.clone());
+    recreated.require_fresh_organization_sync().await;
+    recreated
+        .internal
+        .restore_persisted_org_crypto()
+        .await
+        .unwrap();
+    assert!(!has(&recreated, original.org_id));
+    assert!(
+        recreated
+            .internal
+            .get_key_store()
+            .context()
+            .has_symmetric_key(SymmetricKeySlotId::User)
+    );
+    repo.fail_remove.store(false, Ordering::SeqCst);
+    repo.fail_set.store(true, Ordering::SeqCst);
+    assert!(matches!(
+        client
+            .crypto()
+            .initialize_org_crypto(req(vec![(original.org_id, original.key.clone())]))
+            .await,
+        Err(EncryptionSettingsError::OrganizationKeyStateUpdateFailed)
+    ));
+    assert!(!has(&client, original.org_id));
+    assert!(repo.get(original.org_id).await.unwrap().is_some());
+    client
+        .internal
+        .restore_persisted_org_crypto()
+        .await
+        .unwrap();
+    assert!(!has(&client, original.org_id));
+    repo.fail_set.store(false, Ordering::SeqCst);
+    let a = OrganizationId::new_v4();
+    let b = OrganizationId::new_v4();
+    let crypto_a = client.crypto();
+    let crypto_b = client.crypto();
+    let (ra, rb) = futures::join!(
+        crypto_a.initialize_org_crypto(req(vec![(a, original.key.clone())])),
+        crypto_b.initialize_org_crypto(req(vec![(b, original.key)]))
+    );
+    ra.unwrap();
+    rb.unwrap();
+    let rows = repo.list().await.unwrap();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(has(&client, a), rows[0].org_id == a);
+    assert_eq!(has(&client, b), rows[0].org_id == b);
+}
