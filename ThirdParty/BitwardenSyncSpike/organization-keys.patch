+type OrganizationKeys =
+    std::collections::HashMap<bitwarden_core::OrganizationId, bitwarden_crypto::UnsignedSharedKey>;
+
+/// Encrypted data published together after a successful sync.
+#[derive(Clone, Default)]
+pub struct SyncSnapshot {
+    /// Monotonic publication number, starting at zero before the first sync.
+    pub generation: u64,
+    /// Encrypted ciphers from this generation.
+    pub ciphers: Vec<bitwarden_vault::Cipher>,
+    /// Encrypted organization keys from this generation.
+    pub organization_keys: OrganizationKeys,
+}
+
 #[derive(Default)]
 struct SyncSnapshotState {
-    pending: Option<Vec<bitwarden_vault::Cipher>>,
-    published: Vec<bitwarden_vault::Cipher>,
+    pending: Option<SyncSnapshot>,
+    published: SyncSnapshot,
+}
+
+fn organization_keys(
+    response: &bitwarden_api_api::models::SyncResponseModel,
+) -> Result<OrganizationKeys, bitwarden_sync::SyncHandlerError> {
+    let profile = response.profile.as_ref().ok_or("missing sync profile")?;
+    let organizations = profile
+        .organizations_new
+        .as_ref()
+        .or(profile.organizations.as_ref())
+        .ok_or("missing organizations")?;
+    let mut keys = OrganizationKeys::new();
+    for organization in organizations {
+        let id = organization
+            .id
+            .filter(|id| !id.is_nil())
+            .ok_or("invalid organization id")?;
+        let raw = organization
+            .key
+            .as_deref()
+            .ok_or("missing organization key")?;
+        let key: bitwarden_crypto::UnsignedSharedKey =
+            raw.parse().map_err(|_| "invalid organization key")?;
+        #[allow(deprecated)]
+        let valid = match &key {
+            bitwarden_crypto::UnsignedSharedKey::Rsa2048_OaepSha256_B64 { data }
+            | bitwarden_crypto::UnsignedSharedKey::Rsa2048_OaepSha1_B64 { data } => {
+                !data.is_empty()
+            }
+            bitwarden_crypto::UnsignedSharedKey::Rsa2048_OaepSha256_HmacSha256_B64 {
+                data,
+                mac,
+            }
+            | bitwarden_crypto::UnsignedSharedKey::Rsa2048_OaepSha1_HmacSha256_B64 { data, mac } => {
+                !data.is_empty() && !mac.is_empty()
+            }
+        };
+        if !valid
+            || keys
+                .insert(bitwarden_core::OrganizationId::new(id), key)
+                .is_some()
+        {
+            return Err("invalid or duplicate organization key".into());
+        }
+    }
+    Ok(keys)
 }
 
