+
+/// Encrypted data cloned from a single published sync generation.
+#[derive(uniffi::Record)]
+pub struct EncryptedSyncSnapshot {
+    /// Publication number, zero before the first successful sync.
+    pub generation: u64,
+    /// Encrypted ciphers from this generation.
+    pub ciphers: Vec<Cipher>,
+    /// Encrypted organization keys from this generation.
+    pub organization_keys: std::collections::HashMap<
+        bitwarden_core::OrganizationId,
+        bitwarden_crypto::UnsignedSharedKey,
+    >,
+}
+
+#[uniffi::export]
+impl SyncClientBinding {
+    /// Return ciphers and organization keys from one sync generation.
+    pub fn encrypted_snapshot(&self) -> EncryptedSyncSnapshot {
+        let snapshot = self.0.encrypted_snapshot();
+        EncryptedSyncSnapshot {
+            generation: snapshot.generation,
+            ciphers: snapshot.ciphers,
+            organization_keys: snapshot.organization_keys,
+        }
+    }
+}
