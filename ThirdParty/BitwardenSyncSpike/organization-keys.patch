+#[cfg(test)]
+mod organization_snapshot_tests {
+    use super::*;
+    use bitwarden_api_api::models::{
+        CipherDetailsResponseModel, CipherType, ProfileOrganizationResponseModel, ProfileResponseModel,
+        SyncResponseModel,
+    };
+    use bitwarden_sync::{SyncErrorHandler, SyncHandler};
+
+    fn org(id: &str, key: &str) -> ProfileOrganizationResponseModel {
+        ProfileOrganizationResponseModel {
+            id: Some(id.parse().unwrap()),
+            key: Some(key.into()),
+            ..Default::default()
+        }
+    }
+    fn response(orgs: Vec<ProfileOrganizationResponseModel>, cipher: bool) -> SyncResponseModel {
+        let mut response = SyncResponseModel::new();
+        response.profile = Some(Box::new(ProfileResponseModel {
+            organizations_new: Some(orgs),
+            ..Default::default()
+        }));
+        if cipher {
+            response.ciphers = Some(vec![CipherDetailsResponseModel {
+                id: Some("11111111-1111-4111-8111-111111111111".parse().unwrap()),
+                r#type: Some(CipherType::Login),
+                partial_data: Some("{}".into()),
+                revision_date: Some("2025-01-01T00:00:00Z".into()),
+                creation_date: Some("2025-01-01T00:00:00Z".into()),
+                ..Default::default()
+            }]);
+        }
+        response
+    }
+    const ID: &str = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+    const KEY: &str = "3.AQ==";
+    fn handler() -> SyncSnapshotHandler {
+        SyncSnapshotHandler(Arc::new(
+            std::sync::Mutex::new(SyncSnapshotState::default()),
+        ))
+    }
+
+    #[tokio::test]
+    async fn paired_publication_and_revocation() {
+        let h = handler();
+        h.on_sync(&response(vec![org(ID, KEY)], true))
+            .await
+            .unwrap();
+        {
+            let state = h.0.lock().unwrap();
+            assert!(state.published.ciphers.is_empty());
+            assert!(state.published.organization_keys.is_empty());
+            assert_eq!(state.pending.as_ref().unwrap().ciphers.len(), 1);
+        }
+        h.on_sync_complete().await;
+        {
+            let state = h.0.lock().unwrap();
+            assert_eq!(state.published.ciphers.len(), 1);
+            assert_eq!(state.published.organization_keys.len(), 1);
+            assert_eq!(state.published.generation, 1);
+        }
+        h.on_sync(&response(vec![], false)).await.unwrap();
+        h.on_sync_complete().await;
+        let state = h.0.lock().unwrap();
+        assert!(state.published.ciphers.is_empty());
+        assert!(state.published.organization_keys.is_empty());
+        assert_eq!(state.published.generation, 2);
+    }
+    #[tokio::test]
+    async fn paired_snapshot_stays_consistent_across_publications() {
+        let h = handler();
+        let state = h.0.clone();
+        let reader = std::thread::spawn(move || {
+            for _ in 0..10000 {
+                let snapshot = state.lock().unwrap().published.clone();
+                assert_eq!(snapshot.ciphers.len(), snapshot.organization_keys.len());
+                assert_eq!(snapshot.ciphers.len() as u64, snapshot.generation % 2);
+            }
+        });
+        for generation in 1..=100 {
+            let present = generation % 2 == 1;
+            h.on_sync(&response(if present { vec![org(ID, KEY)] } else { vec![] }, present)).await.unwrap();
+            h.on_sync_complete().await;
+        }
+        reader.join().unwrap();
+        assert_eq!(h.0.lock().unwrap().published.generation, 100);
+    }
+    #[tokio::test]
+    async fn rejects_missing_malformed_and_duplicate_entries() {
+        let h = handler();
+        let mut missing_id = org(ID, KEY);
+        missing_id.id = None;
+        let mut missing_key = org(ID, KEY);
+        missing_key.key = None;
+        for list in [
+            vec![missing_id],
+            vec![missing_key],
+            vec![org("00000000-0000-0000-0000-000000000000", KEY)],
+            vec![org(ID, "bad")],
+            vec![org(ID, "3.")],
+            vec![org(ID, KEY), org(ID, KEY)],
+        ] {
+            assert!(h.on_sync(&response(list, false)).await.is_err());
+        }
+        assert!(h.on_sync(&SyncResponseModel::new()).await.is_err());
+        let mut missing_list = response(vec![], false);
+        missing_list.profile.as_mut().unwrap().organizations_new = None;
+        assert!(h.on_sync(&missing_list).await.is_err());
+        missing_list.profile.as_mut().unwrap().organizations = Some(vec![org(ID, KEY)]);
+        assert!(h.on_sync(&missing_list).await.is_ok());
+        missing_list.profile.as_mut().unwrap().organizations_new = Some(vec![]);
+        assert!(organization_keys(&missing_list).unwrap().is_empty());
+    }
+    #[tokio::test]
+    async fn failure_discards_pending_and_keeps_last_snapshot() {
+        let h = handler();
+        h.on_sync(&response(vec![org(ID, KEY)], true))
+            .await
+            .unwrap();
+        h.on_sync_complete().await;
+        h.on_sync(&response(vec![], false)).await.unwrap();
+        h.on_error(&bitwarden_sync::SyncError::AccountDeleted).await;
+        h.on_sync_complete().await;
+        {
+            let state = h.0.lock().unwrap();
+            assert!(state.pending.is_none());
+            assert_eq!(state.published.ciphers.len(), 1);
+            assert_eq!(state.published.organization_keys.len(), 1);
+        }
+        h.on_sync(&response(vec![], false)).await.unwrap();
+        assert!(
+            h.on_sync(&response(vec![org(ID, "invalid")], false))
+                .await
+                .is_err()
+        );
+        h.on_sync_complete().await;
+        let state = h.0.lock().unwrap();
+        assert!(state.pending.is_none());
+        assert_eq!(state.published.ciphers.len(), 1);
+        assert_eq!(state.published.organization_keys.len(), 1);
+    }
+    #[tokio::test]
+    async fn clients_have_independent_snapshots() {
+        let a = handler();
+        let b = handler();
+        a.on_sync(&response(vec![org(ID, KEY)], true))
+            .await
+            .unwrap();
+        a.on_sync_complete().await;
+        b.on_sync(&response(vec![], false)).await.unwrap();
+        b.on_sync_complete().await;
+        assert_eq!(a.0.lock().unwrap().published.organization_keys.len(), 1);
+        assert!(b.0.lock().unwrap().published.organization_keys.is_empty());
+        assert_eq!(a.0.lock().unwrap().published.ciphers.len(), 1);
+        assert!(b.0.lock().unwrap().published.ciphers.is_empty());
+    }
+}
