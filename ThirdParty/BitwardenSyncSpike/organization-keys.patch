+impl SyncClientBinding {
+    /// Return encrypted organization keys from the last successful snapshot.
+    pub fn encrypted_organization_keys(
+        &self,
+    ) -> std::collections::HashMap<
+        bitwarden_core::OrganizationId,
+        bitwarden_crypto::UnsignedSharedKey,
