+#[derive(Default)]
+struct SyncSnapshotState {
+    pending: Option<Vec<bitwarden_vault::Cipher>>,
+    published: Vec<bitwarden_vault::Cipher>,
+}
+
+struct SyncSnapshotHandler(Arc<std::sync::Mutex<SyncSnapshotState>>);
+
+#[async_trait::async_trait]
+impl bitwarden_sync::SyncHandler for SyncSnapshotHandler {
+    async fn on_sync(
+        &self,
+        response: &bitwarden_api_api::models::SyncResponseModel,
+    ) -> Result<(), bitwarden_sync::SyncHandlerError> {
+        let ciphers = response
+            .ciphers
+            .clone()
+            .unwrap_or_default()
+            .into_iter()
+            .map(bitwarden_vault::Cipher::try_from)
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .map_err(|error| -> bitwarden_sync::SyncHandlerError { Box::new(error) })?;
+        self.0.lock().expect("sync snapshot lock").pending = Some(ciphers);
+        Ok(())
+    }
+
+    async fn on_sync_complete(&self) {
+        let mut state = self.0.lock().expect("sync snapshot lock");
+        if let Some(snapshot) = state.pending.take() {
+            state.published = snapshot;
+        }
+    }
+}
+
+#[async_trait::async_trait]
+impl bitwarden_sync::SyncErrorHandler for SyncSnapshotHandler {
+    async fn on_error(&self, _error: &bitwarden_sync::SyncError) {
+        self.0.lock().expect("sync snapshot lock").pending = None;
+    }
+}
+
+/// Retained SDK sync client with a typed, in-memory encrypted cipher snapshot.
+pub struct SyncCipherSnapshotClient {
+    sdk: bitwarden_sync::SyncClient,
+    state: Arc<std::sync::Mutex<SyncSnapshotState>>,
+}
+
+impl SyncCipherSnapshotClient {
+    fn new(client: bitwarden_core::Client) -> Self {
+        let sdk = client.sync();
+        #[cfg(not(target_arch = "wasm32"))]
+        sdk.register_sync_handler(Arc::new(CryptoSyncHandler::new(client.clone())));
+        sdk.register_sync_handler(Arc::new(FolderSyncHandler::from_client(&client)));
+        sdk.register_sync_handler(Arc::new(SendSyncHandler::from_client(&client)));
+        sdk.register_sync_handler(Arc::new(PolicySyncHandler::from_client(&client)));
+
+        let state = Arc::new(std::sync::Mutex::new(SyncSnapshotState::default()));
+        let handler = Arc::new(SyncSnapshotHandler(state.clone()));
+        sdk.register_sync_handler(handler.clone());
+        sdk.register_error_handler(handler);
+        Self { sdk, state }
+    }
+
+    pub async fn sync(&self, force: bool) -> std::result::Result<bool, bitwarden_sync::SyncError> {
+        self.sdk
+            .sync(bitwarden_sync::SyncRequest {
+                force,
+                exclude_subdomains: None,
+            })
+            .await
+    }
+
+    pub fn encrypted_ciphers(&self) -> Vec<bitwarden_vault::Cipher> {
+        self.state
+            .lock()
+            .expect("sync snapshot lock")
+            .published
+            .clone()
+    }
+}
+
+impl PasswordManagerClient {
+    /// Create a retained sync client and its client-scoped encrypted cipher snapshot.
+    pub fn sync_with_snapshot(&self) -> SyncCipherSnapshotClient {
+        SyncCipherSnapshotClient::new(self.0.clone())
+    }
+}
