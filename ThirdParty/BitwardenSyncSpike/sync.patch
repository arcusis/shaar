@@ -0,0 +1,29 @@
+use bitwarden_vault::Cipher;
+
+use crate::error::{Error, Result};
+
+#[allow(missing_docs)]
+#[derive(uniffi::Object)]
+pub struct SyncClientBinding(pub(crate) bitwarden_pm::SyncCipherSnapshotClient);
+
+impl SyncClientBinding {
+    pub(crate) fn new(client: &bitwarden_pm::PasswordManagerClient) -> Self {
+        Self(client.sync_with_snapshot())
+    }
+}
+
+#[uniffi::export(async_runtime = "tokio")]
+impl SyncClientBinding {
+    /// Fetch server sync and publish typed encrypted ciphers after registered handlers succeed.
+    pub async fn sync(&self, force: bool) -> Result<bool> {
+        self.0
+            .sync(force)
+            .await
+            .map_err(|_| Error::Conversion("sync failed".to_owned()))
+    }
+
+    /// Return this client's last successfully published encrypted cipher snapshot.
+    pub fn encrypted_ciphers(&self) -> Vec<Cipher> {
+        self.0.encrypted_ciphers()
+    }
+}
