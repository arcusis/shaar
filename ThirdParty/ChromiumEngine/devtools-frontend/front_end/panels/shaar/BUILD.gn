import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../visibility.gni")

# One "<feature>:meta" dep per import in shaar-meta.ts, same order.
devtools_entrypoint("meta") {
  entrypoint = "shaar-meta.ts"

  ts_deps = [ "build-info:meta" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]
}
