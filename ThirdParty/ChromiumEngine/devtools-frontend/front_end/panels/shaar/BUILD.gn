import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../visibility.gni")

# One "<feature>:meta" dep per import in shaar-meta.ts, same order.
devtools_entrypoint("meta") {
  entrypoint = "shaar-meta.ts"

  ts_deps = [
    "build-info:meta",
    "network-rules:meta",
    "overflow:meta",
  ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]
}

# One "<feature>:unittests" dep per feature, same order as shaar-meta.ts.
group("unittests") {
  testonly = true
  deps = [
    "build-info:unittests",
    "network-rules:unittests",
    "overflow:unittests",
  ]
}
