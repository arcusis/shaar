import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../visibility.gni")

# One "<feature>:meta" dep per import in shaar-meta.ts, same order.
devtools_entrypoint("meta") {
  entrypoint = "shaar-meta.ts"

  ts_deps = [
    "build-info:meta",
    "network-rules:meta",
    "overflow:meta",
    "focus-contrast:meta",
    "stacking-3d:meta",
    "stacking:meta",
    "copy-for-agent:meta",
    "graphql-trpc:meta",
  ]
  ts_deps = [ "build-info:meta" ]
  ts_deps += [ "graphql-trpc:meta" ]
  # Same reason as viewports:meta: this bundle inlines the panel until the
  # entrypoint is listed in the GRD file.
  deps = [ "viewports:css_files" ]
    "viewports:meta",

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]
}

# One "<feature>:unittests" dep per feature, same order as shaar-meta.ts.
group("unittests") {
  testonly = true
  deps = [
    "build-info:unittests",
    "network-rules:unittests",
    "overflow:unittests",
    "focus-contrast:unittests",
    "stacking-3d:unittests",
    "stacking:unittests",
    "copy-for-agent:unittests",
    "graphql-trpc:unittests",
  ]
  deps = [ "build-info:unittests" ]
  deps += [ "graphql-trpc:unittests" ]
    "viewports:unittests",
}
