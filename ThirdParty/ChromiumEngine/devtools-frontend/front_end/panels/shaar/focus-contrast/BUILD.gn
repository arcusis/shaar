import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../visibility.gni")

devtools_ui_module("focus_contrast") {
  sources = [
    "FocusContrast.ts",
    "FocusContrastPanel.ts",
  ]

  ts_deps = [
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../generated",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "focus-contrast.ts"

  ts_deps = [ ":focus_contrast" ]

  visibility = [
    ":*",
    "..:*",
    "../*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "focus-contrast-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "..:*",
    "../../../entrypoints/*",
  ]
}

ts_library("unittests") {
  testonly = true

  sources = [ "FocusContrast.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../generated",
    "../../../testing",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}
