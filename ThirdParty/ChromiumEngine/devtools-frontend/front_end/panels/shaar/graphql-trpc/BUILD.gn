import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../visibility.gni")

devtools_ui_module("graphql_trpc") {
  sources = [
    "APIOperationWatch.ts",
    "APIOperations.ts",
    "APIOperationsPanel.ts",
  ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../core/text_utils:bundle",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "graphql-trpc.ts"

  ts_deps = [ ":graphql_trpc" ]

  visibility = [
    ":*",
    "..:*",
    "../*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "graphql-trpc-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "..:*",
    "../../../entrypoints/*",
  ]
}

ts_library("unittests") {
  testonly = true

  sources = [ "APIOperations.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../core/text_utils:bundle",
    "../../../testing",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}
