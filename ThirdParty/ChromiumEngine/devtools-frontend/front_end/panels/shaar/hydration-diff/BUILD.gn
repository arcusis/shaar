import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../visibility.gni")

devtools_ui_module("hydration_diff") {
  sources = [
    "HydrationDiff.ts",
    "HydrationPanel.ts",
  ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../core/text_utils:bundle",
    "../../../generated",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "hydration-diff.ts"

  ts_deps = [ ":hydration_diff" ]

  visibility = [
    ":*",
    "../*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "hydration-diff-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "../:meta",
    "../../../entrypoints/*",
  ]
}

ts_library("unittests") {
  testonly = true

  sources = [ "HydrationDiff.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../core/text_utils:bundle",
    "../../../generated",
    "../../../testing",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}
