import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../visibility.gni")

devtools_ui_module("network_rules") {
  sources = [
    "NetworkRules.ts",
    "NetworkRulesView.ts",
  ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "network-rules.ts"

  ts_deps = [ ":network_rules" ]

  visibility = [
    ":*",
    "..:*",
    "../*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "network-rules-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "..:*",
    "../../../entrypoints/*",
  ]
}

ts_library("unittests") {
  testonly = true

  sources = [ "NetworkRules.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../testing",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}
