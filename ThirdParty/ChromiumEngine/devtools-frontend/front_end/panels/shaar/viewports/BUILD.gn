import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [ "viewports.css" ]
}

devtools_ui_module("viewports") {
  sources = [
    "ViewportsHost.ts",
    "ViewportsModel.ts",
    "ViewportsPanel.ts",
  ]

  ts_deps = [
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../generated",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]

  deps = [ ":css_files" ]
}

devtools_entrypoint("bundle") {
  entrypoint = "viewports.ts"

  # The panel CSS is generated. The inlined bundle has to wait for that file.
  deps = [ ":css_files" ]

  ts_deps = [ ":viewports" ]

  visibility = [
    ":*",
    "..:*",
    "../*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "viewports-meta.ts"

  deps = [ ":css_files" ]

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "..:*",
    "../../../entrypoints/*",
  ]
}

ts_library("unittests") {
  testonly = true

  deps = [ ":css_files" ]

  sources = [
    "ViewportsHost.test.ts",
    "ViewportsModel.test.ts",
    "ViewportsPanel.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../core/sdk:bundle",
    "../../../generated",
    "../../../testing",
    "../../../ui/legacy:bundle",
    "../../../ui/lit:bundle",
  ]
}
