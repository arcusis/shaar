import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../visibility.gni")

devtools_ui_module("shaar") {
  sources = [ "ShaarPanel.ts" ]

  ts_deps = [
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "shaar.ts"

  ts_deps = [ ":shaar" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "shaar-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]
}
