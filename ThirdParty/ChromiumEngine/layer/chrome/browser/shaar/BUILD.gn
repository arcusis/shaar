# BEGIN quit_probe
# Compiled into shaar_layer_unittests by default. A release framework does not
# depend on this target unless shaar_enable_quit_probe_hooks is set.
source_set("quit_probe_hooks") {
  sources = [
    "quit_probe/shaar_quit_probe.mm",
    "quit_probe/shaar_quit_probe.h",
  ]
  cflags_objcc = [ "-fobjc-arc" ]
  frameworks = [ "AppKit.framework" ]
  deps = [
    "//base",
    "//chrome/browser:browser",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles",
    "//chrome/browser/ui/browser_window",
    "//content/browser",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//ui/gfx",
    "//url",
  ]
}
# END quit_probe

