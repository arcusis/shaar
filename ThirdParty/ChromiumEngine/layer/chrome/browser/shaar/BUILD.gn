import("//testing/test.gni")

assert(is_mac)

source_set("engine") {
  public = [ "public/shaar_engine.h" ]
  deps = [
    "//base",
    "//content/public/browser",
    "//net",
    "//ui/base",
    "//url",
  ]
  sources = [
    "engine/shaar_engine.cc",
    "engine/shaar_event_bridge.cc",
    "engine/shaar_event_bridge.h",
    "navigation/shaar_module_registry.h",
    "navigation/shaar_navigation.cc",
    "navigation/shaar_navigation.h",
  ]
}

test("navigation_unittests") {
  sources = [ "navigation/shaar_navigation_unittest.cc" ]
  deps = [
    ":engine",
    "//base",
    "//content/public/browser",
    "//testing/gtest",
    "//testing/gtest:gtest_main",
  ]
}

config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("shaar_engine.exports", root_build_dir) ]
}
