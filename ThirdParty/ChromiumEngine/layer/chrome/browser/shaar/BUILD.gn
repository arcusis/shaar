assert(is_mac)

import("//testing/test.gni")

declare_args() {
  # Private-quit activation and dialog hold. Leave this false for a release
  # framework: the shaar_test_* quit symbols are neither linked nor exported.
  # Unit tests still compile the glue. Set true only for a probe framework.
  shaar_enable_quit_probe_hooks = false
}

