assert(is_mac)

source_set("engine") {
  public = [ "public/shaar_engine.h" ]
  sources = [
    "engine/shaar_engine.cc",
    "engine/shaar_event_bridge.cc",
    "engine/shaar_event_bridge.h",
    # --- lifecycle module ---
    "lifecycle/shaar_lifecycle.cc",
    "lifecycle/shaar_lifecycle.h",
    "lifecycle/shaar_module_registry.cc",
    "lifecycle/shaar_module_registry.h",
  ]
  # --- lifecycle module dependencies ---
  deps = [
    "//base",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser:lifetime",
    "//content/public/browser",
  ]
}

import("//testing/test.gni")

test("lifecycle_unittests") {
  # --- lifecycle module ---
  sources = [ "lifecycle/shaar_module_registry_unittest.cc" ]
  deps = [ ":engine", "//testing/gtest" ]
}

config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("shaar_engine.exports", root_build_dir) ]
}
