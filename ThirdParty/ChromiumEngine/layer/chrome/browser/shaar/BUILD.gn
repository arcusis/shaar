assert(is_mac)

import("//testing/test.gni")

source_set("engine") {
  public = [ "public/shaar_engine.h" ]
  sources = [
    "engine/shaar_engine.cc",
    "engine/shaar_event_bridge.cc",
    "engine/shaar_event_bridge.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui/tabs:tab_strip",
    "//ui/base",
    "//ui/gfx/geometry",
  ]
  sources += [
    "windows-tabs/shaar_module_registry.h",
    "windows-tabs/shaar_windows_tabs.cc",
    "windows-tabs/shaar_windows_tabs.h",
    "windows-tabs/shaar_windows_tabs_handlers.cc",
    "windows-tabs/shaar_windows_tabs_handlers.h",
  ]
}

test("windows_tabs_unittests") {
  sources = [ "windows-tabs/shaar_windows_tabs_handlers_unittest.cc" ]
  deps = [ ":engine", "//base", "//testing/gtest", "//testing/gtest:gtest_main" ]
}

config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("shaar_engine.exports", root_build_dir) ]
}
