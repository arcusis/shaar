config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [
    "-Wl,-exported_symbols_list," +
        rebase_path("shaar_engine.exports", root_build_dir),
    "-Wl,--threads=4",
    "-Wl,--thinlto-jobs=4",
    "-Wl,--read-workers=2",
  ]
  if (shaar_enable_quit_probe_hooks) {
    inputs += [ "shaar_engine_quit_probe.exports" ]
    ldflags += [ "-Wl,-exported_symbols_list," + rebase_path(
                     "shaar_engine_quit_probe.exports", root_build_dir) ]
  }
}
