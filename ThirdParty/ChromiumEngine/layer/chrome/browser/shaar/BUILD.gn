# BEGIN Shaar profiles module build block.
import("//testing/test.gni")
# END Shaar profiles module build block.

assert(is_mac)

source_set("engine") {
  public = [ "public/shaar_engine.h" ]
  sources = [
    "engine/shaar_engine.cc",
    "engine/shaar_event_bridge.cc",
    "engine/shaar_event_bridge.h",
    # BEGIN Shaar profiles module sources.
    "profiles/shaar_profiles.cc",
    "profiles/shaar_profiles.h",
    # END Shaar profiles module sources.
  ]
  deps = [
    # BEGIN Shaar profiles module dependencies.
    "//chrome/browser/profiles",
    "//chrome/browser/ui/browser_window",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/prefs",
    # END Shaar profiles module dependencies.
  ]
}

config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("shaar_engine.exports", root_build_dir) ]
}

# BEGIN Shaar profiles module tests.
test("profiles_unittests") {
  sources = [ "profiles/shaar_profiles_unittest.cc" ]
  deps = [
    ":engine",
    "//testing/gtest",
  ]
}
# END Shaar profiles module tests.
