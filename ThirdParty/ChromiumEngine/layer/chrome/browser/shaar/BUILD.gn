assert(is_mac)

import("//testing/test.gni")

source_set("engine") {
  public = [ "public/shaar_engine.h" ]
  sources = [
    "engine/shaar_engine.cc",
    # BEGIN Shaar engine context.
    "engine/shaar_engine_context.cc",
    "engine/shaar_engine_context.h",
    # END Shaar engine context.
    "engine/shaar_event_bridge.cc",
    "engine/shaar_event_bridge.h",
    # BEGIN Shaar lifecycle module.
    "lifecycle/shaar_lifecycle.cc",
    "lifecycle/shaar_lifecycle.h",
    "lifecycle/shaar_module_registry.cc",
    "engine/shaar_module_registry.h",
    # END Shaar lifecycle module.
    # BEGIN Shaar private sessions module.
    "private_sessions/shaar_private_sessions.h",
    "private_sessions/shaar_private_sessions_module.h",
    "private_sessions/shaar_private_sessions.cc",
    # END Shaar private sessions module.
    # BEGIN Shaar profiles module.
    "profiles/shaar_profiles.cc",
    "profiles/shaar_profiles.h",
    # END Shaar profiles module.
    # BEGIN Shaar windows-tabs module.
    "windows_tabs/shaar_windows_tabs.cc",
    "windows_tabs/shaar_windows_tabs.h",
    "windows_tabs/shaar_windows_tabs_context.h",
    "windows_tabs/shaar_windows_tabs_handlers.cc",
    "windows_tabs/shaar_windows_tabs_handlers.h",
    "windows_tabs/shaar_windows_tabs_lifecycle_adapter.cc",
    # END Shaar windows-tabs module.
    # BEGIN Shaar navigation module.
    "navigation/shaar_navigation_context.h",
    "navigation/shaar_navigation.cc",
    "navigation/shaar_navigation.h",
    "navigation/shaar_navigation_lifecycle_adapter.cc",
    # END Shaar navigation module.
    # BEGIN Shaar downloads module.
    "downloads/shaar_downloads.cc",
    "downloads/shaar_downloads.h",
    "downloads/shaar_downloads_lifecycle_adapter.cc",
    # END Shaar downloads module.
    # BEGIN Shaar bookmarks module.
    "bookmarks/shaar_bookmarks.cc",
    "bookmarks/shaar_bookmarks.h",
    "bookmarks/shaar_bookmarks_lifecycle_adapter.cc",
    # END Shaar bookmarks module.
    # BEGIN Shaar history module.
    "history/shaar_history.cc",
    "history/shaar_history.h",
    "history/shaar_history_lifecycle_adapter.cc",
    # END Shaar history module.
    # BEGIN media
    "media/shaar_media.cc",
    "media/shaar_media.h",
    "media/shaar_media_lifecycle_adapter.cc",
    # END media
  ]
  deps = [
    "//base",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:browser",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser:chrome_content_browser_client",
    # BEGIN media
    "//chrome/browser/content_settings:content_settings_factory",
    # END media
    "//chrome/browser:lifetime",
    "//chrome/browser/profiles",
    "//chrome/browser/history:impl",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tabs",
    "//chrome/browser/download:impl",
    "//chrome/browser/bookmarks:impl",
    "//components/content_settings/core/browser",
    "//components/bookmarks/browser",
    "//components/content_settings/core/common",
    "//components/prefs",
    "//components/history/core/browser",
    "//content/public/browser",
    # BEGIN media
    "//services/media_session/public/cpp",
    "//services/media_session/public/mojom",
    "//components/content_settings/core/browser",
    "//mojo/public/cpp/bindings",
    # END media
    "//components/download/content/public",
    "//components/download/public/common",
    "//extensions/browser",
    "//net",
    "//ui/base",
    "//url",
  ]
}

test("lifecycle_unittests") {
  sources = [ "lifecycle/shaar_module_registry_unittest.cc" ]
  deps = [ ":engine", "//testing/gtest" ]
}

test("private_sessions_unittests") {
  sources = [ "private_sessions/shaar_private_sessions_unittest.cc" ]
  deps = [ ":engine", "//chrome/test:test_support", "//testing/gtest" ]
}

test("profiles_unittests") {
  sources = [ "profiles/shaar_profiles_unittest.cc" ]
  deps = [ ":engine", "//testing/gtest" ]
}

test("windows_tabs_unittests") {
  sources = [ "windows_tabs/shaar_windows_tabs_handlers_unittest.cc" ]
  deps = [ ":engine", "//testing/gtest" ]
}

test("navigation_unittests") {
  sources = [ "navigation/shaar_navigation_unittest.cc" ]
  deps = [ ":engine", "//testing/gtest", "//testing/gtest:gtest_main" ]
}

test("downloads_unittests") {
  sources = [ "downloads/shaar_downloads_unittest.cc" ]
  deps = [ ":engine", "//components/download/public/common:test_support",
           "//testing/gmock", "//testing/gtest" ]
}

test("bookmarks_unittests") {
  sources = [ "bookmarks/shaar_bookmarks_unittest.cc" ]
  deps = [ ":engine", "//base/test:test_support", "//chrome/test:test_support",
           "//components/bookmarks/test", "//content/test:test_support",
           "//testing/gtest" ]
}

test("history_unittests") {
  sources = [ "history/shaar_history_unittest.cc" ]
  deps = [ ":engine", "//base/test:test_support",
           "//components/history/core/browser", "//testing/gtest" ]
}

# BEGIN media
test("media_unittests") {
  sources = [ "media/shaar_media_unittest.cc" ]
  deps = [
    ":engine",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/content_settings/core/browser",
    "//content/public/test:test_support",
    "//testing/gtest",
  ]
}
# END media

config("exports") {
  inputs = [ "shaar_engine.exports" ]
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("shaar_engine.exports", root_build_dir) ]
}
