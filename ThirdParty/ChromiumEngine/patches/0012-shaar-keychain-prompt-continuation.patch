+void CookieMonster::ReleasePendingTasksForShaar() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (finished_fetching_all_cookies_)
+    return;
+  // The persistent read stays in flight. When keychain access is approved,
+  // OnLoaded merges saved cookies into this same CookieMonster. Only requests
+  // waiting for the read are released to the in-memory jar.
+  shaar_pending_load_released_ = true;
+  seen_global_task_ = true;
+  for (auto& [key, tasks] : tasks_pending_for_key_) {
+    tasks_pending_.insert(tasks_pending_.end(),
+                          std::make_move_iterator(tasks.begin()),
+                          std::make_move_iterator(tasks.end()));
+  }
+  tasks_pending_for_key_.clear();
+  while (!tasks_pending_.empty()) {
+    base::OnceClosure task = std::move(tasks_pending_.front());
+    tasks_pending_.pop_front();
+    std::move(task).Run();
+  }
+}
