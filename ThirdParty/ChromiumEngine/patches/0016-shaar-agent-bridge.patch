+    content::DevToolsAgentHostClient*, content::DevToolsAgentHost*);
+extern CONTENT_EXPORT bool (*g_shaar_agent_bridge_may_input)(
+    content::DevToolsAgentHostClient*, content::RenderFrameHost*);
+
+#endif  // CONTENT_PUBLIC_BROWSER_SHAAR_AGENT_BRIDGE_H_
