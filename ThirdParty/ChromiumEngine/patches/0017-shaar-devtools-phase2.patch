+    if (!type || (*type != "largest-contentful-paint" &&
+                  *type != "layout-shift"))
+      return false;
+    data.Set("type", *type);
+    CopyText(&data, "name", *entry, "name", &projection->truncated);
+    if (auto time = entry->FindDouble("time"))
+      data.Set("time", *time);
+    else
+      return false;
+    if (auto duration = entry->FindDouble("duration"))
+      data.Set("duration", *duration);
+    if (*type == "largest-contentful-paint") {
+      const auto* lcp = entry->FindDict("lcpDetails");
+      if (!lcp)
