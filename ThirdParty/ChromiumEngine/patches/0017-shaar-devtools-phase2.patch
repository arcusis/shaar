+bool SameOriginURL(const std::string& value, const std::string& origin) {
+  GURL url(value);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         !url.has_username() && !url.has_password() &&
+         url::Origin::Create(url).Serialize() == origin;
+}
+
+bool BoundedString(const base::DictValue& args, std::string_view key,
+                   size_t maximum = kMaxFieldBytes) {
+  const auto* value = args.FindString(key);
+  return value && !value->empty() && value->size() <= maximum;
+}
+
+bool BoundedStorageText(const base::DictValue& args, std::string_view key,
+                        size_t maximum = kMaxFieldBytes) {
+  const auto* value = args.FindString(key);
+  return value && value->size() <= maximum;
+}
+
+bool BoundedPage(const base::DictValue& args) {
+  auto skip = args.FindInt("skipCount");
+  auto page = args.FindInt("pageSize");
+  return skip && *skip >= 0 && *skip <= 10000 && page &&
+         *page > 0 && *page <= static_cast<int>(kMaxPhase2Rows);
+}
+
+void CopyText(base::DictValue* output, std::string_view target,
+              const base::DictValue& source, std::string_view source_key,
+              bool* truncated) {
+  PutString(output, target, source.FindString(source_key), truncated);
+}
+
+bool BuildPhase2Command(int command_id, const base::DictValue& args,
+                        const std::string& origin,
+                        const std::set<std::string>& cache_ids,
+                        const std::map<std::string, std::set<std::string>>& cache_urls,
+                        const std::set<std::string>& worker_scopes,
+                        const std::set<std::string>& resource_urls,
+                        const std::string& frame_id,
+                        base::DictValue* command) {
+  base::DictValue params;
+  const char* method = nullptr;
+  switch (command_id) {
+    case SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_ITEMS:
+    case SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_SET:
+    case SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_REMOVE:
+    case SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_CLEAR: {
+      if (!args.FindBool("isLocalStorage").has_value())
+        return false;
+      const bool local = *args.FindBool("isLocalStorage");
+      base::DictValue storage;
+      storage.Set("securityOrigin", origin);
+      storage.Set("isLocalStorage", local);
+      params.Set("storageId", std::move(storage));
+      if (command_id == SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_ITEMS) {
+        if (!HasKeys(args, {"isLocalStorage", "skipCount", "pageSize"}) ||
+            !BoundedPage(args))
+          return false;
+        method = "DOMStorage.getDOMStorageItems";
+      } else if (command_id == SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_SET) {
+        if (!HasKeys(args, {"isLocalStorage", "key", "value"}) ||
+            !BoundedStorageText(args, "key") ||
+            !BoundedStorageText(args, "value", 16 * 1024))
+          return false;
+        params.Set("key", *args.FindString("key"));
+        params.Set("value", *args.FindString("value"));
+        method = "DOMStorage.setDOMStorageItem";
+      } else if (command_id == SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_REMOVE) {
+        if (!HasKeys(args, {"isLocalStorage", "key"}) ||
+            !BoundedStorageText(args, "key"))
+          return false;
+        params.Set("key", *args.FindString("key"));
+        method = "DOMStorage.removeDOMStorageItem";
+      } else {
+        if (!HasKeys(args, {"isLocalStorage"}))
+          return false;
+        method = "DOMStorage.clear";
+      }
+      break;
+    }
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_NAMES:
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_SCHEMA:
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_DATA:
+      params.Set("securityOrigin", origin);
+      if (command_id == SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_NAMES) {
+        if (!args.empty())
+          return false;
+        method = "IndexedDB.requestDatabaseNames";
+      } else if (command_id == SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_SCHEMA) {
+        if (!HasKeys(args, {"databaseName"}) ||
+            !BoundedString(args, "databaseName"))
+          return false;
+        params.Set("databaseName", *args.FindString("databaseName"));
+        method = "IndexedDB.requestDatabase";
+      } else {
+        if (!HasKeys(args, {"databaseName", "objectStoreName", "skipCount",
+                            "pageSize"}) ||
+            !BoundedString(args, "databaseName") ||
+            !BoundedString(args, "objectStoreName") || !BoundedPage(args))
+          return false;
+        params.Set("databaseName", *args.FindString("databaseName"));
+        params.Set("objectStoreName", *args.FindString("objectStoreName"));
+        params.Set("skipCount", *args.FindInt("skipCount"));
+        params.Set("pageSize", *args.FindInt("pageSize"));
+        method = "IndexedDB.requestData";
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_NAMES:
+      if (!args.empty())
+        return false;
+      params.Set("securityOrigin", origin);
+      method = "CacheStorage.requestCacheNames";
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_ENTRIES:
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_RESPONSE:
+      if (!BoundedString(args, "cacheID", 256) ||
+          !cache_ids.contains(*args.FindString("cacheID")))
+        return false;
+      params.Set("cacheId", *args.FindString("cacheID"));
+      if (command_id == SHAAR_DEVTOOLS_PHASE2_CACHE_ENTRIES) {
+        if (!HasKeys(args, {"cacheID", "skipCount", "pageSize"}) ||
+            !BoundedPage(args))
+          return false;
+        params.Set("skipCount", *args.FindInt("skipCount"));
+        params.Set("pageSize", *args.FindInt("pageSize"));
+        method = "CacheStorage.requestEntries";
+      } else {
+        auto known_urls = cache_urls.find(*args.FindString("cacheID"));
+        if (!HasKeys(args, {"cacheID", "requestURL"}) ||
+            !BoundedString(args, "requestURL") ||
+            !SameOriginURL(*args.FindString("requestURL"), origin) ||
+            known_urls == cache_urls.end() ||
+            !known_urls->second.contains(*args.FindString("requestURL")))
+          return false;
+        params.Set("requestURL", *args.FindString("requestURL"));
+        params.Set("requestHeaders", base::ListValue());
+        method = "CacheStorage.requestCachedResponse";
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_SERVICE_WORKER_UPDATE:
+    case SHAAR_DEVTOOLS_PHASE2_SERVICE_WORKER_UNREGISTER:
+      if (!HasKeys(args, {"scopeURL"}) ||
+          !BoundedString(args, "scopeURL") ||
+          !SameOriginURL(*args.FindString("scopeURL"), origin) ||
+          !worker_scopes.contains(*args.FindString("scopeURL")))
+        return false;
+      params.Set("scopeURL", *args.FindString("scopeURL"));
+      method = command_id == SHAAR_DEVTOOLS_PHASE2_SERVICE_WORKER_UPDATE
+                   ? "ServiceWorker.updateRegistration"
+                   : "ServiceWorker.unregister";
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_PERFORMANCE_METRICS:
+    case SHAAR_DEVTOOLS_PHASE2_DOM_COUNTERS:
+    case SHAAR_DEVTOOLS_PHASE2_RESOURCE_TREE:
+    case SHAAR_DEVTOOLS_PHASE2_LONG_TASKS:
+    case SHAAR_DEVTOOLS_PHASE2_VITALS_INPUTS:
+      if (!args.empty())
+        return false;
+      if (command_id == SHAAR_DEVTOOLS_PHASE2_PERFORMANCE_METRICS)
+        method = "Performance.getMetrics";
+      else if (command_id == SHAAR_DEVTOOLS_PHASE2_DOM_COUNTERS)
+        method = "Memory.getDOMCounters";
+      else if (command_id == SHAAR_DEVTOOLS_PHASE2_RESOURCE_TREE)
+        method = "Page.getResourceTree";
+      else {
+        method = "Runtime.evaluate";
+        if (command_id == SHAAR_DEVTOOLS_PHASE2_LONG_TASKS) {
+          params.Set("expression",
+                     "JSON.stringify(performance.getEntriesByType('longtask').slice(-50).map(e=>({name:e.name,startTime:e.startTime,duration:e.duration})))");
+        } else {
+          params.Set("expression",
+                     "JSON.stringify({ttfb:performance.getEntriesByType('navigation')[0]?.responseStart,fcp:performance.getEntriesByName('first-contentful-paint')[0]?.startTime,events:performance.getEntriesByType('event').slice(-50).map(e=>({duration:e.duration,startTime:e.startTime,interactionId:e.interactionId}))})");
+        }
+        params.Set("returnByValue", true);
+        params.Set("silent", true);
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_RESOURCE_CONTENT:
+      if (!HasKeys(args, {"resourceURL"}) ||
+          !BoundedString(args, "resourceURL") || frame_id.empty() ||
+          !resource_urls.contains(*args.FindString("resourceURL")) ||
+          !SameOriginURL(*args.FindString("resourceURL"), origin))
+        return false;
+      params.Set("frameId", frame_id);
+      params.Set("url", *args.FindString("resourceURL"));
+      method = "Page.getResourceContent";
+      break;
+    default:
+      return false;
+  }
+  command->Set("method", method);
+  command->Set("params", std::move(params));
+  return true;
+}
+
+bool ProjectPhase2Result(int command_id, const base::DictValue& result,
+                         const base::DictValue& args, const std::string& origin,
+                         std::set<std::string>* cache_ids,
+                         std::map<std::string, std::set<std::string>>* cache_urls,
+                         std::set<std::string>* resource_urls,
+                         std::string* frame_id, std::string* output) {
+  base::DictValue reply;
+  reply.Set("schemaVersion", 1);
+  reply.Set("commandID", command_id);
+  base::ListValue items;
+  bool truncated = false;
+  const base::ListValue* source = nullptr;
+  switch (command_id) {
+    case SHAAR_DEVTOOLS_PHASE2_DOM_STORAGE_ITEMS:
+      source = result.FindList("entries");
+      if (!source)
+        return false;
+      for (size_t i = static_cast<size_t>(*args.FindInt("skipCount"));
+           i < source->size() &&
+           items.size() < static_cast<size_t>(*args.FindInt("pageSize")); ++i) {
+        const auto& row = (*source)[i];
+        if (!row.is_list() || row.GetList().size() != 2 ||
+            !row.GetList()[0].is_string() || !row.GetList()[1].is_string())
+          continue;
+        base::DictValue item;
+        PutString(&item, "key", &row.GetList()[0].GetString(), &truncated);
+        PutString(&item, "value", &row.GetList()[1].GetString(), &truncated);
+        items.Append(std::move(item));
+      }
+      reply.Set("hasMore", source->size() >
+                               static_cast<size_t>(*args.FindInt("skipCount")) +
+                                   items.size());
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_NAMES:
+      source = result.FindList("databaseNames");
+      if (!source)
+        return false;
+      for (const auto& row : *source) {
+        if (items.size() == kMaxPhase2Rows) {
+          truncated = true;
+          break;
+        }
+        if (!row.is_string())
+          continue;
+        base::DictValue item;
+        PutString(&item, "name", &row.GetString(), &truncated);
+        items.Append(std::move(item));
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_SCHEMA: {
+      const auto* database = result.FindDict("databaseWithObjectStores");
+      source = database ? database->FindList("objectStores") : nullptr;
+      if (!source)
+        return false;
+      for (const auto& row : *source) {
+        if (items.size() == kMaxPhase2Rows) {
+          truncated = true;
+          break;
+        }
+        if (!row.is_dict())
+          continue;
+        base::DictValue item;
+        CopyText(&item, "name", row.GetDict(), "name", &truncated);
+        items.Append(std::move(item));
+      }
+      break;
+    }
+    case SHAAR_DEVTOOLS_PHASE2_INDEXED_DB_DATA:
+      source = result.FindList("objectStoreDataEntries");
+      if (!source || source->size() > kMaxPhase2Rows)
+        return false;
+      for (const auto& row : *source) {
+        if (!row.is_dict())
+          continue;
+        base::DictValue item;
+        const auto& entry = row.GetDict();
+        for (const char* field : {"key", "primaryKey", "value"}) {
+          const auto* object = entry.FindDict(field);
+          if (!object)
+            continue;
+          const auto* value = object->FindString("description");
+          if (!value)
+            value = object->FindString("value");
+          PutString(&item, field, value, &truncated);
+        }
+        items.Append(std::move(item));
+      }
+      reply.Set("hasMore", result.FindBool("hasMore").value_or(false));
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_NAMES:
+      source = result.FindList("caches");
+      if (!source)
+        return false;
+      cache_ids->clear();
+      cache_urls->clear();
+      for (const auto& row : *source) {
+        if (items.size() == kMaxPhase2Rows) {
+          truncated = true;
+          break;
+        }
+        if (!row.is_dict())
+          continue;
+        const auto& cache = row.GetDict();
+        const auto* id = cache.FindString("cacheId");
+        const auto* security_origin = cache.FindString("securityOrigin");
+        if (!id || id->size() > 256 || !security_origin ||
+            *security_origin != origin)
+          continue;
+        cache_ids->insert(*id);
+        base::DictValue item;
+        item.Set("cacheID", *id);
+        CopyText(&item, "name", cache, "cacheName", &truncated);
+        items.Append(std::move(item));
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_ENTRIES:
+      source = result.FindList("cacheDataEntries");
+      if (!source || source->size() > kMaxPhase2Rows)
+        return false;
+      (*cache_urls)[*args.FindString("cacheID")].clear();
+      for (const auto& row : *source) {
+        if (!row.is_dict())
+          continue;
+        const auto& entry = row.GetDict();
+        const auto* url = entry.FindString("requestURL");
+        if (!url || !SameOriginURL(*url, origin))
+          continue;
+        (*cache_urls)[*args.FindString("cacheID")].insert(*url);
+        base::DictValue item;
+        CopyText(&item, "url", entry, "requestURL", &truncated);
+        CopyText(&item, "method", entry, "requestMethod", &truncated);
+        if (auto status = entry.FindInt("responseStatus"))
+          item.Set("status", *status);
+        items.Append(std::move(item));
+      }
+      if (auto total = result.FindDouble("returnCount")) {
+        reply.Set("hasMore", *total > *args.FindInt("skipCount") + items.size());
+      } else {
+        reply.Set("hasMore", items.size() == kMaxPhase2Rows);
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_CACHE_RESPONSE: {
+      const auto* response = result.FindDict("response");
+      const auto* body = response ? response->FindString("body") : nullptr;
+      if (!body || body->size() > kMaxBodyBytes)
+        return false;
+      reply.Set("body", *body);
+      reply.Set("base64Encoded", true);
+      break;
+    }
+    case SHAAR_DEVTOOLS_PHASE2_PERFORMANCE_METRICS:
+      source = result.FindList("metrics");
+      if (!source)
+        return false;
+      for (const auto& row : *source) {
+        if (items.size() == 32) {
+          truncated = true;
+          break;
+        }
+        if (!row.is_dict())
+          continue;
+        const auto& metric = row.GetDict();
+        const auto* name = metric.FindString("name");
+        auto value = metric.FindDouble("value");
+        if (!name || !value || !std::isfinite(*value))
+          continue;
+        if (*name != "Timestamp" && *name != "Documents" &&
+            *name != "Nodes" && *name != "JSEventListeners" &&
+            *name != "TaskDuration" && *name != "JSHeapUsedSize" &&
+            *name != "JSHeapTotalSize" && *name != "FirstContentfulPaint" &&
+            *name != "DomContentLoaded" && *name != "NavigationStart")
+          continue;
+        base::DictValue item;
+        item.Set("name", *name);
+        item.Set("value", *value);
+        items.Append(std::move(item));
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_DOM_COUNTERS:
+      for (const char* name : {"documents", "nodes", "jsEventListeners"}) {
+        auto value = result.FindInt(name);
+        if (!value || *value < 0)
+          return false;
+        reply.Set(name, *value);
+      }
+      break;
+    case SHAAR_DEVTOOLS_PHASE2_RESOURCE_TREE: {
+      const auto* tree = result.FindDict("frameTree");
+      const auto* frame = tree ? tree->FindDict("frame") : nullptr;
+      source = tree ? tree->FindList("resources") : nullptr;
+      const auto* id = frame ? frame->FindString("id") : nullptr;
+      if (!id || id->size() > 256 || !source)
+        return false;
+      *frame_id = *id;
+      resource_urls->clear();
+      const auto* document_url = frame->FindString("url");
+      if (document_url && document_url->size() <= kMaxFieldBytes &&
+          SameOriginURL(*document_url, origin)) {
+        resource_urls->insert(*document_url);
+        base::DictValue document;
+        document.Set("url", *document_url);
+        document.Set("type", "Document");
+        items.Append(std::move(document));
+      }
+      for (const auto& row : *source) {
+        if (items.size() == kMaxPhase2Rows) {
+          truncated = true;
+          break;
+        }
+        if (!row.is_dict())
+          continue;
+        const auto& resource = row.GetDict();
+        const auto* url = resource.FindString("url");
+        if (!url || url->size() > kMaxFieldBytes ||
+            !SameOriginURL(*url, origin))
+          continue;
+        resource_urls->insert(*url);
+        base::DictValue item;
+        item.Set("url", *url);
+        CopyText(&item, "type", resource, "type", &truncated);
+        CopyText(&item, "mimeType", resource, "mimeType", &truncated);
+        items.Append(std::move(item));
+      }
+      break;
+    }
+    case SHAAR_DEVTOOLS_PHASE2_RESOURCE_CONTENT: {
+      const auto* content = result.FindString("content");
+      if (!content || content->size() > kMaxBodyBytes)
+        return false;
+      reply.Set("body", *content);
+      reply.Set("base64Encoded", result.FindBool("base64Encoded").value_or(false));
+      break;
+    }
+    case SHAAR_DEVTOOLS_PHASE2_LONG_TASKS:
+    case SHAAR_DEVTOOLS_PHASE2_VITALS_INPUTS: {
+      const auto* remote = result.FindDict("result");
+      const auto* json = remote ? remote->FindString("value") : nullptr;
+      if (!json || json->size() > kMaxPhase2ReplyBytes)
+        return false;
+      auto parsed = base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+      if (!parsed)
+        return false;
+      if (command_id == SHAAR_DEVTOOLS_PHASE2_LONG_TASKS) {
+        if (!parsed->is_list() || parsed->GetList().size() > kMaxPhase2Rows)
+          return false;
+        for (const auto& row : parsed->GetList()) {
+          if (!row.is_dict())
+            continue;
+          const auto& task = row.GetDict();
+          auto start = task.FindDouble("startTime");
+          auto duration = task.FindDouble("duration");
+          if (!start || !duration || !std::isfinite(*start) ||
+              !std::isfinite(*duration) || *duration < 0)
+            continue;
+          base::DictValue item;
+          CopyText(&item, "name", task, "name", &truncated);
+          item.Set("startTime", *start);
+          item.Set("duration", *duration);
+          items.Append(std::move(item));
+        }
+      } else {
+        if (!parsed->is_dict())
+          return false;
+        const auto& vitals = parsed->GetDict();
+        for (const char* field : {"ttfb", "fcp"}) {
+          auto value = vitals.FindDouble(field);
+          if (!value || !std::isfinite(*value) || *value < 0)
+            continue;
+          base::DictValue item;
+          item.Set("name", field);
+          item.Set("value", *value);
+          items.Append(std::move(item));
+        }
+        const auto* events = vitals.FindList("events");
+        if (events && events->size() > kMaxPhase2Rows)
+          return false;
+        if (events) {
+          for (const auto& row : *events) {
+            if (items.size() == kMaxPhase2Rows) {
+              truncated = true;
+              break;
+            }
+            if (!row.is_dict())
+              continue;
+            const auto& event = row.GetDict();
+            auto start = event.FindDouble("startTime");
+            auto duration = event.FindDouble("duration");
+            auto interaction = event.FindInt("interactionId");
+            if (!start || !duration || !interaction ||
+                !std::isfinite(*start) || !std::isfinite(*duration) ||
+                *duration < 0 || *interaction <= 0)
+              continue;
+            base::DictValue item;
+            item.Set("name", "event");
+            item.Set("startTime", *start);
+            item.Set("duration", *duration);
+            item.Set("interactionID", *interaction);
+            items.Append(std::move(item));
+          }
+        }
+      }
+      break;
+    }
+    default:
+      if (!result.empty())
+        return false;
+      break;
+  }
+  reply.Set("items", std::move(items));
+  reply.Set("truncated", truncated);
+  return base::JSONWriter::Write(base::Value(std::move(reply)), output) &&
+         output->size() <= (command_id == SHAAR_DEVTOOLS_PHASE2_CACHE_RESPONSE ||
+                                    command_id == SHAAR_DEVTOOLS_PHASE2_RESOURCE_CONTENT
+                                ? kMaxBodyBytes + 1024
+                                : kMaxPhase2ReplyBytes);
+}
+
+bool ProjectPhase2Event(std::string_view method, const base::DictValue& params,
+                        const std::string& origin, Projection* projection,
+                        std::set<std::string>* worker_scopes) {
+  auto& data = projection->data;
+  if (method.starts_with("DOMStorage.")) {
+    const auto* storage = params.FindDict("storageId");
+    const auto* security_origin = storage ? storage->FindString("securityOrigin") : nullptr;
+    auto local = storage ? storage->FindBool("isLocalStorage") : std::nullopt;
+    if (!security_origin || *security_origin != origin || !local)
+      return false;
+    data.Set("isLocalStorage", *local);
+    if (method == "DOMStorage.domStorageItemAdded") {
+      projection->id = SHAAR_DEVTOOLS_PANEL_DOM_STORAGE_ADDED;
+      CopyText(&data, "key", params, "key", &projection->truncated);
+      CopyText(&data, "value", params, "newValue", &projection->truncated);
+    } else if (method == "DOMStorage.domStorageItemUpdated") {
+      projection->id = SHAAR_DEVTOOLS_PANEL_DOM_STORAGE_UPDATED;
+      CopyText(&data, "key", params, "key", &projection->truncated);
+      CopyText(&data, "value", params, "newValue", &projection->truncated);
+    } else if (method == "DOMStorage.domStorageItemRemoved") {
+      projection->id = SHAAR_DEVTOOLS_PANEL_DOM_STORAGE_REMOVED;
