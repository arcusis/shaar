+      if (auto value = shift->FindDouble("value"))
+        data.Set("value", *value);
+      data.Set("hadRecentInput", shift->FindBool("hadRecentInput").value_or(false));
+    }
+  } else {
+    return false;
+  }
+  data.Set("truncated", projection->truncated);
+  return true;
