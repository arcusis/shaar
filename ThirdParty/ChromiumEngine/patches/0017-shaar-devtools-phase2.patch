+      CopyText(&item, "scriptURL", version, "scriptURL", &projection->truncated);
+      CopyText(&item, "registrationID", version, "registrationId", &projection->truncated);
+      CopyText(&item, "versionID", version, "versionId", &projection->truncated);
+      CopyText(&item, "status", version, "status", &projection->truncated);
+      CopyText(&item, "runningStatus", version, "runningStatus", &projection->truncated);
