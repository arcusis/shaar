+  base::DictValue command;
+  if (!BuildPhase2Command(command_id, parsed->GetDict(), std::string(origin),
+                          {}, {}, {}, {}, {}, &command))
+    return false;
+  return base::JSONWriter::Write(base::Value(std::move(command)), output);
+}
