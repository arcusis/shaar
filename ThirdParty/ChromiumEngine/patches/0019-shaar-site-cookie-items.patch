+content::WebContents* SelectedCookieTab(
+    shaar::ShaarEngineContext* context, shaar_engine* engine,
+    shaar_window* window, shaar_tab* tab, Profile* profile,
+    const GURL& origin, shaar_error* error) {
+  if (!window || !tab || !context->browser_tabs) {
+    Fail(error, SHAAR_INVALID_ARGUMENT, "selected tab and window are required");
+    return nullptr;
+  }
+  Browser* browser = context->browser_tabs->FindBrowser(engine, window);
+  content::WebContents* contents =
+      context->browser_tabs->FindWebContents(engine, window, tab);
+  if (!browser || !contents || !browser->tab_strip_model()) {
+    Fail(error, SHAAR_NOT_FOUND, "selected tab is no longer available");
+    return nullptr;
+  }
+  if (browser->tab_strip_model()->GetActiveWebContents() != contents) {
+    Fail(error, SHAAR_CONFLICT, "tab is no longer selected");
+    return nullptr;
+  }
+  if (contents->GetBrowserContext() != profile) {
+    Fail(error, SHAAR_WRONG_PROFILE, "selected tab belongs to another profile");
+    return nullptr;
+  }
+  const GURL current = contents->GetLastCommittedURL();
+  if (!current.SchemeIsHTTPOrHTTPS() ||
+      url::Origin::Create(current) != url::Origin::Create(origin)) {
+    Fail(error, SHAAR_CONFLICT, "selected tab origin has changed");
+    return nullptr;
+  }
+  return contents;
+}
+
+bool CookieIdentityMatches(const net::CanonicalCookie& cookie, const Dict& args) {
+  const std::string* name = args.FindString("name");
+  const std::string* domain = args.FindString("domain");
+  const std::string* path = args.FindString("path");
+  const base::Value* site = args.Find("partitionSite");
+  const base::Value* cross_site = args.Find("partitionCrossSite");
+  auto source_scheme = args.FindInt("sourceScheme");
+  auto source_port = args.FindInt("sourcePort");
+  if (!name || !domain || !path || !site || !cross_site ||
+      !source_scheme || !source_port ||
+      cookie.Name() != *name || cookie.Domain() != *domain ||
+      cookie.Path() != *path ||
+      static_cast<int>(cookie.SourceScheme()) != *source_scheme ||
+      cookie.SourcePort() != *source_port)
+    return false;
+  if (site->is_none() && cross_site->is_none())
+    return !cookie.IsPartitioned();
+  if (!site->is_string() || !cross_site->is_bool() || !cookie.IsPartitioned())
+    return false;
+  auto key = net::CookiePartitionKey::Serialize(cookie.PartitionKey());
+  return key.has_value() && key->TopLevelSite() == site->GetString() &&
+         key->has_cross_site_ancestor() == cross_site->GetBool();
+}
+
+std::string CookieSameSiteName(net::CookieSameSite value) {
+  switch (value) {
+    case net::CookieSameSite::STRICT_MODE: return "Strict";
+    case net::CookieSameSite::LAX_MODE: return "Lax";
+    case net::CookieSameSite::NO_RESTRICTION: return "None";
+    case net::CookieSameSite::UNSPECIFIED: return "Unspecified";
+  }
+  return "Unspecified";
+}
+
+std::optional<net::CookieSameSite> ParseCookieSameSite(std::string_view value) {
+  if (value == "Strict") return net::CookieSameSite::STRICT_MODE;
+  if (value == "Lax") return net::CookieSameSite::LAX_MODE;
+  if (value == "None") return net::CookieSameSite::NO_RESTRICTION;
+  if (value == "Unspecified") return net::CookieSameSite::UNSPECIFIED;
+  return std::nullopt;
+}
+
+std::optional<Dict> CookieItem(const net::CanonicalCookie& cookie) {
+  Dict item;
+  item.Set("name", cookie.Name());
+  item.Set("value", cookie.Value());
+  item.Set("domain", cookie.Domain());
+  item.Set("path", cookie.Path());
+  item.Set("secure", cookie.SecureAttribute());
+  item.Set("httpOnly", cookie.IsHttpOnly());
+  item.Set("sameSite", CookieSameSiteName(cookie.SameSite()));
+  item.Set("sourceScheme", static_cast<int>(cookie.SourceScheme()));
+  item.Set("sourcePort", cookie.SourcePort());
+  item.Set("expiresUnixMs", cookie.IsPersistent()
+      ? base::Value(static_cast<double>(
+            cookie.ExpiryDate().InMillisecondsSinceUnixEpoch()))
+      : base::Value());
+  if (cookie.IsPartitioned()) {
+    auto key = net::CookiePartitionKey::Serialize(cookie.PartitionKey());
+    if (!key.has_value()) return std::nullopt;
+    item.Set("partitionSite", key->TopLevelSite());
+    item.Set("partitionCrossSite", key->has_cross_site_ancestor());
+  } else {
+    item.Set("partitionSite", base::Value());
+    item.Set("partitionCrossSite", base::Value());
+  }
+  return item;
 }
 
