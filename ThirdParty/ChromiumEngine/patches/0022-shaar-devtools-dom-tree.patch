+bool CopyDOMNode(const base::DictValue* node, base::DictValue* copy,
+                 bool* truncated) {
+  if (!node || !node->FindInt("nodeId") || !node->FindInt("nodeType") ||
+      !node->FindString("nodeName"))
+    return false;
+  copy->Set("nodeId", *node->FindInt("nodeId"));
+  copy->Set("nodeType", *node->FindInt("nodeType"));
+  PutString(copy, "nodeName", node->FindString("nodeName"), truncated);
+  PutString(copy, "nodeValue", node->FindString("nodeValue"), truncated);
+  if (auto count = node->FindInt("childNodeCount"))
+    copy->Set("childNodeCount", *count);
+  if (const auto* attributes = node->FindList("attributes")) {
+    base::ListValue values;
+    for (const auto& value : *attributes) {
+      if (!value.is_string() || values.size() == 32) {
+        *truncated = true;
+        break;
+      }
+      values.Append(Clipped(&value.GetString(), truncated));
+    }
+    copy->Set("attributes", std::move(values));
+  }
+  return true;
+}
