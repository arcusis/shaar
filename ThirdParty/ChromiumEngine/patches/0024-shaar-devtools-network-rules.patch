+base::ListValue MergeHeaders(const base::ListValue& existing,
+                             const base::ListValue& changes) {
+  base::ListValue merged;
+  for (const auto& item : existing) {
+    const auto* name = item.is_dict() ? item.GetDict().FindString("name") : nullptr;
+    if (!name)
+      continue;
+    bool replaced = false;
+    for (const auto& change : changes) {
+      const auto* replacement = change.GetDict().FindString("name");
+      if (replacement && base::EqualsCaseInsensitiveASCII(*name, *replacement)) {
+        replaced = true;
+        break;
+      }
+    }
+    if (!replaced)
+      merged.Append(item.Clone());
+  }
+  for (const auto& item : changes)
+    merged.Append(item.Clone());
+  return merged;
+}
+
+base::ListValue RequestHeaders(const base::DictValue& source) {
+  base::ListValue headers;
+  for (const auto item : source) {
+    if (!item.second.is_string())
