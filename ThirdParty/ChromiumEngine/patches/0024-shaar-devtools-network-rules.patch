+      !status || !delay || !ValidRuleURL(*url) ||
+      *status < 100 || *status > 599 || *delay < 0 || *delay > 30000 ||
+      headers->size() > 32 || body->size() > 1398104)
+    return false;
+  if (*method != "GET" && *method != "POST" && *method != "PUT" &&
+      *method != "PATCH" && *method != "DELETE" && *method != "HEAD" &&
+      *method != "OPTIONS")
+    return false;
+  if (*kind != "mock" && *kind != "redirect" && *kind != "delay" &&
+      *kind != "requestHeaders" && *kind != "responseHeaders")
+    return false;
+  for (const auto& header : *headers) {
+    if (!header.is_dict() || !HasKeys(header.GetDict(), {"name", "value"}))
+      return false;
