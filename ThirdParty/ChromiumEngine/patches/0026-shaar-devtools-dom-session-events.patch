+bool HasDOMPanelLeaseForHost(content::DevToolsAgentHost* host) {
+  if (!host)
+    return false;
+  auto found = Leases().find(host->GetWebContents());
+  return found != Leases().end() && found->second->host() == host;
+}
+
+void RouteDOMPanelEventForProtocolHost(content::DevToolsAgentHost* host,
+                                       std::string_view message) {
+  if (!HasDOMPanelLeaseForHost(host) || message.size() > kMaxEventInputBytes)
+    return;
+  auto parsed = base::JSONReader::Read(message, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict())
+    return;
+  const auto* method = parsed->GetDict().FindString("method");
+  const auto* params = parsed->GetDict().FindDict("params");
+  if (!method || method->rfind("DOM.", 0) != 0 || !params)
+    return;
+  auto found = Leases().find(host->GetWebContents());
+  if (found != Leases().end())
+    found->second->ReceiveDOMEvent(*method, *params);
+}
 
