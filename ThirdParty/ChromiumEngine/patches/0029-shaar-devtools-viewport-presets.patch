+bool IsPortraitPreset(std::string_view name, int width, int height) {
+  if (name == "iphone15Pro")
+    return width == 393 && height == 852;
+  if (name == "ipad")
+    return width == 820 && height == 1180;
+  if (name == "pixel8")
+    return width == 412 && height == 915;
+  if (name == "desktop")
+    return width == 1280 && height == 800;
+  if (name == "desktop1440")
+    return width == 1440 && height == 900;
+  return false;
+}
+
+bool IsLandscapePreset(std::string_view name, int width, int height) {
+  return ValidPreset(name, width, height) && !IsPortraitPreset(name, width, height);
+}
+
+bool IsDesktopPreset(std::string_view name) {
+  return name == "desktop" || name == "desktop1440";
+}
