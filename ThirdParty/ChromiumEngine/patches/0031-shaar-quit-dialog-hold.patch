+TEST(ShaarDevToolsTest, PageDisableAndJavaScriptDialogStayOutsideTheDomTreeIds) {
+  for (const std::string args : {
+           R"({"schemaVersion":1,"capability":2,"command":62,"params":{}})",
+           R"({"schemaVersion":1,"capability":1,"command":62,"params":{}})"}) {
+    std::string output;
+    std::string reason;
+    EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 62, &output, &reason))
+        << reason;
+    EXPECT_NE(std::string::npos, output.find("Page.disable"));
+  }
+  std::string output;
+  std::string reason;
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":62,"params":{"extra":true}})"),
+      62, &output, &reason));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":63,"params":{"accept":false}})"),
+      63, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Page.handleJavaScriptDialog"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":63,"params":{"accept":false,"promptText":""}})"),
+      63, &output, &reason)) << reason;
+  EXPECT_EQ(nullptr, ProtocolMethod(
+      SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+      SHAAR_DEVTOOLS_PAGE_HANDLE_JAVASCRIPT_DIALOG));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":63,"params":{"accept":false}})"),
+      63, &output, &reason));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":63,"params":{}})"),
+      63, &output, &reason));
+  EXPECT_EQ("DevTools command is missing required parameters", reason);
+  for (const char* args : {
+           R"({"schemaVersion":1,"capability":2,"command":45,"params":{}})",
+           R"({"schemaVersion":1,"capability":2,"command":61,"params":{}})"}) {
+    EXPECT_EQ(SHAAR_INVALID_ARGUMENT,
+              EncodeProtocolRequest(Bytes(args), 45, &output, &reason));
+    EXPECT_EQ("unknown DevTools capability or command", reason);
+  }
+}
