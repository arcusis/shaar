+class HoldingEvaluateHost final : public content::MockDevToolsAgentHost {
+ public:
+  void DispatchProtocolMessage(content::DevToolsAgentHostClient* client,
+                               base::span<const uint8_t> message) override {
+    client_ = client;
+    auto parsed = base::JSONReader::Read(
+        std::string_view(reinterpret_cast<const char*>(message.data()),
+                         message.size()),
+        base::JSON_PARSE_RFC);
+    ASSERT_TRUE(parsed && parsed->is_dict());
+    const auto& command = parsed->GetDict();
+    const auto* method = command.FindString("method");
+    ASSERT_NE(nullptr, method);
+    if (*method == "Runtime.enable") {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HoldingEvaluateHost::SendContext,
+                                    base::WrapRefCounted(this)));
+      return;
+    }
+    methods_.push_back(*method);
+    if (*method == "Runtime.evaluate") {
+      evaluate_id_ = command.FindInt("id");
+      return;
+    }
+    const int id = command.FindInt("id").value_or(0);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HoldingEvaluateHost::SendResult,
+                                  base::WrapRefCounted(this), id));
+  }
+
+  void ReplyToEvaluate() {
+    if (evaluate_id_)
+      SendResult(*evaluate_id_);
+  }
+
+  const std::vector<std::string>& methods() const { return methods_; }
+
+ private:
+  ~HoldingEvaluateHost() override = default;
+
+  void SendContext() {
+    if (!client_)
+      return;
+    const std::string message =
+        R"({"method":"Runtime.executionContextCreated","params":{"context":{"id":27,"auxData":{"frameId":"main-frame","isDefault":true}}}})";
+    client_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+
+  void SendResult(int id) {
+    if (!client_)
+      return;
+    const std::string message =
+        "{\"id\":" + std::to_string(id) + ",\"result\":{}}";
+    client_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+
+  content::DevToolsAgentHostClient* client_ = nullptr;
+  std::vector<std::string> methods_;
+  std::optional<int> evaluate_id_;
+};
+
+TEST(ShaarDevToolsTest, AwaitPromiseEvaluateParksSoTheNextCommandCanRun) {
+  base::test::TaskEnvironment tasks;
+  auto host = base::MakeRefCounted<HoldingEvaluateHost>();
+  CapturedReply hold;
+  CapturedReply next;
+  ASSERT_TRUE(StartProtocolRequest(
+      host, 7, &CaptureReply, &hold,
+      R"({"id":7,"method":"Runtime.evaluate","params":{"expression":"new Promise(()=>{})","awaitPromise":true}})",
+      "main-frame"));
+  ASSERT_TRUE(StartProtocolRequest(
+      host, 8, &CaptureReply, &next,
+      R"({"id":8,"method":"Page.disable","params":{}})"));
+  tasks.RunUntilIdle();
+  ASSERT_EQ(2u, host->methods().size());
+  EXPECT_EQ("Runtime.evaluate", host->methods()[0]);
+  EXPECT_EQ("Page.disable", host->methods()[1]);
+  EXPECT_EQ(SHAAR_OK, next.code);
+  EXPECT_EQ(SHAAR_CHROMIUM_ERROR, hold.code);
+  host->ReplyToEvaluate();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(SHAAR_OK, hold.code);
+  CloseProtocolSessionForTesting(host.get());
+}
+
+TEST(ShaarDevToolsTest, EvaluateWithoutAwaitPromiseStaysSerial) {
+  base::test::TaskEnvironment tasks;
+  auto host = base::MakeRefCounted<HoldingEvaluateHost>();
+  CapturedReply hold;
+  CapturedReply next;
+  ASSERT_TRUE(StartProtocolRequest(
+      host, 7, &CaptureReply, &hold,
+      R"({"id":7,"method":"Runtime.evaluate","params":{"expression":"1"}})",
+      "main-frame"));
+  ASSERT_TRUE(StartProtocolRequest(
+      host, 8, &CaptureReply, &next,
+      R"({"id":8,"method":"Page.disable","params":{}})"));
+  tasks.RunUntilIdle();
+  ASSERT_EQ(1u, host->methods().size());
+  EXPECT_EQ("Runtime.evaluate", host->methods()[0]);
+  EXPECT_EQ(SHAAR_CHROMIUM_ERROR, next.code);
+  host->ReplyToEvaluate();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(SHAAR_OK, hold.code);
+  ASSERT_EQ(2u, host->methods().size());
+  EXPECT_EQ("Page.disable", host->methods()[1]);
+  EXPECT_EQ(SHAAR_OK, next.code);
+  CloseProtocolSessionForTesting(host.get());
+}
