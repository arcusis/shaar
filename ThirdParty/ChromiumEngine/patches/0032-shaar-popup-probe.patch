+bool LowercasePopupID(std::string_view popup_id) {
+  if (popup_id.size() != 36)
+    return false;
+  for (size_t index = 0; index < popup_id.size(); ++index) {
+    const char character = popup_id[index];
+    const bool dash_slot = index == 8 || index == 13 || index == 18 || index == 23;
+    if (dash_slot) {
+      if (character != '-')
+        return false;
+      continue;
+    }
+    if (character < '0' || (character > '9' && character < 'a') || character > 'f')
+      return false;
+  }
+  return true;
+}
+
+bool ParseProbePopupArguments(shaar_bytes args_json, bool evaluate,
+                              std::string* popup_id, std::string* expression) {
+  if (!popup_id || (evaluate && !expression) || !args_json.data ||
+      args_json.size == 0 || args_json.size > 16384)
+    return false;
+  auto value = base::JSONReader::Read(
+      std::string_view(args_json.data, args_json.size), base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict() ||
+      value->GetDict().FindInt("schemaVersion") != 1)
+    return false;
+  const base::DictValue& dict = value->GetDict();
+  if (evaluate) {
+    if (!ExactKeys(dict, {"schemaVersion", "popupId", "expression"}))
+      return false;
+  } else if (!ExactKeys(dict, {"schemaVersion", "popupId"})) {
+    return false;
+  }
+  const std::string* id = dict.FindString("popupId");
+  if (!id || !LowercasePopupID(*id))
+    return false;
+  *popup_id = *id;
+  if (!evaluate)
+    return true;
+  const std::string* script = dict.FindString("expression");
+  if (!script || script->empty() || script->size() > 8192)
+    return false;
+  *expression = *script;
+  return true;
+}
