+bool ForcedPseudoClassListIsValid(const base::DictValue& params) {
+  const base::ListValue* classes = params.FindList("forcedPseudoClasses");
+  if (!classes)
+    return true;
+  if (classes->size() > 5)
+    return false;
+  bool seen_hover = false;
+  bool seen_active = false;
+  bool seen_focus = false;
+  bool seen_focus_visible = false;
+  bool seen_focus_within = false;
+  for (const base::Value& item : *classes) {
+    if (!item.is_string())
+      return false;
+    const std::string& name = item.GetString();
+    bool* seen = nullptr;
+    if (name == "hover")
+      seen = &seen_hover;
+    else if (name == "active")
+      seen = &seen_active;
+    else if (name == "focus")
+      seen = &seen_focus;
+    else if (name == "focus-visible")
+      seen = &seen_focus_visible;
+    else if (name == "focus-within")
+      seen = &seen_focus_within;
+    else
+      return false;
+    if (*seen)
+      return false;
+    *seen = true;
+  }
+  return true;
 }
 
