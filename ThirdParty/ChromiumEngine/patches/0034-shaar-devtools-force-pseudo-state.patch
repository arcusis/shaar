+TEST(ShaarDevToolsTest, ForcePseudoStateIsInspectorOnlyAndCommand64) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["hover","focus-visible"]}})"),
+      64, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("CSS.forcePseudoState"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":[]}})"),
+      64, &output, &reason)) << reason;
+  EXPECT_STREQ("CSS.forcePseudoState",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                              SHAAR_DEVTOOLS_CSS_FORCE_PSEUDO_STATE));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                           SHAAR_DEVTOOLS_CSS_FORCE_PSEUDO_STATE));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":62,"params":{}})"),
+      62, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Page.disable"));
+  EXPECT_EQ(std::string::npos, output.find("CSS.forcePseudoState"));
+  for (const char* args : {
+           R"({"schemaVersion":1,"capability":2,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["hover"]}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["target"]}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["hover","hover"]}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["hover","active","focus","focus-visible","focus-within","hover"]}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"forcedPseudoClasses":["hover"]}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7}})",
+           R"({"schemaVersion":1,"capability":1,"command":64,"params":{"nodeId":7,"forcedPseudoClasses":["hover"],"extra":true}})",
+           R"({"schemaVersion":1,"capability":1,"command":62,"params":{"nodeId":7,"forcedPseudoClasses":["hover"]}})"}) {
+    EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 64, &output, &reason))
+        << args;
+  }
+}
