+}
+
+TEST(ShaarDevToolsTest, TouchEmulationIsDeveloperOnlyAndCommand65) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":65,"params":{"enabled":true}})"),
+      65, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Emulation.setTouchEmulationEnabled"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":65,"params":{"enabled":false}})"),
+      65, &output, &reason)) << reason;
+  EXPECT_STREQ("Emulation.setTouchEmulationEnabled",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_EMULATION_SET_TOUCH_EMULATION_ENABLED));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_EMULATION_SET_TOUCH_EMULATION_ENABLED));
+  for (const char* args : {
+           R"({"schemaVersion":1,"capability":1,"command":65,"params":{"enabled":true}})",
+           R"({"schemaVersion":1,"capability":2,"command":65,"params":{}})",
+           R"({"schemaVersion":1,"capability":2,"command":65,"params":{"enabled":true,"extra":1}})",
+           R"({"schemaVersion":1,"capability":2,"command":66,"params":{"enabled":true}})"}) {
+    EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 65, &output, &reason))
         << args;
   }
 }
