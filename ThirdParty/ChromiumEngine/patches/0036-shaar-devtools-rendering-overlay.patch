+TEST(ShaarDevToolsTest, RenderingOverlayCommandsAreDeveloperOnly) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":19,"params":{}})"),
+      19, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Overlay.enable"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":20,"params":{}})"),
+      20, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Overlay.disable"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":66,"params":{"result":true}})"),
+      66, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Overlay.setShowPaintRects"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":67,"params":{"result":false}})"),
+      67, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Overlay.setShowLayoutShiftRegions"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":68,"params":{"show":true}})"),
+      68, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Overlay.setShowFPSCounter"));
+  EXPECT_STREQ("Overlay.setShowPaintRects",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_OVERLAY_SET_SHOW_PAINT_RECTS));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_OVERLAY_SET_SHOW_PAINT_RECTS));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":66,"params":{}})"),
+      66, &output, &reason));
+  EXPECT_EQ("DevTools command is missing required parameters", reason);
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":66,"params":{"result":true,"extra":true}})"),
+      66, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":68,"params":{"result":true}})"),
+      68, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":66,"params":{"result":true}})"),
+      66, &output, &reason));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":69,"params":{}})"),
+      69, &output, &reason));
+  EXPECT_EQ("unknown DevTools capability or command", reason);
+}
