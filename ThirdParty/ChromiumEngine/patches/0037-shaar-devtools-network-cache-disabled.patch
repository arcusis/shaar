+TEST(ShaarDevToolsTest, CacheDisabledIsDeveloperOnlyAndCommand69) {
+  EXPECT_STREQ("Network.setCacheDisabled",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_NETWORK_SET_CACHE_DISABLED));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_NETWORK_SET_CACHE_DISABLED));
+  const std::string allowed =
+      R"({"schemaVersion":1,"capability":2,"command":69,"params":{"cacheDisabled":true}})";
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(Bytes(allowed), 44, &output, &reason))
+      << reason;
+  EXPECT_NE(std::string::npos, output.find("Network.setCacheDisabled"));
+  EXPECT_NE(std::string::npos, output.find("cacheDisabled"));
+  for (const std::string args : {
+           R"({"schemaVersion":1,"capability":1,"command":69,"params":{"cacheDisabled":true}})",
+           R"({"schemaVersion":1,"capability":2,"command":69,"params":{}})",
+           R"({"schemaVersion":1,"capability":2,"command":69,"params":{"cacheDisabled":true,"extra":1}})",
+           R"({"schemaVersion":1,"capability":2,"command":70,"params":{"cacheDisabled":true}})"}) {
+    std::string rejected;
+    std::string rejectReason;
+    EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 44, &rejected, &rejectReason));
+    EXPECT_TRUE(rejected.empty());
+  }
 }
 
