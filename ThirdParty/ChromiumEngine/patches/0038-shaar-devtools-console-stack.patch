+TEST(ShaarDevToolsPanelTest, ProjectsBoundedConsoleStack) {
+  std::string output;
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Runtime.consoleAPICalled","params":{"type":"log","args":[{"value":"plain"}]}})",
+      4, &output));
+  EXPECT_EQ(std::string::npos, output.find("stack"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Runtime.consoleAPICalled","params":{"type":"error","args":[{"value":"boom"}],"stackTrace":{"callFrames":[{"functionName":"loadOrders","url":"http://127.0.0.1/orders.ts","lineNumber":16,"columnNumber":2,"scriptId":"secret"},{"functionName":"","url":"","lineNumber":3}],"parent":{"secret":"not-projected"}},"secret":"not-projected"}})",
+      4, &output));
+  EXPECT_EQ(std::string::npos, output.find("not-projected"));
+  EXPECT_EQ(std::string::npos, output.find("columnNumber"));
+  EXPECT_EQ(std::string::npos, output.find("scriptId"));
+  auto parsed = base::JSONReader::Read(output, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed && parsed->is_dict());
+  const auto* data = parsed->GetDict().FindDict("data");
+  ASSERT_NE(nullptr, data);
+  const auto* stack = data->FindList("stack");
+  ASSERT_NE(nullptr, stack);
+  ASSERT_EQ(2u, stack->size());
+  EXPECT_EQ("loadOrders", *stack->front().GetDict().FindString("function"));
+  EXPECT_EQ("http://127.0.0.1/orders.ts:17",
+            *stack->front().GetDict().FindString("source"));
+  EXPECT_EQ("(anonymous)", *stack->back().GetDict().FindString("function"));
+  EXPECT_EQ("(unknown):4", *stack->back().GetDict().FindString("source"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Runtime.exceptionThrown","params":{"exceptionDetails":{"text":"Error","stackTrace":{"callFrames":[{"functionName":"raise","url":"app.js","lineNumber":0}]}}}})",
+      4, &output));
+  EXPECT_NE(std::string::npos, output.find("raise"));
+  EXPECT_NE(std::string::npos, output.find("app.js:1"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Log.entryAdded","params":{"entry":{"text":"late","level":"warning","stackTrace":{"callFrames":[{"functionName":"logLine","url":"log.js","lineNumber":8}]}}}})",
+      4, &output));
+  EXPECT_NE(std::string::npos, output.find("logLine"));
+  EXPECT_NE(std::string::npos, output.find("log.js:9"));
+  std::string frames = R"([)";
+  for (int index = 0; index < 9; ++index) {
+    if (index)
+      frames += ",";
+    frames += R"({"functionName":"frame","url":"app.js","lineNumber":)" +
+              std::to_string(index) + "}";
+  }
+  frames += "]";
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Runtime.consoleAPICalled","params":{"type":"log","args":[{"value":"many"}],"stackTrace":{"callFrames":)" +
+          frames + "}}}",
+      4, &output));
+  parsed = base::JSONReader::Read(output, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed && parsed->is_dict());
+  data = parsed->GetDict().FindDict("data");
+  ASSERT_NE(nullptr, data);
+  stack = data->FindList("stack");
+  ASSERT_NE(nullptr, stack);
+  EXPECT_EQ(8u, stack->size());
+  EXPECT_EQ(true, data->FindBool("truncated"));
+}
