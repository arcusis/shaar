+std::string ClipTo(std::string value, size_t limit, bool* truncated) {
+  if (value.size() <= limit)
+    return value;
+  *truncated = true;
+  value.resize(limit);
+  while (!value.empty() &&
+         (static_cast<unsigned char>(value.back()) & 0xc0) == 0x80)
+    value.pop_back();
+  return value;
+}
+
+void CopyConsoleStack(base::DictValue* data, const base::DictValue* trace,
+                      bool* truncated) {
+  if (!trace)
+    return;
+  const auto* frames = trace->FindList("callFrames");
+  if (!frames)
+    return;
+  base::ListValue stack;
+  for (const auto& item : *frames) {
+    if (stack.size() == kMaxConsoleFrames) {
+      *truncated = true;
+      break;
+    }
+    if (!item.is_dict()) {
+      *truncated = true;
+      continue;
+    }
+    const auto& frame = item.GetDict();
+    const auto* name = frame.FindString("functionName");
+    std::string function = name && !name->empty() ? *name : "(anonymous)";
+    function = ClipTo(std::move(function), kMaxConsoleFunctionBytes, truncated);
+    if (function.empty())
+      function = "(anonymous)";
+    const auto* url = frame.FindString("url");
+    std::string source = url && !url->empty() ? *url : "(unknown)";
+    if (auto line = frame.FindInt("lineNumber");
+        line && *line >= 0 && *line < 1000000) {
+      source += ":" + std::to_string(*line + 1);
+    }
+    source = ClipTo(std::move(source), kMaxConsoleSourceBytes, truncated);
+    if (source.empty())
+      continue;
+    base::DictValue copy;
+    copy.Set("function", function);
+    copy.Set("source", source);
+    stack.Append(std::move(copy));
+  }
+  if (!stack.empty())
+    data->Set("stack", std::move(stack));
 }
 
