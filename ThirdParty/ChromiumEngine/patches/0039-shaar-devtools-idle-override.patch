+TEST(ShaarDevToolsTest, EmptyTimezoneAndLocaleClearTheOverride) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":33,"params":{"timezoneId":""}})"),
+      33, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Emulation.setTimezoneOverride"));
+  EXPECT_NE(std::string::npos, output.find("\"timezoneId\":\"\""));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":34,"params":{"locale":""}})"),
+      34, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Emulation.setLocaleOverride"));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":33,"params":{}})"),
+      33, &output, &reason));
+  EXPECT_EQ("DevTools command is missing required parameters", reason);
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":34,"params":{}})"),
+      34, &output, &reason));
+}
+
+TEST(ShaarDevToolsTest, IdleOverrideIsDeveloperOnly) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":70,"params":{"isUserActive":false,"isScreenUnlocked":true}})"),
+      70, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Emulation.setIdleOverride"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":71,"params":{}})"),
+      71, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Emulation.clearIdleOverride"));
+  EXPECT_STREQ("Emulation.setIdleOverride",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_EMULATION_SET_IDLE_OVERRIDE));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_EMULATION_SET_IDLE_OVERRIDE));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":70,"params":{}})"),
+      70, &output, &reason));
+  EXPECT_EQ("DevTools command is missing required parameters", reason);
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":70,"params":{"isUserActive":true}})"),
+      70, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":70,"params":{"isUserActive":true,"isScreenUnlocked":true}})"),
+      70, &output, &reason));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{}})"),
+      72, &output, &reason));
+  EXPECT_EQ("unknown DevTools capability or command", reason);
+}
