+TEST(ShaarDevToolsTest, CoverageCommandsStayWithinCapabilities) {
+  std::string output;
+  std::string reason;
+  EXPECT_STREQ("CSS.enable", ProtocolMethod(
+      SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER, SHAAR_DEVTOOLS_CSS_ENABLE));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{"detailed":true}})"),
+      72, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Profiler.startPreciseCoverage"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":73,"params":{}})"),
+      73, &output, &reason)) << reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":75,"params":{}})"),
+      75, &output, &reason)) << reason;
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":72,"params":{}})"),
       72, &output, &reason));
-  EXPECT_EQ("unknown DevTools capability or command", reason);
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{"detailed":"yes"}})"),
+      72, &output, &reason));
 }
 
