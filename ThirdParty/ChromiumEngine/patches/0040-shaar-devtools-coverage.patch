+TEST(ShaarDevToolsTest, CoverageCommandsAreDeveloperAllowed) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":9,"params":{}})"),
+      9, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("CSS.enable"));
+  EXPECT_STREQ("CSS.enable",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_CSS_ENABLE));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{"detailed":true,"callCount":false}})"),
+      72, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Profiler.startPreciseCoverage"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
       Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{}})"),
+      72, &output, &reason)) << reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":73,"params":{}})"),
+      73, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Profiler.takePreciseCoverage"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":74,"params":{}})"),
+      74, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Profiler.stopPreciseCoverage"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":75,"params":{}})"),
+      75, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("CSS.startRuleUsageTracking"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":75,"params":{}})"),
+      75, &output, &reason)) << reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":76,"params":{}})"),
+      76, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("CSS.stopRuleUsageTracking"));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_PROFILER_START_PRECISE_COVERAGE));
+  EXPECT_STREQ("Profiler.startPreciseCoverage",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_PROFILER_START_PRECISE_COVERAGE));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":72,"params":{}})"),
       72, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":72,"params":{"callCount":"yes"}})"),
+      72, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":73,"params":{"extra":true}})"),
+      73, &output, &reason));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":77,"params":{}})"),
+      77, &output, &reason));
   EXPECT_EQ("unknown DevTools capability or command", reason);
 }
 
