+  void TakeHeapSnapshotChunk(const base::DictValue& event) {
+    const base::DictValue* params = event.FindDict("params");
+    const std::string* chunk = params ? params->FindString("chunk") : nullptr;
+    if (!chunk) {
+      Finish(SHAAR_CHROMIUM_ERROR, {}, "heap snapshot chunk is invalid");
+      return;
+    }
+    if (chunk->size() > kMaxHeapSnapshotBytes ||
+        heap_snapshot_chunks_.size() > kMaxHeapSnapshotBytes - chunk->size()) {
+      Finish(SHAAR_CHROMIUM_ERROR, {}, "heap snapshot is too large");
+      return;
+    }
+    heap_snapshot_chunks_.append(*chunk);
+  }
+
+  bool AttachHeapSnapshot(base::DictValue* result, std::string* failure) {
+    if (heap_snapshot_chunks_.empty()) {
+      *failure = "heap snapshot is empty";
+      return false;
+    }
+    auto snapshot = base::JSONReader::Read(
+        heap_snapshot_chunks_, base::JSON_PARSE_RFC);
+    if (!snapshot || !snapshot->is_dict()) {
+      *failure = "heap snapshot is invalid";
+      return false;
+    }
+    result->Set("snapshot", std::move(*snapshot));
+    return true;
+  }
