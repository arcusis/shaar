+        heap_snapshot_chunks_.size() > kMaxHeapSnapshotBytes - chunk->size()) {
+      Finish(SHAAR_CHROMIUM_ERROR, {}, "heap snapshot is too large");
+      return;
+    }
+    heap_snapshot_chunks_.append(*chunk);
+  }
