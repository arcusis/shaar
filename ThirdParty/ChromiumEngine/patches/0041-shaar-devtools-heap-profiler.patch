+           R"({"schemaVersion":1,"capability":1,"command":79,"params":{}})",
+           R"({"schemaVersion":1,"capability":2,"command":77,"params":{"reportProgress":1}})",
+           R"({"schemaVersion":1,"capability":2,"command":78,"params":{"trackAllocations":"yes"}})",
+           R"({"schemaVersion":1,"capability":2,"command":79,"params":{"extra":true}})",
+           R"({"schemaVersion":1,"capability":2,"command":77,"params":{"reportProgress":true,"unreviewed":false}})"}) {
+    EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 77, &output, &reason))
