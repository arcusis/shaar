+TEST(ShaarDevToolsTest, HeapProfilerIsDeveloperOnlyAndCommands77Through79) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":77,"params":{}})"),
+      77, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("HeapProfiler.takeHeapSnapshot"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":77,"params":{"reportProgress":true,"captureNumericValue":false,"exposeInternals":true}})"),
+      77, &output, &reason)) << reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":78,"params":{"trackAllocations":true}})"),
+      78, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("HeapProfiler.startTrackingHeapObjects"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":79,"params":{"reportProgress":false,"treatGlobalObjectsAsRoots":true,"captureNumericValue":false,"exposeInternals":false}})"),
+      79, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("HeapProfiler.stopTrackingHeapObjects"));
+  EXPECT_STREQ("HeapProfiler.takeHeapSnapshot",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_HEAP_PROFILER_TAKE_HEAP_SNAPSHOT));
+  EXPECT_STREQ("HeapProfiler.startTrackingHeapObjects",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_HEAP_PROFILER_START_TRACKING_HEAP_OBJECTS));
+  EXPECT_STREQ("HeapProfiler.stopTrackingHeapObjects",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_HEAP_PROFILER_STOP_TRACKING_HEAP_OBJECTS));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_HEAP_PROFILER_TAKE_HEAP_SNAPSHOT));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_HEAP_PROFILER_START_TRACKING_HEAP_OBJECTS));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_HEAP_PROFILER_STOP_TRACKING_HEAP_OBJECTS));
+  EXPECT_STREQ("Emulation.setTouchEmulationEnabled",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_EMULATION_SET_TOUCH_EMULATION_ENABLED));
+  EXPECT_STREQ("Network.setCacheDisabled",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_NETWORK_SET_CACHE_DISABLED));
+  EXPECT_STREQ("Emulation.setIdleOverride",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_EMULATION_SET_IDLE_OVERRIDE));
+  EXPECT_STREQ("Emulation.clearIdleOverride",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_EMULATION_CLEAR_IDLE_OVERRIDE));
+  EXPECT_STREQ("Profiler.startPreciseCoverage",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_PROFILER_START_PRECISE_COVERAGE));
+  EXPECT_STREQ("CSS.stopRuleUsageTracking",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_CSS_STOP_RULE_USAGE_TRACKING));
+  for (const char* args : {
+           R"({"schemaVersion":1,"capability":1,"command":77,"params":{}})",
