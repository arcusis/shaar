+TEST(ShaarDevToolsTest, EventListenersAreInspectorOnlyAndCommand80) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":"node-1"}})"),
+      80, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("DOMDebugger.getEventListeners"));
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":"node-1","depth":1,"pierce":false}})"),
+      80, &output, &reason)) << reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":60,"params":{"objectId":"node-1","functionDeclaration":"function(){return 1;}","returnByValue":true}})"),
+      60, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Runtime.callFunctionOn"));
+  const char* kRemove =
+      R"({"schemaVersion":1,"capability":1,"command":60,"params":{"objectId":"node-1","functionDeclaration":"function(type, listener, useCapture){this.removeEventListener(type, listener, useCapture);}","returnByValue":true,"arguments":[{"value":"click"},{"objectId":"handler-1"},{"value":false}]}})";
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(Bytes(kRemove), 60, &output, &reason))
+      << reason;
+  EXPECT_NE(std::string::npos, output.find("handler-1"));
+  EXPECT_STREQ("DOMDebugger.getEventListeners",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                              SHAAR_DEVTOOLS_DOM_DEBUGGER_GET_EVENT_LISTENERS));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                           SHAAR_DEVTOOLS_DOM_DEBUGGER_GET_EVENT_LISTENERS));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":81,"params":{}})"),
+      81, &output, &reason));
+  EXPECT_EQ("unknown DevTools capability or command", reason);
+  const std::string long_id(513, 'a');
+  const std::string long_request =
+      std::string(R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":")") +
+      long_id + R"("}})";
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(long_request), 80, &output, &reason));
+  for (const std::string args : {
+           R"({"schemaVersion":1,"capability":2,"command":80,"params":{"objectId":"node-1"}})",
+           R"({"schemaVersion":1,"capability":1,"command":80,"params":{}})",
+           R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":""}})",
+           R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":"node-1","depth":"1"}})",
+           R"({"schemaVersion":1,"capability":1,"command":80,"params":{"objectId":"node-1","extra":true}})",
+           R"({"schemaVersion":1,"capability":1,"command":60,"params":{"objectId":"node-1","functionDeclaration":"function(){}","arguments":[{"value":1}]}})",
+           R"({"schemaVersion":1,"capability":1,"command":60,"params":{"objectId":"node-1","functionDeclaration":"function(){}","arguments":[{"value":true},{"value":true},{"value":true},{"value":true},{"value":true},{"value":true}]}})",
+       }) {
+    EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(Bytes(args), 80, &output, &reason))
+        << args;
+  }
 }
 
