+bool CallArgumentIsValid(const base::DictValue& argument) {
+  if (argument.size() != 1)
+    return false;
+  if (const std::string* object_id = argument.FindString("objectId"))
+    return !object_id->empty() && object_id->size() <= 512;
+  if (argument.FindBool("value").has_value())
+    return true;
+  const std::string* text = argument.FindString("value");
+  return text && text->size() <= 256;
+}
+
+bool CallArgumentsAreValid(const base::DictValue& params) {
+  if (!params.Find("arguments"))
+    return true;
+  const base::ListValue* arguments = params.FindList("arguments");
+  if (!arguments || arguments->size() > 5)
+    return false;
+  for (const base::Value& item : *arguments) {
+    if (!item.is_dict() || !CallArgumentIsValid(item.GetDict()))
+      return false;
   }
   return true;
 }
