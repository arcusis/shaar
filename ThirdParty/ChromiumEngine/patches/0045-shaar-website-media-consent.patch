+// static
+void MediaStreamDevicesController::RequestPermissionsWithShaarDecision(
+    const content::MediaStreamRequest& request,
+    MediaStreamDeviceEnumerator* enumerator,
+    bool allowed,
+    ResultCallback callback) {
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(
+      request.render_process_id, request.render_frame_id);
+  if (!frame || !frame->IsActive()) {
+    std::move(callback).Run(
+        blink::mojom::StreamDevicesSet(),
+        blink::mojom::MediaStreamRequestResult::
+            FAILED_DUE_TO_SHUTDOWN_NO_RFH_IN_CONTROLLER,
+        false, {}, {});
+    return;
+  }
+  const GURL url = frame->GetLastCommittedOrigin().GetURL();
+  if (url.is_empty() || url != request.security_origin) {
+    std::move(callback).Run(
+        blink::mojom::StreamDevicesSet(),
+        blink::mojom::MediaStreamRequestResult::INVALID_SECURITY_ORIGIN,
+        false, {}, {});
+    return;
+  }
+  content::WebContents* contents = content::WebContents::FromRenderFrameHost(frame);
+  if (!contents) {
+    std::move(callback).Run(
+        blink::mojom::StreamDevicesSet(),
+        blink::mojom::MediaStreamRequestResult::INVALID_SECURITY_ORIGIN,
+        false, {}, {});
+    return;
+  }
+  std::unique_ptr<MediaStreamDevicesController> controller(
+      new MediaStreamDevicesController(contents, enumerator, request,
+                                       std::move(callback)));
+  bool blocked_by_policy = false;
+  auto decide = [&](blink::PermissionType type, ContentSetting* setting) {
+    if (*setting != CONTENT_SETTING_ASK)
+      return;
+    auto descriptor = content::PermissionDescriptorUtil::
+        CreatePermissionDescriptorForPermissionType(type);
+    content::PermissionResult permission =
+        contents->GetBrowserContext()
+            ->GetPermissionController()
+            ->GetPermissionResultForCurrentDocument(descriptor, frame);
+    if (permission.status == blink::mojom::PermissionStatus::DENIED) {
+      *setting = CONTENT_SETTING_BLOCK;
+      controller->denial_reason_ =
+          blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED_BY_CONTROLLER;
+      blocked_by_policy |=
+          permission.source == content::PermissionStatusSource::FEATURE_POLICY ||
+          permission.source == content::PermissionStatusSource::FENCED_FRAME;
+      return;
+    }
+    *setting = allowed ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_BLOCK;
+    if (!allowed)
+      controller->denial_reason_ =
+          blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED;
+  };
+  decide(blink::PermissionType::AUDIO_CAPTURE, &controller->audio_setting_);
+  decide(blink::PermissionType::VIDEO_CAPTURE, &controller->video_setting_);
+  controller->RunCallback(blocked_by_policy);
 }
 
