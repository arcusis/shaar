+TEST(ShaarDevToolsTest, ProfilerEnableIsDeveloperOnlyAndCommand81) {
+  std::string output;
+  std::string reason;
+  EXPECT_EQ(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":81,"params":{}})"),
+      81, &output, &reason)) << reason;
+  EXPECT_NE(std::string::npos, output.find("Profiler.enable"));
+  EXPECT_STREQ("Profiler.enable",
+               ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_DEVELOPER,
+                              SHAAR_DEVTOOLS_PROFILER_ENABLE));
+  EXPECT_EQ(nullptr,
+            ProtocolMethod(SHAAR_DEVTOOLS_CAPABILITY_INSPECTOR,
+                           SHAAR_DEVTOOLS_PROFILER_ENABLE));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":1,"command":81,"params":{}})"),
+      81, &output, &reason));
+  EXPECT_NE(SHAAR_OK, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":81,"params":{"extra":true}})"),
+      81, &output, &reason));
+  EXPECT_EQ(SHAAR_INVALID_ARGUMENT, EncodeProtocolRequest(
+      Bytes(R"({"schemaVersion":1,"capability":2,"command":82,"params":{}})"),
+      82, &output, &reason));
+  EXPECT_EQ("unknown DevTools capability or command", reason);
+}
