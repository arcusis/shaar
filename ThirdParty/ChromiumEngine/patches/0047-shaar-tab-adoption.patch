+shaar_tab* TabForWebContents(content::WebContents* contents) {
+  if (!contents)
+    return nullptr;
+  for (const auto& [tab, handle] : tab_handles) {
+    if (!LiveTab(tab))
+      continue;
+    if (shaar::windows_tabs::Registry().FindWebContents(
+            tab->engine, tab->window, tab) == contents)
+      return tab;
+  }
+  return nullptr;
+}
+
+bool PageOpenBecomesShaarTab(WindowOpenDisposition disposition) {
+  switch (disposition) {
+    case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+    case WindowOpenDisposition::NEW_POPUP:
+    case WindowOpenDisposition::NEW_WINDOW:
+      return true;
+    default:
+      return false;
+  }
+}
