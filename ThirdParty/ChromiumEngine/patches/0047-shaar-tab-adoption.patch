+bool AdoptPageWebContents(content::WebContents* source,
+                          std::unique_ptr<content::WebContents>* contents,
+                          const GURL& target_url,
+                          WindowOpenDisposition disposition) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder") ||
+      !contents || !*contents || !PageOpenBecomesShaarTab(disposition))
+    return false;
+  shaar_tab* opener = TabForWebContents(source);
+  if (!opener || !LiveTab(opener) || !LiveWindow(opener->window))
+    return false;
+  shaar_engine* engine = opener->engine;
+  shaar_window* window = opener->window;
+  auto& registry = Registry();
+  if (registry.EngineQuitRequested(engine))
+    return false;
+  Browser* browser = opener->browser;
+  if (!browser)
+    return false;
+  const bool foreground =
+      disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  // Swift UUID strings are uppercase. The engine echoes this id on later events.
+  const base::Uuid generated = base::Uuid::GenerateRandomV4();
+  std::string tab_id = base::ToUpperASCII(generated.AsLowercaseString());
+  if (registry.HasTabID(engine, window, tab_id))
+    return false;
+  std::string opened_url = "about:blank";
+  if (target_url.is_valid()) {
+    const std::string spec = target_url.spec();
+    if (!spec.empty() && spec.size() <= 8192)
+      opened_url = spec;
+  }
+  content::WebContents* raw_contents = contents->get();
+  browser->GetTabStripModel()->AppendWebContents(std::move(*contents),
+                                                 foreground);
+  if (BrowserWindow* native_window = BrowserWindow::FromBrowser(browser))
+    native_window->Hide();
+  auto handle = std::make_unique<shaar_tab>(raw_contents, ++next_tab_serial);
+  handle->engine = engine;
+  handle->window = window;
+  handle->browser = browser;
+  handle->profile = opener->profile;
+  handle->private_session = opener->private_session;
+  handle->profile_id = opener->profile_id;
+  handle->session_id = opener->session_id;
+  handle->window_id = opener->window_id;
+  handle->tab_id = tab_id;
+  handle->navigation = std::make_unique<shaar::navigation::NavigationObserver>(
+      engine, raw_contents, handle->profile_id, handle->session_id,
+      handle->window_id, handle->tab_id);
+  handle->media = shaar::media::CreateMediaTracker(
+      engine, raw_contents, handle->profile_id, handle->session_id,
+      handle->window_id, handle->tab_id);
+  if (auto* driver =
+          favicon::ContentFaviconDriver::FromWebContents(raw_contents)) {
+    handle->favicon_observation.Observe(driver);
+  }
+  auto* raw = handle.get();
+  if (!registry.ReserveTab(engine, window, raw, tab_id)) {
+    const int index =
+        browser->GetTabStripModel()->GetIndexOfWebContents(raw_contents);
+    if (index >= 0)
+      browser->GetTabStripModel()->CloseWebContentsAt(index, 0);
+    return true;
+  }
+  registry.BindTab(engine, window, raw, tab_id, browser, raw_contents);
+  tab_handles.emplace(raw, std::move(handle));
+  if (window->profile_id.empty())
+    window->profile_id = opener->profile_id;
+  base::DictValue payload;
+  payload.Set("schemaVersion", 1);
+  payload.Set("kind", "opened");
+  payload.Set("url", opened_url);
+  payload.Set("openerTabID", opener->tab_id);
+  payload.Set("foreground", foreground);
+  std::string body;
+  // Register the tab before Chromium navigates it. A suppressed opener is
+  // loaded by content after AddNewContents returns; a live opener is loaded
+  // by the renderer. A second navigation here would replace that request.
+  if (base::JSONWriter::Write(base::Value(std::move(payload)), &body)) {
+    shaar::EmitEvent(engine, SHAAR_EVENT_TAB,
+                     {raw->profile_id.data(), raw->profile_id.size()},
+                     {raw->session_id.data(), raw->session_id.size()},
+                     {raw->window_id.data(), raw->window_id.size()},
+                     {raw->tab_id.data(), raw->tab_id.size()},
+                     {body.data(), body.size()});
+  }
+  return true;
+}
