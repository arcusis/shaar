+        navigation->IsSameDocument())
+      return;
+    if (!StillOwnsTarget()) {
+      Close();
+      return;
+    }
+    // The lease belongs to the tab. A document load changes its origin and
+    // invalidates resource IDs, but the DevTools session keeps receiving the
+    // new document's early console and network events.
+    origin_ = url::Origin::Create(contents_->GetLastCommittedURL()).Serialize();
