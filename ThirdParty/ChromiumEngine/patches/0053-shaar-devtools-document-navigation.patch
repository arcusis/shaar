+TEST(ShaarDevToolsPanelTest, ProjectsCommittedDocumentFallbackWithMethod) {
+  std::string request;
+  std::string response;
+  ASSERT_TRUE(ProjectCommittedDocumentForTesting(
+      "navigation-17", "https://example.test/", "GET", 200, 42,
+      &request, &response));
+  auto request_event = base::JSONReader::Read(request, base::JSON_PARSE_RFC);
+  auto response_event = base::JSONReader::Read(response, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(request_event && request_event->is_dict());
+  ASSERT_TRUE(response_event && response_event->is_dict());
+  const auto& request_data = *request_event->GetDict().FindDict("data");
+  const auto& response_data = *response_event->GetDict().FindDict("data");
+  EXPECT_EQ(4, request_event->GetDict().FindInt("eventID"));
+  EXPECT_EQ("GET", *request_data.FindString("method"));
+  EXPECT_EQ("navigation-17", *request_data.FindString("requestID"));
+  EXPECT_EQ("https://example.test/", *request_data.FindString("url"));
+  EXPECT_EQ(5, response_event->GetDict().FindInt("eventID"));
+  EXPECT_EQ("navigation-17", *response_data.FindString("requestID"));
+  EXPECT_EQ(200, response_data.FindInt("status"));
+}
