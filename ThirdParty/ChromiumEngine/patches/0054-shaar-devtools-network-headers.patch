@@ -333,2 +335,38 @@ void PutString(base::DictValue* output, std::string_view key,
 
+bool SensitiveHeader(std::string_view name) {
+  const std::string lower = base::ToLowerASCII(name);
+  return lower == "authorization" || lower == "proxy-authorization" ||
+         lower == "cookie" || lower == "set-cookie" ||
+         lower == "x-api-key";
+}
+
+void CopyHeaders(base::DictValue* output, std::string_view key,
+                 const base::DictValue* source, bool* truncated) {
+  if (!source)
+    return;
+  base::ListValue headers;
+  size_t bytes = 0;
+  for (const auto item : *source) {
+    const std::string& name = item.first;
+    if (!item.second.is_string() || name.empty() || name.size() > 128) {
+      *truncated = true;
+      continue;
+    }
+    const std::string value = SensitiveHeader(name)
+                                  ? "[redacted]"
+                                  : item.second.GetString();
+    if (value.size() > 1024 || headers.size() == kMaxHeaderCount ||
+        bytes + name.size() + value.size() > kMaxHeaderBytes) {
+      *truncated = true;
+      break;
+    }
+    base::DictValue header;
+    header.Set("name", name);
+    header.Set("value", value);
+    headers.Append(std::move(header));
+    bytes += name.size() + value.size();
+  }
+  output->Set(key, std::move(headers));
+}
