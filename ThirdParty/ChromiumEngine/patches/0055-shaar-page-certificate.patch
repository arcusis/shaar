+std::optional<base::DictValue> PageCertificate(
+    const net::X509Certificate& certificate) {
+  constexpr size_t kMaxCertificates = 16;
+  constexpr size_t kMaxCertificateBytes = 64 * 1024;
+  constexpr size_t kMaxChainBytes = 256 * 1024;
+  const auto& buffers = certificate.cert_buffers();
+  if (buffers.empty() || buffers.size() > kMaxCertificates)
+    return std::nullopt;
+  size_t total_bytes = 0;
+  base::ListValue der_chain;
+  for (const auto& buffer : buffers) {
+    const size_t size = CRYPTO_BUFFER_len(buffer.get());
+    if (!size || size > kMaxCertificateBytes ||
+        total_bytes > kMaxChainBytes - size)
+      return std::nullopt;
+    total_bytes += size;
+    der_chain.Append(base::Base64Encode(
+        base::span<const uint8_t>(CRYPTO_BUFFER_data(buffer.get()), size)));
+  }
+  base::DictValue result;
+  result.Set("derChain", std::move(der_chain));
+  std::vector<std::string> dns_names;
+  std::vector<std::string> ip_addresses;
+  certificate.GetSubjectAltName(&dns_names, &ip_addresses);
+  base::ListValue names;
+  for (const auto& name : dns_names) {
+    if (names.size() == 128) break;
+    if (name.size() <= 255) names.Append(name);
+  }
+  for (const auto& address : ip_addresses) {
+    if (names.size() == 128) break;
+    if (address.size() == 4 || address.size() == 16)
+      names.Append(net::IPAddress(base::as_byte_span(address)).ToString());
+  }
+  result.Set("subjectAltNames", std::move(names));
+  return result;
 }
 
