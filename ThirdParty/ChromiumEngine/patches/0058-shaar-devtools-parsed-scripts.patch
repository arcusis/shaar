+  shaar_error_code ListParsedScripts(const base::DictValue& args,
+                                     ReplyTarget reply, shaar_error* error) {
+    if (!HasKeys(args, {"skipCount", "pageSize"}) || !BoundedPage(args))
+      return Fail(error, SHAAR_INVALID_ARGUMENT, "invalid parsed script page");
+    base::ListValue items;
+    const size_t skip = static_cast<size_t>(*args.FindInt("skipCount"));
+    const size_t count = static_cast<size_t>(*args.FindInt("pageSize"));
+    auto script = parsed_scripts_.begin();
+    std::advance(script, std::min(skip, parsed_scripts_.size()));
+    const bool truncated = scripts_truncated_;
+    for (; script != parsed_scripts_.end() && items.size() < count; ++script) {
+      base::DictValue item;
+      item.Set("url", script->first);
+      item.Set("scriptID", script->second.id);
+      if (!script->second.source_map_url.empty())
+        item.Set("sourceMapURL", script->second.source_map_url);
+      items.Append(std::move(item));
+    }
+    base::DictValue output;
+    output.Set("schemaVersion", 1);
+    output.Set("commandID", SHAAR_DEVTOOLS_PHASE2_PARSED_SCRIPTS);
+    output.Set("items", std::move(items));
+    output.Set("hasMore", script != parsed_scripts_.end());
+    output.Set("truncated", truncated);
+    std::string json;
+    if (!base::JSONWriter::Write(base::Value(std::move(output)), &json) ||
+        json.size() > 512 * 1024)
+      return Fail(error, SHAAR_CHROMIUM_ERROR, "parsed script page too large");
+    Reply(reply, SHAAR_OK, std::move(json));
     return SHAAR_OK;
   }
 
