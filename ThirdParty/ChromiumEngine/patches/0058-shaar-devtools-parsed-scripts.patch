+TEST(ShaarDevToolsPanelTest, ParsedScriptsProjectOnlyOwnedScriptIdentity) {
+  std::string output;
+  EXPECT_TRUE(ProjectPhase2EventForTesting(
+      R"({"method":"Debugger.scriptParsed","params":{"scriptId":"42","url":"https://example.test/src/App.vue","sourceMapURL":"data:application/json;base64,e30=","hash":"private"}})",
+      "https://example.test", 7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":30"));
+  EXPECT_NE(std::string::npos, output.find("App.vue"));
+  EXPECT_EQ(std::string::npos, output.find("private"));
+  EXPECT_FALSE(ProjectPhase2EventForTesting(
+      R"({"method":"Debugger.scriptParsed","params":{"scriptId":"42","url":"https://other.test/app.js"}})",
+      "https://example.test", 7, &output));
+}
