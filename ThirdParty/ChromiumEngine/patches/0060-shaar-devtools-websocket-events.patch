+TEST(ShaarDevToolsPanelTest, ProjectsWebSocketLifecycleAndTextFrames) {
+  std::string output;
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketCreated","params":{"requestId":"ws-1","url":"ws://example.test/ws"}})",
+      7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":31"));
+  EXPECT_NE(std::string::npos, output.find("ws://example.test/ws"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketHandshakeResponseReceived","params":{"requestId":"ws-1","response":{"status":101,"headers":{"Cookie":"secret"}}}})",
+      7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":32"));
+  EXPECT_NE(std::string::npos, output.find("\"status\":101"));
+  EXPECT_EQ(std::string::npos, output.find("secret"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketFrameSent","params":{"requestId":"ws-1","response":{"opcode":1,"payloadData":"ping"}}})",
+      7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":33"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketFrameReceived","params":{"requestId":"ws-1","response":{"opcode":1,"payloadData":"echo-ready"}}})",
+      7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":34"));
+  EXPECT_NE(std::string::npos, output.find("echo-ready"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketFrameReceived","params":{"requestId":"ws-1","response":{"opcode":2,"payloadData":"binary-secret"}}})",
+      7, &output));
+  EXPECT_EQ(std::string::npos, output.find("binary-secret"));
+  EXPECT_TRUE(ProjectPanelEventForTesting(
+      R"({"method":"Network.webSocketClosed","params":{"requestId":"ws-1"}})",
+      7, &output));
+  EXPECT_NE(std::string::npos, output.find("\"eventID\":35"));
+}
