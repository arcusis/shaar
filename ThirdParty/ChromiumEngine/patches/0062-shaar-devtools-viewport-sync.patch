+  }
+
+  bool ApplyColorScheme() {
+    if (!attached_)
+      return false;
+    base::DictValue params;
+    base::ListValue features;
+    if (color_scheme_ == "light" || color_scheme_ == "dark") {
+      base::DictValue feature;
+      feature.Set("name", "prefers-color-scheme");
+      feature.Set("value", color_scheme_);
+      features.Append(std::move(feature));
+    }
+    params.Set("features", std::move(features));
+    return Send("Emulation.setEmulatedMedia", std::move(params)) != 0;
+  }
