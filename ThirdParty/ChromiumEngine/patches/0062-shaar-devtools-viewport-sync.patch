+    for (const auto& viewport : viewports_) {
+      const int projected_x = x * viewport->width() / source->width();
+      const int projected_y = y * viewport->height() / source->height();
+      if (!(viewport.get()->*send)(projected_x, projected_y))
+        return false;
+    }
+    return true;
+  }
