+  bool TypeText(std::string_view text) {
+    if (!attached_ || !ValidTypingText(text))
+      return false;
+    size_t index = 0;
+    while (index < text.size()) {
+      const unsigned char lead = static_cast<unsigned char>(text[index]);
+      size_t length = 1;
+      if (lead >= 0xF0)
+        length = 4;
+      else if (lead >= 0xE0)
+        length = 3;
+      else if (lead >= 0xC0)
+        length = 2;
+      const std::string token(text.substr(index, length));
+      index += length;
+      base::DictValue down;
+      down.Set("type", "keyDown");
+      down.Set("key", token);
+      down.Set("text", token);
+      base::DictValue up;
+      up.Set("type", "keyUp");
+      up.Set("key", token);
+      if (Send("Input.dispatchKeyEvent", std::move(down)) == 0 ||
+          Send("Input.dispatchKeyEvent", std::move(up)) == 0)
+        return false;
+    }
+    return true;
+  }
