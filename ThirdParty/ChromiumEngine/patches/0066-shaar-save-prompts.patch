 void ManagePasswordsUIController::ShowBubble() {
+  const auto state = GetState();
+  const bool is_save = state == password_manager::ui::PENDING_PASSWORD_STATE;
+  const bool is_update =
+      state == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE;
+  if ((is_save || is_update) &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder")) {
+    auto decision = base::BindOnce(
+        [](base::WeakPtr<ManagePasswordsUIController> controller, bool update,
+           int choice) {
+          if (!controller)
+            return;
+          const auto current = controller->GetState();
+          const bool still_pending =
+              current == password_manager::ui::PENDING_PASSWORD_STATE ||
+              current == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE;
+          if (choice == 1 && still_pending) {
+            const password_manager::PasswordForm& pending =
+                controller->GetPendingPassword();
+            controller->SavePassword(pending.username_value,
+                                     pending.password_value);
+            return;
+          }
+          if (choice == 3 && !update &&
+              current == password_manager::ui::PENDING_PASSWORD_STATE) {
+            controller->NeverSavePassword();
+            return;
+          }
+          if (!update &&
+              current == password_manager::ui::PENDING_PASSWORD_STATE) {
+            controller->OnNotNowClicked();
+            return;
+          }
+          if (update &&
+              current ==
+                  password_manager::ui::PENDING_PASSWORD_UPDATE_STATE) {
+            controller->OnNopeUpdateClicked();
+          }
+        },
+        weak_ptr_factory_.GetWeakPtr(), is_update);
+    const std::string detail =
+        base::UTF16ToUTF8(GetPendingPassword().username_value);
+    if (shaar::save_prompts::OfferSavePrompt) {
+      shaar::save_prompts::OfferSavePrompt(web_contents(), "password",
+                                           detail.c_str(), is_update,
+                                           std::move(decision));
+    } else {
+      std::move(decision).Run(2);
+    }
+    return;
+  }
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->ShowManagePasswordsBubble(user_action_);
   }
