 // static
 ExtensionInstallPrompt::ShowDialogCallback
 ExtensionInstallPrompt::GetDefaultShowDialogCallback() {
+  // Auto-confirm runs before this callback, so tests keep their result.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder") &&
+      shaar::extensions_host::ShaarShowInstallPrompt) {
+    return base::BindRepeating(&shaar::extensions_host::ShaarShowInstallPrompt);
+  }
   return base::BindRepeating(&ShowExtensionInstallDialogImpl);
 }
