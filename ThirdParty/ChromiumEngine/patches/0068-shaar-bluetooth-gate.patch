+class ShaarBluetoothGateTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_inquiry_inits = 0;
+    g_inquiry_on_main = false;
+    g_central_inits = 0;
+    Class inquiry = NSClassFromString(@"IOBluetoothDeviceInquiry");
+    Class central = NSClassFromString(@"CBCentralManager");
+    ASSERT_TRUE(inquiry);
+    ASSERT_TRUE(central);
+    Method inquiry_method =
+        class_getInstanceMethod(inquiry, @selector(initWithDelegate:));
+    Method central_method = class_getInstanceMethod(
+        central, @selector(initWithDelegate:queue:));
+    ASSERT_TRUE(inquiry_method);
+    ASSERT_TRUE(central_method);
+    g_inquiry_init_impl =
+        method_setImplementation(inquiry_method, (IMP)CountInquiryInit);
+    g_central_init_impl =
+        method_setImplementation(central_method, (IMP)CountCentralInit);
+  }
+
+  void TearDown() override {
+    ShaarSetBluetoothGateForTesting(std::nullopt, std::nullopt);
+    if (g_inquiry_init_impl) {
+      Method method = class_getInstanceMethod(
+          NSClassFromString(@"IOBluetoothDeviceInquiry"),
+          @selector(initWithDelegate:));
+      method_setImplementation(method, g_inquiry_init_impl);
+      g_inquiry_init_impl = nullptr;
+    }
+    if (g_central_init_impl) {
+      Method method = class_getInstanceMethod(
+          NSClassFromString(@"CBCentralManager"),
+          @selector(initWithDelegate:queue:));
+      method_setImplementation(method, g_central_init_impl);
+      g_central_init_impl = nullptr;
+    }
+  }
+
+  base::test::TaskEnvironment task_environment_;
+};
