+
+template <typename Task>
+void RunOffMainThread(Task task) {
+  base::RunLoop loop;
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::TaskPriority::BEST_EFFORT, base::MayBlock()},
+      base::BindLambdaForTesting([&loop, task]() mutable {
+        task();
+        loop.Quit();
+      }));
+  loop.Run();
+}
+
+}  // namespace
+
+class ShaarBluetoothGateTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_inquiry_inits = 0;
+    g_inquiry_on_main = false;
+    g_central_inits = 0;
+    Class inquiry = NSClassFromString(@"IOBluetoothDeviceInquiry");
+    Class central = NSClassFromString(@"CBCentralManager");
+    ASSERT_TRUE(inquiry);
+    ASSERT_TRUE(central);
+    Method inquiry_method =
+        class_getInstanceMethod(inquiry, @selector(initWithDelegate:));
+    Method central_method = class_getInstanceMethod(
+        central, @selector(initWithDelegate:queue:));
+    ASSERT_TRUE(inquiry_method);
+    ASSERT_TRUE(central_method);
+    g_inquiry_init_impl =
+        method_setImplementation(inquiry_method, (IMP)CountInquiryInit);
+    g_central_init_impl =
+        method_setImplementation(central_method, (IMP)CountCentralInit);
+  }
+
+  void TearDown() override {
+    ShaarSetBluetoothGateForTesting(std::nullopt, std::nullopt);
+    if (g_inquiry_init_impl) {
+      Method method = class_getInstanceMethod(
+          NSClassFromString(@"IOBluetoothDeviceInquiry"),
+          @selector(initWithDelegate:));
+      method_setImplementation(method, g_inquiry_init_impl);
+      g_inquiry_init_impl = nullptr;
+    }
+    if (g_central_init_impl) {
+      Method method = class_getInstanceMethod(
+          NSClassFromString(@"CBCentralManager"),
+          @selector(initWithDelegate:queue:));
+      method_setImplementation(method, g_central_init_impl);
+      g_central_init_impl = nullptr;
+    }
+  }
+
+  base::test::TaskEnvironment task_environment_;
+};
+
+TEST_F(ShaarBluetoothGateTest, RefusedProcessDoesNotCreateTheAdapter) {
+  ShaarSetBluetoothGateForTesting(/*authorization_allowed=*/false,
+                                 /*has_usage_description=*/false);
+  auto adapter = BluetoothAdapterMac::CreateAdapter();
+  adapter->Initialize(base::DoNothing());
+  EXPECT_TRUE(adapter->GetAddress().empty());
+  EXPECT_FALSE(adapter->IsPowered());
+  EXPECT_TRUE(adapter->GetDevices().empty());
+  EXPECT_EQ(0, g_central_inits);
+  EXPECT_EQ(0, g_inquiry_inits);
+
+  RunOffMainThread([] {
+    EXPECT_TRUE(ShaarAllocateDeviceInquiry(nil) == nil);
+  });
+  EXPECT_EQ(0, g_inquiry_inits);
+}
+
+TEST_F(ShaarBluetoothGateTest, AuthorizedInquiryStaysOffTheMainThread) {
+  ShaarSetBluetoothGateForTesting(/*authorization_allowed=*/true,
+                                 /*has_usage_description=*/true);
+  auto adapter = BluetoothAdapterMac::CreateAdapter();
+  adapter->GetAddress();
+  EXPECT_EQ(0, g_central_inits);
+  EXPECT_EQ(0, g_inquiry_inits);
+  EXPECT_TRUE(ShaarAllocateDeviceInquiry(nil) == nil);
+  EXPECT_EQ(0, g_inquiry_inits);
+
+  RunOffMainThread([] {
+    EXPECT_TRUE(ShaarAllocateDeviceInquiry(nil) == nil);
+    EXPECT_FALSE(pthread_main_np());
+  });
+  EXPECT_EQ(1, g_inquiry_inits);
+  EXPECT_FALSE(g_inquiry_on_main);
+  EXPECT_EQ(0, g_central_inits);
+}
+
+TEST_F(ShaarBluetoothGateTest, MissingUsageDescriptionRefusesTheInquiry) {
+  ShaarSetBluetoothGateForTesting(/*authorization_allowed=*/true,
+                                 /*has_usage_description=*/false);
+  RunOffMainThread([] {
+    EXPECT_TRUE(ShaarAllocateDeviceInquiry(nil) == nil);
+  });
+  EXPECT_EQ(0, g_inquiry_inits);
+  EXPECT_EQ(0, g_central_inits);
+}
+
+TEST_F(ShaarBluetoothGateTest, RealProcessGateMatchesTheInquiryAllocator) {
+  const bool blocked = ShaarBluetoothIOIsBlocked();
+  RunOffMainThread([] {
+    EXPECT_TRUE(ShaarAllocateDeviceInquiry(nil) == nil);
+  });
+  if (blocked) {
+    EXPECT_EQ(0, g_inquiry_inits);
+  } else {
