diff --git a/device/bluetooth/shaar_bluetooth_io_gate.h b/device/bluetooth/shaar_bluetooth_io_gate.h
new file mode 100644
index 0000000..b31864f
--- /dev/null
+++ b/device/bluetooth/shaar_bluetooth_io_gate.h
@@ -0,0 +1,59 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef DEVICE_BLUETOOTH_SHAAR_BLUETOOTH_IO_GATE_H_
+#define DEVICE_BLUETOOTH_SHAAR_BLUETOOTH_IO_GATE_H_
+
+#include <optional>
+
+#include "base/functional/callback.h"
+#include "device/bluetooth/bluetooth_export.h"
+
+#if defined(__OBJC__)
+@class IOBluetoothDeviceInquiry;
+#endif
+
+namespace device {
+
+// IOBluetooth is allowed only off the UI thread, and only when CoreBluetooth
+// authorization is already AllowedAlways and the responsible process bundle
+// has a non-empty NSBluetoothAlwaysUsageDescription. The plist is read even
+// when this process is self-responsible.
+inline bool ShaarBluetoothMayCallIOBluetooth(bool on_ui_thread,
+                                            bool authorization_allowed,
+                                            bool has_usage_description) {
+  if (on_ui_thread)
+    return false;
+  if (!authorization_allowed)
+    return false;
+  if (!has_usage_description)
+    return false;
+  return true;
+}
+
+DEVICE_BLUETOOTH_EXPORT bool ShaarMayCallIOBluetooth();
+DEVICE_BLUETOOTH_EXPORT bool ShaarBluetoothIOIsBlocked();
+DEVICE_BLUETOOTH_EXPORT bool ShaarBluetoothAuthorizationUndetermined();
+DEVICE_BLUETOOTH_EXPORT bool ShaarBluetoothHasUsageDescription();
+
+// Runs |task| now when this thread may call IOBluetooth. Posts it to a
+// MayBlock worker when this is the UI thread and a background call would be
+// allowed. Drops |task| when Bluetooth is not allowed. Never waits.
+void ShaarPostIOBluetooth(base::OnceClosure task);
+
+// Tests pass nullopt to read the real process. Production calls pass nothing.
+DEVICE_BLUETOOTH_EXPORT void ShaarSetBluetoothGateForTesting(
+    std::optional<bool> authorization_allowed,
+    std::optional<bool> has_usage_description);
+
+#if defined(__OBJC__)
+// Allocates IOBluetoothDeviceInquiry only when this thread may call
+// IOBluetooth. Returns nil when the gate refuses, before initWithDelegate:.
+DEVICE_BLUETOOTH_EXPORT IOBluetoothDeviceInquiry* ShaarAllocateDeviceInquiry(
+    id delegate);
+#endif
+
+}  // namespace device
+
+#endif  // DEVICE_BLUETOOTH_SHAAR_BLUETOOTH_IO_GATE_H_
diff --git a/device/bluetooth/shaar_bluetooth_io_gate.mm b/device/bluetooth/shaar_bluetooth_io_gate.mm
new file mode 100644
index 0000000..511a7fc
--- /dev/null
+++ b/device/bluetooth/shaar_bluetooth_io_gate.mm
@@ -0,0 +1,143 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/bluetooth/shaar_bluetooth_io_gate.h"
+
+#include <dlfcn.h>
+#include <libproc.h>
+#include <pthread.h>
+#include <unistd.h>
+
+#include <optional>
+
+#include "base/task/thread_pool.h"
+#include "device/bluetooth/bluetooth_adapter_mac_permission.h"
+
+#import <Foundation/Foundation.h>
+#import <IOBluetooth/IOBluetooth.h>
+
+namespace device {
+namespace {
+
+std::optional<bool> g_authorization_override;
+std::optional<bool> g_usage_override;
+
+using ResponsiblePIDFunction = pid_t (*)(pid_t);
+
+ResponsiblePIDFunction ResponsiblePID() {
+  static ResponsiblePIDFunction function = nullptr;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    void* library = dlopen("/usr/lib/system/libquarantine.dylib", RTLD_LAZY);
+    if (!library)
+      return;
+    function = reinterpret_cast<ResponsiblePIDFunction>(
+        dlsym(library, "responsibility_get_pid_responsible_for_pid"));
+  });
+  return function;
+}
+
+bool BundleHasUsageDescription(pid_t pid) {
+  char path[PROC_PIDPATHINFO_MAXSIZE];
+  if (proc_pidpath(pid, path, sizeof(path)) <= 0)
+    return false;
+  NSString* executable = [NSString stringWithUTF8String:path];
+  if (!executable)
+    return false;
+  NSString* macos = [executable stringByDeletingLastPathComponent];
+  NSString* contents = [macos stringByDeletingLastPathComponent];
+  if (![[macos lastPathComponent] isEqualToString:@"MacOS"] ||
+      ![[contents lastPathComponent] isEqualToString:@"Contents"]) {
+    return false;
+  }
+  NSString* plist = [contents stringByAppendingPathComponent:@"Info.plist"];
+  NSDictionary* info = [NSDictionary dictionaryWithContentsOfFile:plist];
+  NSString* usage = info[@"NSBluetoothAlwaysUsageDescription"];
+  return [usage isKindOfClass:[NSString class]] && usage.length > 0;
+}
+
+bool ResponsibleProcessHasUsageDescription() {
+  if (g_usage_override.has_value())
+    return *g_usage_override;
+  static bool has_description = false;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    ResponsiblePIDFunction function = ResponsiblePID();
+    if (!function)
+      return;
+    const pid_t responsible = function(getpid());
+    if (responsible <= 0)
+      return;
+    has_description = BundleHasUsageDescription(responsible);
+  });
+  return has_description;
+}
+
+bool AuthorizationAllowed() {
+  if (g_authorization_override.has_value())
+    return *g_authorization_override;
+  return GetMacBluetoothPermissionStatus() ==
+         BluetoothAdapter::PermissionStatus::kAllowed;
+}
+
+bool AuthorizationUndetermined() {
+  if (g_authorization_override.has_value())
+    return false;
+  return GetMacBluetoothPermissionStatus() ==
+         BluetoothAdapter::PermissionStatus::kUndetermined;
+}
+
+}  // namespace
+
+bool ShaarBluetoothIOIsBlocked() {
+  return !ShaarBluetoothMayCallIOBluetooth(
+      /*on_ui_thread=*/false, AuthorizationAllowed(),
+      ResponsibleProcessHasUsageDescription());
+}
+
+bool ShaarBluetoothAuthorizationUndetermined() {
+  return AuthorizationUndetermined();
+}
+
+bool ShaarBluetoothHasUsageDescription() {
+  return ResponsibleProcessHasUsageDescription();
+}
+
+bool ShaarMayCallIOBluetooth() {
+  if (pthread_main_np())
+    return false;
+  const bool authorization_allowed = AuthorizationAllowed();
+  const bool has_usage_description = ResponsibleProcessHasUsageDescription();
+  return ShaarBluetoothMayCallIOBluetooth(
+      /*on_ui_thread=*/false, authorization_allowed, has_usage_description);
+}
+
+void ShaarPostIOBluetooth(base::OnceClosure task) {
+  if (!task)
+    return;
+  if (ShaarBluetoothIOIsBlocked())
+    return;
+  if (ShaarMayCallIOBluetooth()) {
+    std::move(task).Run();
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::TaskPriority::BEST_EFFORT, base::MayBlock()},
+      std::move(task));
+}
+
+void ShaarSetBluetoothGateForTesting(
+    std::optional<bool> authorization_allowed,
+    std::optional<bool> has_usage_description) {
+  g_authorization_override = authorization_allowed;
+  g_usage_override = has_usage_description;
+}
+
+IOBluetoothDeviceInquiry* ShaarAllocateDeviceInquiry(id delegate) {
+  if (!ShaarMayCallIOBluetooth())
+    return nil;
+  return [[IOBluetoothDeviceInquiry alloc] initWithDelegate:delegate];
+}
+
+}  // namespace device
