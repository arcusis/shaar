+// Touched only on |runner_|. The classic manager constructor must not allocate
+// an IOBluetoothDeviceInquiry; that call blocks inside IOBluetooth.
+class InquiryState : public base::RefCountedThreadSafe<InquiryState> {
+ public:
+  InquiryState(BluetoothDeviceInquiryDelegate* delegate,
+               scoped_refptr<base::SequencedTaskRunner> runner)
+      : delegate_(delegate), runner_(std::move(runner)) {}
+
+  void AttachAndStart(bool reset_cache) {
+    if (retired_ || !ShaarMayCallIOBluetooth()) {
+      NotifyStartFailed();
+      return;
+    }
+    if (!inquiry_) {
+      inquiry_ = ShaarAllocateDeviceInquiry(delegate_);
+      if (!inquiry_) {
+        NotifyStartFailed();
+        return;
+      }
+    }
+    if (reset_cache)
+      [inquiry_ clearFoundDevices];
+    inquiry_.delegate = delegate_;
+    if ([inquiry_ start] != kIOReturnSuccess) {
+      inquiry_.delegate = nil;
+      NotifyStartFailed();
+      return;
+    }
+    [delegate_ armSelfRetain];
+  }
+
+  void ClearFoundDevices() {
+    if (retired_ || !inquiry_ || !ShaarMayCallIOBluetooth())
+      return;
+    [inquiry_ clearFoundDevices];
+  }
+
+  void Stop() {
+    if (!inquiry_ || !ShaarMayCallIOBluetooth())
+      return;
+    [inquiry_ stop];
+    inquiry_.delegate = nil;
+  }
+
+  void Retire() {
+    retired_ = true;
+    Stop();
+  }
+
+  void ReleaseSelfRetain() {
+    [delegate_ releaseSelfRetain];
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<InquiryState>;
+
+  ~InquiryState() { Stop(); }
+
+  void NotifyStartFailed() {
+    if (retired_)
+      return;
+    BluetoothDeviceInquiryDelegate* __strong delegate = delegate_;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [delegate notifyStartFailed];
+    });
+  }
+
+  BluetoothDeviceInquiryDelegate* __strong delegate_;
+  IOBluetoothDeviceInquiry* __strong inquiry_;
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  bool retired_ = false;
+};
