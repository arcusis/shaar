+TEST(ShaarLifecycleProbeTest, ExtraSwitchesAreOptInForVerificationOnly) {
+  base::ScopedEnvironmentVariableOverride switches(
+      "SHAAR_ENGINE_TEST_SWITCHES",
+      "--vmodule=form_data_importer=2,credit_card_save_manager=2,"
+      "password_form_manager=2,address_form_data_importer=2,"
+      "address_profile_save_manager=2 --enable-logging=stderr");
+  const auto production = shaar::lifecycle::ChromeMainArguments(
+      "/test/Shaar", "/tmp/prod", "en", false);
+  const auto verification = shaar::lifecycle::ChromeMainArguments(
+      "/test/Shaar", "/tmp/probe", "en", true);
+  EXPECT_EQ(std::find(production.begin(), production.end(),
+                      "--enable-logging=stderr"),
+            production.end());
+  EXPECT_NE(std::find(verification.begin(), verification.end(),
+                      "--enable-logging=stderr"),
+            verification.end());
+  EXPECT_NE(std::find_if(verification.begin(), verification.end(),
+                         [](const std::string& argument) {
+                           return base::StartsWith(argument, "--vmodule=");
+                         }),
+            verification.end());
+
+  base::ScopedEnvironmentVariableOverride protected_switch(
+      "SHAAR_ENGINE_TEST_SWITCHES",
+      "--vmodule=foo=2 --user-data-dir=/tmp/other");
+  const auto rejected = shaar::lifecycle::ChromeMainArguments(
+      "/test/Shaar", "/tmp/probe", "en", true);
+  EXPECT_EQ(std::find_if(rejected.begin(), rejected.end(),
+                         [](const std::string& argument) {
+                           return base::StartsWith(argument, "--vmodule=");
+                         }),
+            rejected.end());
+}
