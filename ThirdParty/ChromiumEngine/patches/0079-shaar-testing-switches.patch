+// SHAAR_ENGINE_TEST_SWITCHES is a whitespace-delimited list of switches. It is
+// read only in verification mode and cannot override the engine's fixed args.
+void AppendTestingSwitches(std::vector<std::string>& arguments) {
+  const char* raw_switches = std::getenv("SHAAR_ENGINE_TEST_SWITCHES");
+  if (!raw_switches || !*raw_switches)
+    return;
+
+  const std::vector<std::string> switches = base::SplitString(
+      raw_switches, " \t\r\n", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  std::vector<std::string> validated_switches;
+  for (const std::string& option : switches) {
+    if (!base::StartsWith(option, "--") || option.size() <= 2)
+      return;
+    const size_t equals = option.find('=');
+    const std::string name = option.substr(2, equals - 2);
+    if (name.empty() || name.find_first_not_of(
+                            "abcdefghijklmnopqrstuvwxyz0123456789-") !=
+                            std::string::npos) {
+      return;
+    }
+
+    for (const std::string& existing : arguments) {
+      if (!base::StartsWith(existing, "--"))
+        continue;
+      const size_t existing_equals = existing.find('=');
+      if (existing.substr(2, existing_equals - 2) == name)
+        return;
+    }
+    for (const std::string& validated : validated_switches) {
+      const size_t validated_equals = validated.find('=');
+      if (validated.substr(2, validated_equals - 2) == name)
+        return;
+    }
+    validated_switches.push_back(option);
+  }
+  arguments.insert(arguments.end(), validated_switches.begin(),
+                   validated_switches.end());
+}
