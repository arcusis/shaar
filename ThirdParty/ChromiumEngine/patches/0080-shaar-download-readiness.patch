+TEST(ShaarDownloadsHandlerTest, WaitsUntilDownloadHistoryIsInitialized) {
+  NiceMock<content::MockDownloadManager> manager;
+  EXPECT_CALL(manager, IsManagerInitialized()).WillOnce(Return(false));
+  EXPECT_FALSE(Downloads::HasReadyDownloadHistory(&manager));
+
+  NiceMock<content::MockDownloadManager> ready_manager;
+  EXPECT_CALL(ready_manager, IsManagerInitialized()).WillOnce(Return(true));
+  EXPECT_TRUE(Downloads::HasReadyDownloadHistory(&ready_manager));
+  EXPECT_FALSE(Downloads::HasReadyDownloadHistory(nullptr));
+}
