From: Shaar engineering
Subject: [PATCH] Resolve 157 native window IDs through Chromium session IDs

Port the per-profile Browser lookup and expose its validated Chromium session ID through the engine ABI.

--- a/chrome/browser/shaar/public/shaar_engine.h
+++ b/chrome/browser/shaar/public/shaar_engine.h
@@ -482,6 +482,10 @@
     shaar_bytes window_id, shaar_window **out, shaar_error *error);
 SHAAR_EXPORT shaar_error_code shaar_window_close(
     shaar_window *, shaar_error *error);
+/* Returns the real Chromium session ID for a regular profile window. */
+SHAAR_EXPORT shaar_error_code shaar_window_chrome_id(
+    shaar_engine *, shaar_profile *, shaar_window *, int32_t *out,
+    shaar_error *error);
 SHAAR_EXPORT void *shaar_window_host_view(shaar_window *); /* borrowed NSView* */
 SHAAR_EXPORT void *shaar_window_native_window(shaar_window *); /* borrowed NSWindow* */
 SHAAR_EXPORT shaar_error_code shaar_tab_open(
--- a/chrome/browser/shaar/shaar_engine.exports
+++ b/chrome/browser/shaar/shaar_engine.exports
@@ -25,6 +25,7 @@
 _shaar_private_session_tracker_allowance
 _shaar_window_open
 _shaar_window_close
+_shaar_window_chrome_id
 _shaar_tab_find
 _shaar_tab_open
 _shaar_tab_close
--- a/chrome/browser/shaar/windows_tabs/shaar_windows_tabs.cc
+++ b/chrome/browser/shaar/windows_tabs/shaar_windows_tabs.cc
@@ -162,6 +162,15 @@
     if (entry.engine == engine && entry.handle == window)
       return entry.browser;
   return nullptr;
+}
+
+Browser* BrowserTabRegistryImpl::FindBrowserForProfile(
+    shaar_engine* engine, shaar_window* window, std::string_view profile_id) {
+  WindowState* state = FindWindowState(engine, window);
+  if (!state || profile_id.empty() || state->closing)
+    return nullptr;
+  auto found = state->browsers_by_profile.find(std::string(profile_id));
+  return found == state->browsers_by_profile.end() ? nullptr : found->second;
 }
 
