From: Shaar Chromium 157 layer port
Subject: [PATCH] route authored windows through the Shaar embedder

diff --git a/chrome/browser/extensions/api/tabs/windows_api.cc b/chrome/browser/extensions/api/tabs/windows_api.cc
--- a/chrome/browser/extensions/api/tabs/windows_api.cc
+++ b/chrome/browser/extensions/api/tabs/windows_api.cc
@@ -13,6 +13,7 @@
 #include <utility>
 #include <vector>
 
+#include "base/command_line.h"
 #include "base/memory/raw_ref.h"
 #include "base/memory/weak_ptr.h"
 #include "base/types/expected.h"
@@ -650,8 +651,15 @@
       BrowserWindowInterface::CreationStatus::kOk) {
     return RespondNow(Error(ExtensionTabUtil::kBrowserWindowNotAllowed));
   }
+  if (create_data_ && create_data_->tab_id &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder")) {
+    return RespondNow(
+        Error("Moving managed tabs to a new engine window is not supported."));
+  }
   BrowserWindowCreateParams create_params(window_type, *window_profile,
                                           user_gesture());
+  create_params.engine_requested =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder");
 
   bool initialized_type = false;
 #if !BUILDFLAG(IS_ANDROID)
@@ -901,27 +909,29 @@
   // the window, destroying `new_window`.
   base::WeakPtr<BrowserWindowInterface> weak_window = new_window->GetWeakPtr();
 
-  if (focused) {
-    new_window->GetWindow()->Show();
-  } else {
-    // TODO(https://crbug.com/545671279): Port to desktop android.
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("shaar-embedder")) {
+    if (focused) {
+      new_window->GetWindow()->Show();
+    } else {
+      // TODO(https://crbug.com/545671279): Port to desktop android.
 #if !BUILDFLAG(IS_ANDROID)
-    // Show an unfocused new window.
-    BrowserWindowInterface* const last_active_bwi =
-        GetLastActiveBrowserWindowInterfaceWithAnyProfile();
-
-    // On some OSes the new unfocused window is shown on top by default.
-    // ScopedPinBrowserAtFront prevents the new browser from being shown above
-    // the old active browser.
-    if (last_active_bwi && last_active_bwi->IsActive()) {
-      ScopedPinBrowserAtFront scoper(last_active_bwi);
+      // Show an unfocused new window.
+      BrowserWindowInterface* const last_active_bwi =
+          GetLastActiveBrowserWindowInterfaceWithAnyProfile();
+
+      // On some OSes the new unfocused window is shown on top by default.
+      // ScopedPinBrowserAtFront prevents the new browser from being shown above
+      // the old active browser.
+      if (last_active_bwi && last_active_bwi->IsActive()) {
+        ScopedPinBrowserAtFront scoper(last_active_bwi);
+        new_window->GetWindow()->ShowInactive();
+      } else {
+        new_window->GetWindow()->ShowInactive();
+      }
+#else
       new_window->GetWindow()->ShowInactive();
-    } else {
-      new_window->GetWindow()->ShowInactive();
-    }
-#else
-    new_window->GetWindow()->ShowInactive();
 #endif  // BUILDFLAG(IS_ANDROID)
+    }
   }
   if (!weak_window) {
     return Error(ExtensionTabUtil::kNoCurrentWindowError);
diff --git a/chrome/browser/ui/browser_window/public/create_browser_window.h b/chrome/browser/ui/browser_window/public/create_browser_window.h
--- a/chrome/browser/ui/browser_window/public/create_browser_window.h
+++ b/chrome/browser/ui/browser_window/public/create_browser_window.h
@@ -86,6 +86,10 @@
 
   // Whether the browser was created by a user gesture.
   bool from_user_gesture = false;
+
+  // Route a gesture initiated request through the embedder's native window
+  // owner instead of creating a standalone Chromium window.
+  bool engine_requested = false;
 
   // The profile to be associated with the browser window.
   raw_ref<Profile> profile;
@@ -246,6 +250,13 @@
 BrowserWindowInterface* CreateBrowserWindow(
     BrowserWindowCreateParams create_params);
 
+using EngineRequestedWindowHandler =
+    base::RepeatingCallback<BrowserWindowInterface*(
+        Profile*, BrowserWindowInterface::Type, bool)>;
+
+// Registers the embedder callback used only by explicitly marked requests.
+void SetEngineRequestedWindowHandler(EngineRequestedWindowHandler handler);
+
 // The asynchronous version of `CreateBrowserWindow`. The given `callback` will
 // always be invoked asynchronously with the newly created
 // `BrowserWindowInterface`.
diff --git a/chrome/browser/ui/browser_window/internal/create_browser_window_non_android.cc b/chrome/browser/ui/browser_window/internal/create_browser_window_non_android.cc
--- a/chrome/browser/ui/browser_window/internal/create_browser_window_non_android.cc
+++ b/chrome/browser/ui/browser_window/internal/create_browser_window_non_android.cc
@@ -5,6 +5,7 @@
 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/location.h"
+#include "base/no_destructor.h"
 #include "base/task/single_thread_task_runner.h"
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/devtools/devtools_window.h"
@@ -14,6 +15,15 @@
 #include "chrome/browser/ui/browser.h"
 #include "chrome/browser/ui/browser_window/public/create_browser_window.h"
 
+namespace {
+
+EngineRequestedWindowHandler& GetEngineRequestedWindowHandler() {
+  static base::NoDestructor<EngineRequestedWindowHandler> handler;
+  return *handler;
+}
+
+}  // namespace
+
 #if BUILDFLAG(IS_CHROMEOS)
 #include "components/session_manager/core/session_manager.h"
 #include "components/user_manager/user_manager.h"
@@ -21,6 +31,7 @@
 
 BrowserWindowCreateParams BrowserWindowCreateParams::Clone() const {
   BrowserWindowCreateParams clone(type, *profile, from_user_gesture);
+  clone.engine_requested = engine_requested;
   clone.initial_bounds = initial_bounds;
   clone.is_trusted_source = is_trusted_source;
   clone.app_name = app_name;
@@ -139,10 +150,21 @@
 
 BrowserWindowInterface* CreateBrowserWindow(
     BrowserWindowCreateParams create_params) {
+  if (create_params.engine_requested) {
+    auto& handler = GetEngineRequestedWindowHandler();
+    if (!create_params.from_user_gesture || handler.is_null())
+      return nullptr;
+    return handler.Run(&*create_params.profile, create_params.type,
+                       create_params.from_user_gesture);
+  }
   CHECK_EQ(BrowserWindowInterface::CreationStatus::kOk,
            GetBrowserWindowCreationStatusForProfile(*create_params.profile));
 
   return Browser::Create(std::move(create_params));
+}
+
+void SetEngineRequestedWindowHandler(EngineRequestedWindowHandler handler) {
+  GetEngineRequestedWindowHandler() = std::move(handler);
 }
 
 std::unique_ptr<BrowserWindowInterface>
