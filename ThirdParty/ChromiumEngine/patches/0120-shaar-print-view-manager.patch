+TEST_F(PrintViewManagerTest, ShaarEmbedderScriptedPrintUsesNativePanel) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("shaar-embedder");
+  content::RenderFrameHost* main_frame = web_contents()->GetPrimaryMainFrame();
+  content::RenderFrameHostTester::For(main_frame)->InitializeRenderFrameIfNeeded();
+
+  auto print_view_manager =
+      std::make_unique<TestPrintViewManagerForSystemDialogPrint>(web_contents());
+  print_view_manager->SetTargetFrameForTesting(main_frame);
+  bool scripted_print_finished = false;
+  print_view_manager->SetupScriptedPrintPreview(base::BindLambdaForTesting(
+      [&]() { scripted_print_finished = true; }));
+  print_view_manager->ShowScriptedPrintPreview();
 
+  EXPECT_TRUE(print_view_manager->system_dialog_shown);
+  EXPECT_TRUE(print_view_manager->print_preview_rfh());
+  EXPECT_FALSE(scripted_print_finished);
+
+  print_view_manager->PrintPreviewDone();
+  EXPECT_TRUE(scripted_print_finished);
+}
