+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "chrome/browser/shaar/chooser/shaar_device_chooser.h"
+
+#include "base/values.h"
+#include "chrome/browser/shaar/engine/shaar_module_registry.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+base::DictValue Decision(std::string action) {
+  base::DictValue value;
+  value.Set("schemaVersion", 1);
+  value.Set("id", "12");
+  value.Set("action", std::move(action));
+  return value;
+}
+
+}  // namespace
+
+TEST(ShaarDeviceChooserTest, ParsesCancelAndSelect) {
+  std::optional<shaar::chooser::DeviceChooserDecision> cancel =
+      shaar::chooser::ParseDeviceChooserDecision(Decision("cancel"));
+  ASSERT_TRUE(cancel);
+  EXPECT_EQ(cancel->id, "12");
+  EXPECT_FALSE(cancel->select);
+
+  base::DictValue select = Decision("select");
+  select.Set("optionId", "abcdef0123456789abcdef0123456789");
+  std::optional<shaar::chooser::DeviceChooserDecision> parsed =
+      shaar::chooser::ParseDeviceChooserDecision(select);
+  ASSERT_TRUE(parsed);
+  EXPECT_TRUE(parsed->select);
+  EXPECT_EQ(parsed->option_id, "abcdef0123456789abcdef0123456789");
+}
+
+TEST(ShaarDeviceChooserTest, RejectsMalformedDecisions) {
+  base::DictValue extra = Decision("cancel");
+  extra.Set("transport", "usb");
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(extra));
+
+  base::DictValue index_only = Decision("select");
+  index_only.Set("index", 0);
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(index_only));
+
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(Decision("select")));
+
+  base::DictValue bad_option = Decision("select");
+  bad_option.Set("optionId", "not an id");
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(bad_option));
+
+  base::DictValue bad_id = Decision("cancel");
+  bad_id.Set("id", "not an id");
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(bad_id));
+
+  base::DictValue schema = Decision("cancel");
+  schema.Set("schemaVersion", 2);
+  EXPECT_FALSE(shaar::chooser::ParseDeviceChooserDecision(schema));
+}
+
+TEST(ShaarDeviceChooserTest, RegistersItsModuleAndOperationHandler) {
+  ShaarModuleRegistry registry;
+  shaar_device_chooser_register(&registry);
+  EXPECT_NE(registry.FindModule(SHAAR_MODULE_DEVICE_CHOOSER), nullptr);
+  EXPECT_EQ(registry.Find(SHAAR_OP_DEVICE_CHOOSER_DECISION),
+            &HandleDeviceChooserDecision);
+}
