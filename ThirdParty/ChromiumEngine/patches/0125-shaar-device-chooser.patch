index 0000000..35761d7
--- /dev/null
+++ b/chrome/browser/shaar/chooser/shaar_device_chooser.cc
@@ -0,0 +1,492 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "chrome/browser/shaar/chooser/shaar_device_chooser.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+#include <map>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/current_thread.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/shaar/engine/shaar_event_bridge.h"
+#include "chrome/browser/shaar/lifecycle/shaar_lifecycle.h"
+#include "chrome/browser/shaar/windows_tabs/shaar_windows_tabs.h"
+#include "components/permissions/chooser_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace shaar::chooser {
+namespace {
+
+constexpr size_t kMaximumSessions = 8;
+constexpr size_t kMaximumOptions = 64;
+constexpr size_t kMaximumNameBytes = 256;
+constexpr size_t kMaximumArgumentsBytes = 4096;
+
+std::string ClampName(const std::u16string& text) {
+  std::string utf8 = base::UTF16ToUTF8(text);
+  if (utf8.size() <= kMaximumNameBytes)
+    return utf8;
+  utf8.resize(kMaximumNameBytes);
+  while (!utf8.empty() &&
+         (static_cast<unsigned char>(utf8.back()) & 0xC0) == 0x80) {
+    utf8.pop_back();
+  }
+  if (!utf8.empty() &&
+      (static_cast<unsigned char>(utf8.back()) & 0xC0) == 0xC0) {
+    utf8.pop_back();
+  }
+  return utf8;
+}
+
+bool ValidChooserID(std::string_view id) {
+  if (id.empty() || id.size() > 64)
+    return false;
+  for (char character : id) {
+    const bool digit = character >= '0' && character <= '9';
+    const bool upper = character >= 'A' && character <= 'Z';
+    const bool lower = character >= 'a' && character <= 'z';
+    if (!digit && !upper && !lower && character != '-')
+      return false;
+  }
+  return true;
+}
+
+bool HasOnlyKeys(const base::DictValue& dict,
+                 std::initializer_list<std::string_view> allowed) {
+  for (const auto item : dict) {
+    if (std::find(allowed.begin(), allowed.end(), item.first) == allowed.end())
+      return false;
+  }
+  return true;
+}
+
+struct ReplyContext {
+  shaar_request_id request_id;
+  shaar_reply_fn callback;
+  void* context;
+};
+
+void DeliverReply(ReplyContext request,
+                  shaar_error_code code,
+                  std::string payload,
+                  std::string message) {
+  shaar_result result{};
+  result.size = sizeof(result);
+  result.request_id = request.request_id;
+  result.error.size = sizeof(result.error);
+  result.error.code = code;
+  result.error.platform_code = 0;
+  result.error.message = {message.data(), message.size()};
+  result.payload_json = {payload.data(), payload.size()};
+  request.callback(request.context, &result);
+}
+
+void Reply(const ReplyContext& request, base::DictValue payload) {
+  std::string json;
+  base::JSONWriter::Write(base::Value(std::move(payload)), &json);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&DeliverReply, request, SHAAR_OK,
+                                std::move(json), std::string()));
+}
+
+shaar_error_code Fail(shaar_error* error,
+                      shaar_error_code code,
+                      const char* message) {
+  if (error) {
+    const uint32_t size = error->size;
+    if (size >= offsetof(shaar_error, code) + sizeof(error->code))
+      error->code = code;
+    if (size >= offsetof(shaar_error, platform_code) +
+                    sizeof(error->platform_code)) {
+      error->platform_code = 0;
+    }
+    if (size >= offsetof(shaar_error, message) + sizeof(error->message))
+      error->message = {message, std::strlen(message)};
+  }
+  return code;
+}
+
+std::optional<base::DictValue> ParseArguments(shaar_bytes bytes) {
+  if (!bytes.data || bytes.size == 0 || bytes.size > kMaximumArgumentsBytes)
+    return std::nullopt;
+  auto parsed = base::JSONReader::Read(
+      std::string_view(bytes.data, bytes.size), base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict())
+    return std::nullopt;
+  return std::move(parsed->GetDict());
+}
+
+void DismissById(std::string id);
+
+class DeviceChooserSession : public permissions::ChooserController::View,
+                             public content::WebContentsObserver {
+ public:
+  DeviceChooserSession(
+      std::string id, shaar_engine* engine, content::WebContents* contents,
+      shaar_window* window, shaar_tab* tab, std::string profile_id,
+      std::string window_id, std::string tab_id, GURL page_url, GURL origin,
+      content::GlobalRenderFrameHostId frame_id, std::string transport,
+      std::unique_ptr<permissions::ChooserController> controller)
+      : content::WebContentsObserver(contents),
+        id_(std::move(id)),
+        engine_(engine),
+        contents_(contents),
+        window_(window),
+        tab_(tab),
+        profile_id_(std::move(profile_id)),
+        window_id_(std::move(window_id)),
+        tab_id_(std::move(tab_id)),
+        page_url_(std::move(page_url)),
+        origin_(std::move(origin)),
+        frame_id_(frame_id),
+        transport_(std::move(transport)),
+        controller_(std::move(controller)) {}
+
+  ~DeviceChooserSession() override {
+    if (!controller_)
+      return;
+    controller_->set_view(nullptr);
+    if (cancel_on_finish_)
+      controller_->Cancel();
+    controller_.reset();
+  }
+
+  void Attach() {
+    controller_->set_view(this);
+  }
+
+  bool Announce() {
+    const bool published = Publish("deviceChooserRequested");
+    announced_ = published;
+    return published;
+  }
+
+  bool SelectOption(const std::string& option_id) {
+    auto shown = shown_options_.find(option_id);
+    if (finishing_ || !controller_ || shown == shown_options_.end() ||
+        shown->second >= std::min(controller_->NumOptions(), kMaximumOptions)) {
+      return false;
+    }
+    const size_t index = shown->second;
+    selecting_ = true;
+    controller_->set_view(nullptr);
+    controller_->Select(std::vector<size_t>{index});
+    selecting_ = false;
+    RequestFinish(/*cancel=*/false);
+    return true;
+  }
+
+  void RequestFinish(bool cancel) {
+    if (selecting_)
+      return;
+    if (finishing_)
+      return;
+    finishing_ = true;
+    cancel_on_finish_ = cancel;
+    if (announced_)
+      Publish("deviceChooserDismissed");
+    TakeOwnership();
+  }
+
+  shaar_engine* engine() const { return engine_; }
+  content::WebContents* contents() const { return contents_; }
+  shaar_window* window() const { return window_; }
+  shaar_tab* tab() const { return tab_; }
+  const GURL& page_url() const { return page_url_; }
+  const GURL& origin() const { return origin_; }
+  content::GlobalRenderFrameHostId frame_id() const { return frame_id_; }
+  permissions::ChooserController* controller() const {
+    return controller_.get();
+  }
+
+  void OnOptionsInitialized() override { PublishUpdate(); }
+  void OnOptionAdded(size_t) override { PublishUpdate(); }
+  void OnOptionRemoved(size_t) override { PublishUpdate(); }
+  void OnOptionUpdated(size_t) override { PublishUpdate(); }
+  void OnAdapterEnabledChanged(bool) override { PublishUpdate(); }
+  void OnAdapterAuthorizationChanged(bool) override { PublishUpdate(); }
+  void OnRefreshStateChanged(bool) override { PublishUpdate(); }
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->IsInMainFrame() && navigation->HasCommitted())
+      ScheduleDismiss();
+  }
+
+  void WebContentsDestroyed() override {
+    contents_ = nullptr;
+    ScheduleDismiss();
+  }
+
+ private:
+  void ScheduleDismiss() {
+    if (dismiss_scheduled_)
+      return;
+    dismiss_scheduled_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&DismissById, id_));
+  }
+
+  void PublishUpdate() {
+    if (announced_ && !finishing_)
+      Publish("deviceChooserUpdated");
+  }
+
+  bool Publish(const char* kind) {
+    if (!controller_ || !lifecycle::EngineIsReady(engine_))
+      return false;
+    shown_options_.clear();
+    base::DictValue payload;
+    payload.Set("schemaVersion", 1);
+    payload.Set("kind", kind);
+    payload.Set("id", id_);
+    payload.Set("transport", transport_);
+    payload.Set("pageURL", page_url_.spec());
+    payload.Set("origin", origin_.spec());
+    base::ListValue options;
+    const size_t count = std::min(controller_->NumOptions(), kMaximumOptions);
+    for (size_t index = 0; index < count; ++index) {
+      base::DictValue option;
+      const std::string option_id = base::UnguessableToken::Create().ToString();
+      shown_options_.emplace(option_id, index);
+      option.Set("optionId", option_id);
+      option.Set("name", ClampName(controller_->GetOption(index)));
+      options.Append(std::move(option));
+    }
+    const bool can_grant = controller_->NumOptions() > 0;
+    payload.Set("options", std::move(options));
+    payload.Set("canGrant", can_grant);
+    std::string json;
+    if (!base::JSONWriter::Write(payload, &json))
+      return false;
+    return shaar::EmitEvent(
+               engine_, SHAAR_EVENT_PERMISSION,
+               {profile_id_.data(), profile_id_.size()}, {},
+               {window_id_.data(), window_id_.size()},
+               {tab_id_.data(), tab_id_.size()},
+               {json.data(), json.size()}) == SHAAR_OK;
+  }
+
+  void TakeOwnership();
+
+  std::string id_;
+  shaar_engine* engine_;
+  raw_ptr<content::WebContents> contents_;
+  shaar_window* window_;
+  shaar_tab* tab_;
+  std::string profile_id_;
+  std::string window_id_;
+  std::string tab_id_;
+  GURL page_url_;
+  GURL origin_;
+  content::GlobalRenderFrameHostId frame_id_;
+  std::string transport_;
+  std::unique_ptr<permissions::ChooserController> controller_;
+  std::map<std::string, size_t> shown_options_;
+  bool announced_ = false;
+  bool selecting_ = false;
+  bool finishing_ = false;
+  bool cancel_on_finish_ = false;
+  bool dismiss_scheduled_ = false;
+};
+
+using SessionMap = std::map<std::string, std::unique_ptr<DeviceChooserSession>>;
+
+SessionMap& Sessions() {
+  static base::NoDestructor<SessionMap> sessions;
+  return *sessions;
+}
+
+void DismissById(std::string id) {
+  auto found = Sessions().find(id);
+  if (found == Sessions().end())
+    return;
+  found->second->RequestFinish(/*cancel=*/true);
+}
+
+void DeviceChooserSession::TakeOwnership() {
+  auto found = Sessions().find(id_);
+  if (found == Sessions().end() || found->second.get() != this)
+    return;
+  std::unique_ptr<DeviceChooserSession> taken = std::move(found->second);
+  Sessions().erase(found);
+}
+
+bool FrameStillCurrent(const DeviceChooserSession& session,
+                       content::WebContents* contents) {
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(session.frame_id());
+  if (!frame || !frame->IsActive())
+    return false;
+  if (content::WebContents::FromRenderFrameHost(frame) != contents)
+    return false;
+  if (contents->GetLastCommittedURL() != session.page_url())
+    return false;
+  return frame->GetLastCommittedOrigin().GetURL() == session.origin();
+}
+
+}  // namespace
+
+std::optional<DeviceChooserDecision> ParseDeviceChooserDecision(
+    const base::DictValue& value) {
+  const std::optional<int> schema = value.FindInt("schemaVersion");
+  const std::string* id = value.FindString("id");
+  const std::string* action = value.FindString("action");
+  if (!schema || *schema != 1 || !id || !action || !ValidChooserID(*id))
+    return std::nullopt;
+  DeviceChooserDecision decision;
+  decision.id = *id;
+  if (*action == "cancel") {
+    if (!HasOnlyKeys(value, {"schemaVersion", "id", "action"}))
+      return std::nullopt;
+    decision.select = false;
+    return decision;
+  }
+  if (*action != "select")
+    return std::nullopt;
+  if (!HasOnlyKeys(value,
+                   {"schemaVersion", "id", "action", "optionId"}))
+    return std::nullopt;
+  const std::string* option_id = value.FindString("optionId");
+  if (!option_id || !ValidChooserID(*option_id))
+    return std::nullopt;
+  decision.select = true;
+  decision.option_id = *option_id;
+  return decision;
+}
+
+base::OnceClosure ShowDeviceChooser(
+    content::RenderFrameHost* owner,
+    std::unique_ptr<permissions::ChooserController> controller) {
+  if (!owner || !controller || !base::CurrentUIThread::IsSet())
+    return base::DoNothing();
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(owner);
+  shaar_engine* engine = lifecycle::ActiveEngine();
+  if (!lifecycle::EngineIsReady(engine) || !contents || !owner->IsActive() ||
+      Sessions().size() >= kMaximumSessions) {
+    return base::DoNothing();
+  }
+  std::optional<windows_tabs::SelectedRegularTab> identity =
+      windows_tabs::Registry().FindSelectedRegularTab(engine, contents);
+  if (!identity || identity->profile_id.empty() || identity->window_id.empty() ||
+      identity->tab_id.empty()) {
+    return base::DoNothing();
+  }
+  const GURL page_url = contents->GetLastCommittedURL();
+  const GURL origin = owner->GetLastCommittedOrigin().GetURL();
+  if (!page_url.SchemeIsHTTPOrHTTPS() || !origin.SchemeIsHTTPOrHTTPS())
+    return base::DoNothing();
+
+  const std::string id = base::UnguessableToken::Create().ToString();
+  const std::string transport = controller->shaar_transport();
+  auto session = std::make_unique<DeviceChooserSession>(
+      id, engine, contents, identity->window, identity->tab,
+      identity->profile_id, identity->window_id, identity->tab_id, page_url,
+      origin, owner->GetGlobalId(), transport, std::move(controller));
+  DeviceChooserSession* raw = session.get();
+  Sessions().emplace(id, std::move(session));
+  raw->Attach();
+  if (!raw->Announce()) {
+    DismissById(id);
+    return base::DoNothing();
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&DismissById, id), base::Minutes(2));
+  return base::BindOnce(&DismissById, id);
+}
+
+shaar_error_code ApplyDeviceChooserDecision(
+    shaar_engine* engine, shaar_window* window, shaar_tab* tab,
+    shaar_operation operation, shaar_bytes arguments,
+    shaar_request_id request_id, shaar_reply_fn reply, void* reply_context,
+    shaar_error* error) {
+  if (operation != SHAAR_OP_DEVICE_CHOOSER_DECISION) {
+    return Fail(error, SHAAR_INVALID_ARGUMENT,
+                "unknown device chooser operation");
+  }
+  if (!base::CurrentUIThread::IsSet() || !engine || !window || !tab || !reply) {
+    return Fail(error, SHAAR_NOT_READY,
+                "device chooser decision is unavailable");
+  }
+  std::optional<base::DictValue> parsed = ParseArguments(arguments);
+  if (!parsed) {
+    return Fail(error, SHAAR_INVALID_ARGUMENT,
+                "invalid device chooser decision");
+  }
+  std::optional<DeviceChooserDecision> decision =
+      ParseDeviceChooserDecision(*parsed);
+  if (!decision) {
+    return Fail(error, SHAAR_INVALID_ARGUMENT,
+                "invalid device chooser decision");
+  }
+  auto found = Sessions().find(decision->id);
+  if (found == Sessions().end())
+    return Fail(error, SHAAR_NOT_FOUND, "device chooser is not open");
+  DeviceChooserSession* session = found->second.get();
+  content::WebContents* contents =
+      windows_tabs::Registry().FindWebContents(engine, window, tab);
+  if (!lifecycle::EngineIsReady(engine) || !contents ||
+      session->engine() != engine || session->window() != window ||
+      session->tab() != tab || session->contents() != contents ||
+      !FrameStillCurrent(*session, contents)) {
+    return Fail(error, SHAAR_NOT_FOUND, "device chooser page changed");
+  }
+  if (decision->select) {
+    if (!session->controller()) {
+      return Fail(error, SHAAR_INVALID_ARGUMENT,
+                  "device chooser option is unavailable");
+    }
+    if (!session->SelectOption(decision->option_id)) {
+      return Fail(error, SHAAR_INVALID_ARGUMENT,
+                  "device chooser option is no longer available");
+    }
+    Reply(ReplyContext{request_id, reply, reply_context},
+          base::DictValue().Set("schemaVersion", 1));
+    return SHAAR_OK;
+  }
+  Reply(ReplyContext{request_id, reply, reply_context},
+        base::DictValue().Set("schemaVersion", 1));
+  session->RequestFinish(/*cancel=*/true);
+  return SHAAR_OK;
+}
+
+}  // namespace shaar::chooser
+
+shaar_error_code HandleDeviceChooserDecision(
+    shaar::ShaarEngineContext*, shaar_engine* engine, shaar_scope,
+    shaar_window* window, shaar_tab* tab, shaar_operation operation,
+    shaar_bytes arguments, shaar_request_id request_id, shaar_reply_fn reply,
+    void* reply_context, shaar_error* error) {
+  return shaar::chooser::ApplyDeviceChooserDecision(
+      engine, window, tab, operation, arguments, request_id, reply,
+      reply_context, error);
+}
+
+extern "C" void shaar_device_chooser_register(ShaarModuleRegistry* registry) {
+  if (!registry)
+    return;
+  registry->Register(SHAAR_OP_DEVICE_CHOOSER_DECISION,
+                     SHAAR_OP_DEVICE_CHOOSER_DECISION,
+                     &HandleDeviceChooserDecision);
+  static const ShaarModuleRegistry::Handler handlers =
+      &HandleDeviceChooserDecision;
+  registry->RegisterModule(SHAAR_MODULE_DEVICE_CHOOSER, &handlers);
+}

