+void ScriptedAnimationController::EnqueueHiddenScrollEvent(Event* event) {
+  if (!GetExecutionContext())
+    return;
+  if (!InsertToPerFrameEventsMap(event))
+    return;
+  EnqueueEvent(event);
+  if (hidden_scroll_dispatch_task_pending_)
+    return;
+  hidden_scroll_dispatch_task_pending_ = true;
+  GetExecutionContext()->GetTaskRunner(TaskType::kDOMManipulation)->PostTask(
+      FROM_HERE,
+      BindOnce(&ScriptedAnimationController::DispatchHiddenScrollEvents,
+               WrapPersistent(this)));
+}
+
+void ScriptedAnimationController::DispatchHiddenScrollEvents() {
+  hidden_scroll_dispatch_task_pending_ = false;
+  if (!GetExecutionContext())
+    return;
+  DispatchEvents(base::BindRepeating([](Event* event) {
+    return event->type() == event_type_names::kScroll ||
+           event->type() == event_type_names::kScrollend;
+  }));
+}
