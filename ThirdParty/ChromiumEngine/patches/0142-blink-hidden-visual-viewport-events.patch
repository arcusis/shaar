+
+void Document::EnqueueVisualViewportEvent(Event* event) {
+  if (!GetExecutionContext())
+    return;
   scripted_animation_controller_->EnqueuePerFrameEvent(event);
+  if (!hidden() || hidden_visual_viewport_event_task_pending_) {
+    return;
+  }
+  hidden_visual_viewport_event_task_pending_ = true;
+  GetExecutionContext()->GetTaskRunner(TaskType::kDOMManipulation)->PostTask(
+      FROM_HERE,
+      BindOnce(&Document::DispatchHiddenVisualViewportEvents,
+               WrapPersistent(this)));
+}
+
+void Document::DispatchHiddenVisualViewportEvents() {
+  hidden_visual_viewport_event_task_pending_ = false;
+  if (!GetExecutionContext() || !domWindow())
+    return;
+  EventTarget* visual_viewport = domWindow()->visualViewport();
+  scripted_animation_controller_->DispatchEvents(base::BindRepeating(
+      [](EventTarget* target, Event* event) {
+        return event->target() == target &&
+               (event->type() == event_type_names::kScroll ||
+                event->type() == event_type_names::kScrollend ||
+                event->type() == event_type_names::kResize);
+      },
+      visual_viewport));
 }
 
