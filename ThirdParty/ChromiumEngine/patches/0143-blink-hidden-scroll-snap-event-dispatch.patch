diff --git a/third_party/blink/renderer/core/dom/scripted_animation_controller_test.cc b/third_party/blink/renderer/core/dom/scripted_animation_controller_test.cc
--- a/third_party/blink/renderer/core/dom/scripted_animation_controller_test.cc
+++ b/third_party/blink/renderer/core/dom/scripted_animation_controller_test.cc
@@ -384,2 +384,27 @@
 
+TEST_F(ScriptedAnimationControllerTest,
+       HiddenDocumentScrollSnapEventsDispatchWithoutAnimationFrame) {
+  GetPage().SetVisibilityState(mojom::blink::PageVisibilityState::kHidden,
+                               /*is_initial_state=*/false);
+  TaskOrderObserver observer;
+  GetDocument().addEventListener(
+      AtomicString("scrollsnapchange"),
+      MakeGarbageCollected<RunTaskEventListener>(observer.CreateTask(1)));
+  GetDocument().addEventListener(
+      AtomicString("scrollsnapchanging"),
+      MakeGarbageCollected<RunTaskEventListener>(observer.CreateTask(2)));
+  Member<Node> block_target = &GetDocument();
+  Member<Node> inline_target = &GetDocument();
+
+  GetDocument().EnqueueScrollSnapChangeEvent(&GetDocument(), block_target,
+                                             inline_target);
+  GetDocument().EnqueueScrollSnapChangingEvent(&GetDocument(), block_target,
+                                               inline_target);
+  EXPECT_TRUE(observer.Order().empty());
+
+  task_environment_.RunUntilIdle();
+  EXPECT_THAT(observer.Order(), testing::ElementsAre(1, 2));
+}
+
+
 }  // namespace blink
