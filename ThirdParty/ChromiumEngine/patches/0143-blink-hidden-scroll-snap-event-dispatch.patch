diff --git a/third_party/blink/renderer/core/dom/scripted_animation_controller.cc b/third_party/blink/renderer/core/dom/scripted_animation_controller.cc
--- a/third_party/blink/renderer/core/dom/scripted_animation_controller.cc
+++ b/third_party/blink/renderer/core/dom/scripted_animation_controller.cc
@@ -41,2 +41,3 @@
 #include "third_party/blink/renderer/platform/wtf/wtf_size_t.h"
+#include "third_party/blink/renderer/platform/scheduler/public/task_type.h"
 
@@ -258,2 +259,26 @@
 
+void ScriptedAnimationController::EnqueueHiddenScrollSnapEvent(Event* event) {
+  if (!InsertToPerFrameEventsMap(event))
+    return;
+  EnqueueEvent(event);
+  if (hidden_scroll_snap_dispatch_task_pending_)
+    return;
+  hidden_scroll_snap_dispatch_task_pending_ = true;
+  GetExecutionContext()->GetTaskRunner(TaskType::kDOMManipulation)->PostTask(
+      FROM_HERE,
+      BindOnce(&ScriptedAnimationController::DispatchHiddenScrollSnapEvents,
+               WrapPersistent(this)));
+}
+
+void ScriptedAnimationController::DispatchHiddenScrollSnapEvents() {
+  hidden_scroll_snap_dispatch_task_pending_ = false;
+  if (!GetExecutionContext())
+    return;
+  DispatchEvents(base::BindRepeating([](Event* event) {
+    return event->type() == AtomicString("scrollsnapchange") ||
+           event->type() == AtomicString("scrollsnapchanging");
+  }));
+}
+
+
 }  // namespace blink
