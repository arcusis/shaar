 void ChromeContentRendererClient::RunScriptsAtDocumentStart(
     content::RenderFrame* render_frame) {
+  if (render_frame && render_frame->IsMainFrame() &&
+      render_frame->GetWebFrame()) {
+    const GURL url(render_frame->GetWebFrame()->GetDocument().Url());
+    if (url.SchemeIs("https") && url.host() == "chromewebstore.google.com" &&
+        url.EffectiveIntPort() == 443) {
+      // The Web Store's browser eligibility gate arrives as IJ_values[24].
+      // Shaar has the required install APIs, but the store currently sets this
+      // flag to false even with Chrome client hints. Change only this gate on
+      // the exact Web Store origin before its page scripts initialize.
+      constexpr char kWebStoreEligibilityScript[] = R"JS(
+        Object.defineProperty(window, 'IJ_values', {
+          configurable: true,
+          set(values) {
+            if (Array.isArray(values) && values.length === 56 &&
+                values[6] === 'chromewebstore.google.com' &&
+                values[24] === false) {
+              values[24] = true;
+            }
+            Object.defineProperty(window, 'IJ_values', {
+              configurable: true, writable: true, value: values
+            });
+          }
+        });
+      )JS";
+      render_frame->GetWebFrame()->ExecuteScript(blink::WebScriptSource(
+          blink::WebString::FromUtf8(kWebStoreEligibilityScript)));
+    }
+  }
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   extensions::ExtensionsRendererClient::Get()->RunScriptsAtDocumentStart(
       render_frame);
