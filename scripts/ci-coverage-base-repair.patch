+      SHAAR_OP_MEDIA_CONTROL,
+      SHAAR_OP_MEDIA_CAPTURE_REPLY,
+      SHAAR_OP_STORAGE_KEYCHAIN_IDENTITY,
+  };
+  *count = sizeof(values) / sizeof(values[0]);
+  return values;
+}
