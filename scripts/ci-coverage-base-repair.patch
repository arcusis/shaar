+      SHAAR_OP_SITE_SETTINGS_SET,
+      SHAAR_OP_SITE_SETTINGS_RESET,
+      SHAAR_OP_EXTENSION_LIST,
+      SHAAR_OP_EXTENSION_MANAGE,
+      SHAAR_OP_EXTENSION_ACTION,
