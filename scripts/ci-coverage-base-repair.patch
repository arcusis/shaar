+      SHAAR_OP_TAB_STOP_FIND,
+      SHAAR_OP_DEVTOOLS_CALL,
+      SHAAR_OP_DEVTOOLS_PANEL_OPEN,
+      SHAAR_OP_DEVTOOLS_PANEL_CLOSE,
