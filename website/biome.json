{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!public",
      "!dist",
      "!node_modules",
      "!.font-cache",
      "!.wrangler"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
