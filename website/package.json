{
  "name": "shaar-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:links": "tsx scripts/check-links.ts",
    "check:served": "tsx scripts/check-served.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "dev": "wrangler dev",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm check:links"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "22.19.11",
    "axe-core": "4.11.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
