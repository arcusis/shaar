{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaar-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "be4498f6a65885610876f17fddc1e68f",
  "routes": [{ "pattern": "shaar.arcusis.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": { "command": "pnpm build" },
  "observability": { "enabled": false }
}
